---
import Hero from './Hero.astro';
import { families, getLocalizedProducts, swatch, type FamilyKey } from '../data/products';
import { localizePath, type Lang } from '../i18n/routes';

interface Props { lang: Lang }
const { lang } = Astro.props;
const isEs = lang === 'es';
const products = await getLocalizedProducts(lang);
const familyKeys = Object.keys(families) as FamilyKey[];
const t = isEs
  ? {
      heroTitle: 'Catálogo de colorantes alimentarios y premixes',
      heroSubtitle: 'Colorantes naturales, alimentos colorantes LINICOL, vitaminas y premixes para la industria alimentaria.',
      search: 'Buscar por nombre, color o código E…',
      searchLabel: 'Buscar productos',
      all: 'Todas las familias',
      filterLabel: 'Filtrar por familia',
      view: 'Ver ficha del producto',
      noneTitle: 'No se encontraron productos',
      noneText: 'Prueba a ajustar la búsqueda o la familia.',
      count: (n: number) => `${n} productos`,
    }
  : {
      heroTitle: 'Food colour and premix catalogue',
      heroSubtitle: 'Natural colours, LINICOL colouring foods, vitamins and premixes for the food industry.',
      search: 'Search by name, colour or E-number…',
      searchLabel: 'Search products',
      all: 'All families',
      filterLabel: 'Filter by family',
      view: 'View product sheet',
      noneTitle: 'No products found',
      noneText: 'Try adjusting your search or family filter.',
      count: (n: number) => `${n} products`,
    };
const productHref = (id: string) => localizePath(`/products/${id}`, lang);
---

<Hero title={t.heroTitle} subtitle={t.heroSubtitle} backgroundImage="/assets/fondo1.jpg" />

<main id="main" class="bg-[#F8FAFC]">
  <div class="content-section container">
    <div class="content">
      <div class="search-bar-container" role="search">
        <div class="search-input-wrapper">
          <svg class="search-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
          <label for="searchInput" class="sr-only">{t.searchLabel}</label>
          <input type="search" id="searchInput" placeholder={t.search} class="search-input" />
        </div>
        <div class="filter-wrapper">
          <label for="categoryFilter" class="sr-only">{t.filterLabel}</label>
          <select id="categoryFilter" class="category-select">
            <option value="">{t.all}</option>
            {familyKeys.map((key) => <option value={key}>{families[key][lang]}</option>)}
          </select>
        </div>
      </div>
      <p id="resultsCount" class="sr-only" aria-live="polite">{t.count(products.length)}</p>

      <div id="productsGrid" class="features-grid" style="margin-top: 3rem;">
        {products.map((product) => (
          <article class="feature-card product-card" data-search={`${product.title} ${product.description} ${product.color ?? ''}`.toLowerCase()} data-category={product.family}>
            {product.image && (
              <a href={productHref(product.id)} class="product-image-wrap" tabindex="-1" aria-hidden="true">
                <img src={product.image} alt="" loading="lazy" decoding="async" width="300" height="300" class="product-thumb-img" />
              </a>
            )}
            <div class="product-header">
              <span class="product-category">{product.familyLabel}</span>
              {product.color && (
                <span class="product-color-indicator">
                  <span class="color-dot" style={`background-color: ${swatch(product.color)}`}></span>
                  {product.color}
                </span>
              )}
            </div>

            <h2 class="product-title"><a href={productHref(product.id)}>{product.title}</a></h2>
            <p class="product-description">{product.description}</p>

            <div class="product-tags">
              {product.applications.slice(0, 3).map((app) => <span class="tag">{app}</span>)}
              {product.applications.length > 3 && <span class="tag-more">+{product.applications.length - 3}</span>}
            </div>

            <a href={productHref(product.id)} class="view-btn text-magenta">
              {t.view}<span class="sr-only">: {product.title}</span>
              <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" style="width: 20px; height: 20px;" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
            </a>
          </article>
        ))}
      </div>

      <div id="noResults" class="no-results hidden">
        <h2>{t.noneTitle}</h2>
        <p>{t.noneText}</p>
      </div>
    </div>
  </div>
</main>

<style>
  .product-title { font-size: 1.25rem; line-height: 1.3; margin: 0.5rem 0; }
  .product-title a { color: inherit; text-decoration: none; }
  .product-title a:hover { color: var(--c-magenta); }
  .content-section {
    padding: clamp(3rem, 6vw, 6rem) clamp(1rem, 3vw, 2rem);
  }
  .content {
    max-width: 1200px;
    margin: 0 auto;
  }

  /* Search Bar - Intrinsic Flexbox */
  .search-bar-container {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem;
    background: rgba(0, 0, 0, 0.02);
    border: 1px solid rgba(0, 0, 0, 0.05);
    padding: clamp(1rem, 2.5vw, 1.5rem);
    border-radius: 0;
  }

  .search-input-wrapper {
    flex: 1 1 280px;
    position: relative;
  }
  .search-icon {
    position: absolute;
    left: 1rem;
    top: 50%;
    transform: translateY(-50%);
    width: 20px;
    height: 20px;
    color: rgba(0,0,0,0.4);
  }
  .search-input, .category-select {
    width: 100%;
    min-height: 48px;
    padding: 0.875rem 1rem 0.875rem 3rem;
    background: #ffffff;
    border: 1px solid rgba(0, 0, 0, 0.1);
    border-radius: 0;
    color: var(--c-dark);
    font-size: 1rem;
    outline: none;
    transition: border-color 0.3s ease;
  }
  .category-select {
    padding: 0.875rem 1rem;
    cursor: pointer;
    appearance: none;
  }
  .category-select option {
    background: var(--c-white);
    color: var(--c-dark);
  }
  .search-input:focus, .category-select:focus {
    border-color: var(--c-magenta);
  }

  .filter-wrapper {
    flex: 1 1 200px;
    max-width: 100%;
  }

  /* Grid and Cards - 2026 Intrinsic Container System */
  .features-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr));
    gap: clamp(1.25rem, 2.5vw, 2rem);
  }

  .feature-card {
    container-type: inline-size;
    background: #ffffff;
    border: 1px solid rgba(0, 0, 0, 0.05);
    padding: clamp(1.25rem, 3vw, 2rem);
    border-radius: 0;
    transition: transform 0.3s ease, background 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease;
    display: flex;
    flex-direction: column;
  }

  .feature-card:hover {
    transform: translateY(-5px);
    background: #ffffff;
    border-color: rgba(227, 0, 102, 0.3);
    box-shadow: 0 4px 30px rgba(0,0,0,0.05);
  }

  .product-image-wrap {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-radius: 8px;
    margin-bottom: 1.25rem;
    background: #f8fafc;
    border: 1px solid rgba(0, 0, 0, 0.05);
  }
  .product-thumb-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }
  .feature-card:hover .product-thumb-img {
    transform: scale(1.04);
  }

  .product-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.5rem;
  }

  .product-category {
    font-family: var(--font-verdana), Verdana, sans-serif;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 0.25rem 0.75rem;
    background: rgba(0,0,0,0.05);
    color: var(--c-dark);
    border-radius: 0;
    font-weight: 600;
  }

  .product-color-indicator {
    font-family: var(--font-verdana), Verdana, sans-serif;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.8rem;
    color: var(--c-dark);
  }

  .color-dot {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    border: 1px solid rgba(0,0,0,0.1);
  }

  .feature-card h2 {
    font-size: 1.5rem;
    margin-bottom: 1rem;
    color: var(--c-dark);
    transition: color 0.3s ease;
  }
  
  .feature-card:hover h2 {
    color: var(--c-magenta);
  }

  .product-description {
    font-family: var(--font-verdana), Verdana, sans-serif;
    color: var(--c-dark);
    opacity: 0.8;
    font-size: 0.95rem;
    margin-bottom: 1.5rem;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
    flex: 1;
  }

  .product-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 2rem;
  }

  .tag, .tag-more {
    font-size: 0.75rem;
    padding: 0.25rem 0.5rem;
    border-radius: 4px;
    font-weight: 500;
  }

  .tag {
    background: rgba(0, 138, 216, 0.15);
    color: #4db8ff;
  }

  .tag-more {
    background: rgba(0,0,0,0.05);
    color: var(--c-dark);
  }

  .view-btn {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-weight: 600;
    margin-top: auto;
    padding-top: 1.5rem;
    border-top: 1px solid rgba(0,0,0,0.05);
  }

  .view-btn svg {
    transition: transform 0.3s ease;
  }

  .feature-card:hover .view-btn svg {
    transform: translateX(5px);
  }

  .no-results {
    text-align: center;
    padding: 5rem 0;
  }
  
  .no-results h2 {
    font-size: 1.5rem;
    margin-bottom: 0.5rem;
  }
  
  .no-results p {
    color: var(--c-dark);
    opacity: 0.8;
  }
  
  .hidden {
    display: none;
  }
</style>

<script>
  const searchInput = document.getElementById('searchInput') as HTMLInputElement | null;
  const categoryFilter = document.getElementById('categoryFilter') as HTMLSelectElement | null;
  const cards = document.querySelectorAll<HTMLElement>('.product-card');
  const noResults = document.getElementById('noResults');
  const counter = document.getElementById('resultsCount');

  function apply(updateUrl = true) {
    if (!searchInput || !categoryFilter) return;
    const term = searchInput.value.trim().toLowerCase();
    const cat = categoryFilter.value;
    let visible = 0;
    cards.forEach((card) => {
      const show = (!term || (card.dataset.search || '').includes(term)) && (!cat || card.dataset.category === cat);
      card.style.display = show ? '' : 'none';
      if (show) visible++;
    });
    if (noResults) noResults.style.display = visible ? 'none' : 'block';
    if (counter) counter.textContent = String(visible);
    if (updateUrl) {
      // Keep filters in the URL so filtered views can be shared and linked.
      const url = new URL(window.location.href);
      cat ? url.searchParams.set('category', cat) : url.searchParams.delete('category');
      term ? url.searchParams.set('q', term) : url.searchParams.delete('q');
      history.replaceState(null, '', url);
    }
  }

  if (searchInput && categoryFilter) {
    const params = new URLSearchParams(window.location.search);
    const cat = params.get('category');
    if (cat && [...categoryFilter.options].some((o) => o.value === cat)) categoryFilter.value = cat;
    searchInput.value = params.get('q') ?? '';
    searchInput.addEventListener('input', () => apply());
    categoryFilter.addEventListener('change', () => apply());
    apply(false);
  }
</script>
