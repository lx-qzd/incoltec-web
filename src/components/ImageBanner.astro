---
import { getImage } from "astro:assets";
import BrandEIcon from "./BrandEIcon.astro";
import fondo1Webp from "../assets/fondo1.webp";
import fondo2Webp from "../assets/fondo2.webp";
import fondo3Webp from "../assets/fondo3.webp";

interface Props {
  image: string;
  tag?: string;
  title?: string;
  subtitle?: string;
  height?: string;
}

const {
  image,
  tag,
  title,
  subtitle,
  height = "min-h-[clamp(22rem,45dvh,35rem)]"
} = Astro.props;

// Map string image paths to optimized Astro assets if available
let optimizedSrc = image;
if (image.includes("fondo1")) {
  optimizedSrc = (await getImage({ src: fondo1Webp, format: 'webp', width: 1920 })).src;
} else if (image.includes("fondo2")) {
  optimizedSrc = (await getImage({ src: fondo2Webp, format: 'webp', width: 1920 })).src;
} else if (image.includes("fondo3")) {
  optimizedSrc = (await getImage({ src: fondo3Webp, format: 'webp', width: 1920 })).src;
}
---

<section class={`relative w-full ${height} flex items-center justify-center overflow-hidden py-16 px-4 @container`}>
  <!-- Background Image with smooth zoom on hover -->
  <img 
    src={optimizedSrc} 
    alt={title || "Incoltec food color solutions"} 
    class="absolute inset-0 w-full h-full object-cover object-center transform hover:scale-105 transition-transform duration-[12s] ease-out" 
    loading="lazy"
    decoding="async"
    width="1920"
    height="1080"
  />
  
  <!-- Subtle Vignette Layer -->
  <div class="absolute inset-0 bg-gradient-to-t from-black/75 via-black/40 to-black/65 z-10 pointer-events-none"></div>

  <!-- Clean Overlay Content without Card or Capsule Surrounds -->
  {(tag || title || subtitle) && (
    <div class="relative z-20 max-w-4xl mx-auto w-full text-center px-6 sm:px-8 py-8 reveal-scale delay-100 @container">
      {tag && (
        <div class="inline-flex items-center gap-2.5 mb-5 drop-shadow-md">
          <BrandEIcon class="w-3.5 h-4.5 shrink-0" />
          <span class="font-verdana text-xs sm:text-sm uppercase tracking-[0.25em] font-bold text-[#FFC000]">
            {tag}
          </span>
        </div>
      )}
      {title && (
        <h3 class="font-heading fluid-h1 font-normal text-white mb-6 leading-[1.2] sm:leading-[1.25] drop-shadow-[0_4px_16px_rgba(0,0,0,0.7)] flowy-text tracking-wide" set:html={title.replace('Shaping the Future of Food Appeal', 'Shaping the Future<br class="hidden sm:inline" /> of Food Appeal').replace(' & ', ' and ')} />
      )}

      {subtitle && (
        <p class="font-verdana fluid-body font-light text-white/95 max-w-2xl mx-auto leading-relaxed drop-shadow-[0_2px_8px_rgba(0,0,0,0.7)]">
          {subtitle}
        </p>
      )}
    </div>
  )}
</section>

