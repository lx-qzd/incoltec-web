---

<div class="color-solutions-wrapper w-full">
  {showHero && (
    <section 
      id="aplicaciones" 
      class="relative w-full min-h-[520px] md:min-h-[580px] flex items-center justify-center overflow-hidden bg-cover bg-center"
      style="background-image: url('/assets/soluciones.webp'), url('/assets/soluciones.jpg');"
    >
      <div class="absolute inset-0 bg-gradient-to-r from-black/85 via-black/60 to-black/35 pointer-events-none"></div>

      <div class="relative z-10 w-full max-w-[1240px] mx-auto px-4 sm:px-8 md:px-12 py-16 md:py-24">
        <div class="max-w-2xl text-white">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/10 backdrop-blur-md border border-white/20 mb-4 text-xs font-semibold tracking-wider uppercase text-[#FFC000]">
            <span class="w-2 h-2 rounded-full bg-[#008AD8] animate-pulse"></span>
            {isEs ? "Catálogo de Aplicaciones" : "Application Directory"}
          </div>

          <h1 class="font-heading fluid-hero text-white uppercase font-bold tracking-tight mb-4 leading-none">
            {isEs ? "Soluciones de Color" : "Colour Solutions"}
          </h1>

          <p class="font-verdana text-white/90 text-sm sm:text-base md:text-lg mb-8 leading-relaxed max-w-xl">
            {isEs 
              ? "Busca nuestros productos entre las diferentes aplicaciones de color disponibles en nuestra web."
              : "Search for our products among the different colour applications available on our website."}
          </p>

          <div class="relative max-w-lg">
            <div class="relative flex items-center">
              <span class="absolute left-4 text-white/70 pointer-events-none">
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                </svg>
              </span>
              <input 
                type="text" 
                id="buscadorAplicaciones" 
                class="w-full bg-black/40 backdrop-blur-md text-white placeholder-white/70 border-2 border-white/80 rounded-xl pl-12 pr-10 py-3.5 text-sm sm:text-base focus:outline-none focus:border-[#FFC000] focus:ring-2 focus:ring-[#FFC000]/30 transition-all shadow-xl"
                placeholder={isEs ? "Buscar aplicaciones de colorantes..." : "Search coloring applications..."}
                autocomplete="off"
              />
              <button 
                id="clearSearchBtn" 
                class="absolute right-3 text-white/60 hover:text-white hidden p-1 focus:outline-none"
                aria-label="Clear search"
              >
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                </svg>
              </button>
            </div>

            <div 
              id="resultBuscador" 
              class="hidden absolute top-full left-0 right-0 mt-2 bg-white rounded-xl shadow-2xl border border-gray-100 overflow-hidden z-50 max-h-80 overflow-y-auto"
            >
            </div>
          </div>
        </div>
      </div>
    </section>
  )}

  <!-- Main Content Area: Food Coloring Applications Grid -->
  <main id="main-applications" class="w-full bg-[#FFFDF9] py-16 sm:py-20 md:py-28">
    <div class="w-full max-w-[1240px] mx-auto px-4 sm:px-8 md:px-12">
      
