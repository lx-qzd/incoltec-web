<script>
  function initColorSolutions() {
    const searchInput = document.getElementById("buscadorAplicaciones") as HTMLInputElement | null;
    const resultDropdown = document.getElementById("resultBuscador") as HTMLDivElement | null;
    const clearSearchBtn = document.getElementById("clearSearchBtn") as HTMLButtonElement | null;
    const grid = document.getElementById("applicationsGrid");
    const cards = document.querySelectorAll(".single-application") as NodeListOf<HTMLElement>;
    const noResults = document.getElementById("noAppResults");
    const filterChips = document.querySelectorAll(".filter-chip") as NodeListOf<HTMLButtonElement>;
    const filterStatus = document.getElementById("filterStatus");
    const resultsCount = document.getElementById("resultsCount");
    const resetFiltersBtn = document.getElementById("resetFiltersBtn");
    const resetSearchBtn = document.getElementById("resetSearchBtn");

    // Modal elements
    const modal = document.getElementById("appModal");
    const modalCard = document.getElementById("appModalCard");
    const closeModalBtn = document.getElementById("closeModalBtn");
    const modalImg = document.getElementById("modalImg") as HTMLImageElement | null;
    const modalCategory = document.getElementById("modalCategory");
    const modalTitle = document.getElementById("modalTitle");
    const modalDesc = document.getElementById("modalDesc");
    const modalColors = document.getElementById("modalColors");
    const modalProductsList = document.getElementById("modalProductsList");
    const modalCatalogLink = document.getElementById("modalCatalogLink") as HTMLAnchorElement | null;

    const apps = (window as any).__incoltecApplications || [];
    const isEs = (window as any).__incoltecIsEs || false;

    let activeCategory = "all";
    let searchQuery = "";

    // Set first chip active
    const firstChip = document.querySelector('.filter-chip[data-category="all"]');
    if (firstChip) {
      firstChip.classList.add("bg-[#E30066]", "text-white", "border-[#E30066]");
      firstChip.classList.remove("bg-white", "text-gray-700");
    }

    function filterGrid() {
      const q = searchQuery.trim().toLowerCase();
      let visibleCount = 0;

      cards.forEach((card) => {
        const title = card.getAttribute("data-title") || "";
        const titleAlt = card.getAttribute("data-title-alt") || "";
        const desc = card.getAttribute("data-desc") || "";
        const category = card.getAttribute("data-category") || "";

        const matchesCategory = activeCategory === "all" || category === activeCategory;
        const matchesQuery = !q || title.includes(q) || titleAlt.includes(q) || desc.includes(q);

        if (matchesCategory && matchesQuery) {
          card.style.display = "";
          visibleCount++;
        } else {
          card.style.display = "none";
        }
      });

      // Update counters & states
      if (noResults) {
        noResults.classList.toggle("hidden", visibleCount > 0);
      }
      if (grid) {
        grid.classList.toggle("hidden", visibleCount === 0);
      }

      if (filterStatus && resultsCount) {
        const total = cards.length;
        if (q || activeCategory !== "all") {
          filterStatus.classList.remove("hidden");
          resultsCount.textContent = isEs 
            ? `Mostrando ${visibleCount} de ${total} aplicaciones` 
            : `Showing ${visibleCount} of ${total} applications`;
        } else {
          filterStatus.classList.add("hidden");
        }
      }
    }

    // Search input handler
    if (searchInput) {
      searchInput.addEventListener("input", () => {
        searchQuery = searchInput.value;
        if (clearSearchBtn) {
          clearSearchBtn.classList.toggle("hidden", !searchQuery);
        }
        updateSuggestions(searchQuery);
        filterGrid();
      });

      // Hide suggestions when clicking outside
      document.addEventListener("click", (e) => {
        if (!searchInput.contains(e.target as Node) && !resultDropdown?.contains(e.target as Node)) {
          if (resultDropdown) resultDropdown.classList.add("hidden");
        }
      });
    }

    if (clearSearchBtn && searchInput) {
      clearSearchBtn.addEventListener("click", () => {
        searchInput.value = "";
        searchQuery = "";
        clearSearchBtn.classList.add("hidden");
        if (resultDropdown) resultDropdown.classList.add("hidden");
        filterGrid();
        searchInput.focus();
      });
    }

    // Populate live suggestion dropdown
    function updateSuggestions(q: string) {
      if (!resultDropdown) return;
      const clean = q.trim().toLowerCase();
      if (!clean) {
        resultDropdown.classList.add("hidden");
        resultDropdown.innerHTML = "";
        return;
      }

      const matches = apps.filter((a: any) => {
        const tEn = a.titleEn.toLowerCase();
        const tEs = a.titleEs.toLowerCase();
        const dEn = a.descEn.toLowerCase();
        const dEs = a.descEs.toLowerCase();
        return tEn.includes(clean) || tEs.includes(clean) || dEn.includes(clean) || dEs.includes(clean);
      });

      if (matches.length === 0) {
        resultDropdown.classList.remove("hidden");
        resultDropdown.innerHTML = `
          <div class="p-4 text-xs text-gray-500 text-center">
            ${isEs ? "Sin resultados para" : "No results for"} "${q}"
          </div>
        `;
        return;
      }

      resultDropdown.classList.remove("hidden");
      resultDropdown.innerHTML = matches.map((m: any) => `
        <a 
          href="#main-applications" 
          data-app-id="${m.id}" 
          class="suggestion-item flex items-center gap-3 p-3 hover:bg-gray-50 border-b border-gray-100 last:border-b-0 transition-colors cursor-pointer"
        >
          <img src="${m.image}" alt="${isEs ? m.titleEs : m.titleEn}" class="w-10 h-10 object-cover rounded-lg shrink-0" />
          <div class="overflow-hidden">
            <div class="font-semibold text-xs sm:text-sm text-gray-900 truncate">${isEs ? m.titleEs : m.titleEn}</div>
            <div class="text-[11px] text-gray-500 truncate">${isEs ? m.categoryEs : m.categoryEn}</div>
          </div>
        </a>
      `).join("");

      // Suggestion click listener
      resultDropdown.querySelectorAll(".suggestion-item").forEach(item => {
        item.addEventListener("click", (e) => {
          e.preventDefault();
          const appId = item.getAttribute("data-app-id");
          const targetApp = apps.find((a: any) => a.id === appId);
          if (targetApp) {
            openModal(targetApp);
          }
          resultDropdown.classList.add("hidden");
        });
      });
    }

    // Category chips handler
    filterChips.forEach(chip => {
      chip.addEventListener("click", () => {
        const cat = chip.getAttribute("data-category") || "all";
        activeCategory = cat;

        filterChips.forEach(c => {
          c.classList.remove("bg-[#E30066]", "text-white", "border-[#E30066]");
          c.classList.add("bg-white", "text-gray-700", "border-gray-200");
        });
        chip.classList.add("bg-[#E30066]", "text-white", "border-[#E30066]");
        chip.classList.remove("bg-white", "text-gray-700");

        filterGrid();
      });
    });

    // Reset buttons
    function resetAll() {
      searchQuery = "";
      activeCategory = "all";
      if (searchInput) searchInput.value = "";
      if (clearSearchBtn) clearSearchBtn.classList.add("hidden");
      if (resultDropdown) resultDropdown.classList.add("hidden");

      filterChips.forEach(c => {
        if (c.getAttribute("data-category") === "all") {
          c.classList.add("bg-[#E30066]", "text-white", "border-[#E30066]");
          c.classList.remove("bg-white", "text-gray-700");
        } else {
          c.classList.remove("bg-[#E30066]", "text-white", "border-[#E30066]");
          c.classList.add("bg-white", "text-gray-700");
        }
      });

      filterGrid();
    }

    if (resetFiltersBtn) resetFiltersBtn.addEventListener("click", resetAll);
    if (resetSearchBtn) resetSearchBtn.addEventListener("click", resetAll);

    // Card click opens modal
    cards.forEach(card => {
      card.addEventListener("click", () => {
        const appId = card.getAttribute("data-app-id");
        const app = apps.find((a: any) => a.id === appId);
        if (app) {
          openModal(app);
        }
      });
    });

    function openModal(app: any) {
      if (!modal || !modalCard) return;

      if (modalImg) {
        modalImg.src = app.image;
        modalImg.alt = isEs ? app.titleEs : app.titleEn;
      }
      if (modalCategory) {
        modalCategory.textContent = isEs ? app.categoryEs : app.categoryEn;
      }
      if (modalTitle) {
        modalTitle.textContent = isEs ? app.titleEs : app.titleEn;
      }
      if (modalDesc) {
        modalDesc.textContent = isEs ? app.descEs : app.descEn;
      }

      if (modalColors) {
        const colors = isEs ? app.colorsEs : app.colorsEn;
        modalColors.innerHTML = colors.map((c: string) => `
          <span class="px-2.5 py-1 rounded-lg bg-gray-100 border border-gray-200 text-gray-800 text-xs font-mono font-medium">
            ${c}
          </span>
        `).join("");
      }

      if (modalProductsList) {
        const prods = app.featuredProducts || [];
        if (prods.length > 0) {
          modalProductsList.innerHTML = prods.map((p: any) => `
            <a 
              href="${isEs ? `/es/products/${p.slug}` : `/products/${p.slug}`}" 
              class="inline-flex items-center gap-1.5 px-3 py-1 rounded-lg bg-white border border-amber-300 text-amber-900 text-xs font-semibold hover:bg-amber-100 transition-colors"
            >
              <span>${p.name}</span>
              <svg class="w-3.5 h-3.5 text-amber-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
            </a>
          `).join("");
        } else {
          modalProductsList.innerHTML = `
            <span class="text-xs text-amber-800/80">
              ${isEs ? "Consultar con laboratorio para formulación específica." : "Contact laboratory for custom formulation."}
            </span>
          `;
        }
      }

      if (modalCatalogLink) {
        const targetSearch = encodeURIComponent(isEs ? app.titleEs : app.titleEn);
        modalCatalogLink.href = isEs ? `/es/products?search=${targetSearch}` : `/products?search=${targetSearch}`;
      }

      // Show modal
      modal.classList.remove("opacity-0", "pointer-events-none");
      modalCard.classList.remove("scale-95");
      modalCard.classList.add("scale-100");
      document.body.style.overflow = "hidden";
    }

    function closeModal() {
      if (!modal || !modalCard) return;
      modal.classList.add("opacity-0", "pointer-events-none");
      modalCard.classList.add("scale-95");
      modalCard.classList.remove("scale-100");
      document.body.style.overflow = "";
    }

    if (closeModalBtn) closeModalBtn.addEventListener("click", closeModal);
    if (modal) {
      modal.addEventListener("click", (e) => {
        if (e.target === modal) closeModal();
      });
    }

    // Escape key
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape") closeModal();
    });
  }

  // Run on page load & Astro view transitions
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initColorSolutions);
  } else {
    initColorSolutions();
  }
  document.addEventListener("astro:page-load", initColorSolutions);
</script>

<style>
  .scrollbar-none::-webkit-scrollbar {
    display: none;
  }
  .scrollbar-none {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
</style>
