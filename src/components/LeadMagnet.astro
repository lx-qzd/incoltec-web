---
import PdfSection from "./PdfSection.astro";

interface Props {
  title?: string;
  description?: string;
  buttonText?: string;
  placeholderName?: string;
  placeholderEmail?: string;
  placeholderCompany?: string;
  privacyText?: string;
}

const { 
  title = "Download Our 2024 Technical Catalog",
  description = "Get comprehensive information about our natural color applications, specifications, and regulatory compliance for the B2B food industry.",
  buttonText = "Download Catalog",
  placeholderName = "Your Name",
  placeholderEmail = "Corporate Email",
  placeholderCompany = "Company Name",
  privacyText = "I agree to the Privacy Policy"
} = Astro.props;
---

<PdfSection title="Contact Us" bgImage="/assets/fondo1.jpg">
  <div class="space-y-10">
    <div class="max-w-xl">
      <h3 class="text-3xl md:text-4xl font-light text-white mb-4">{title}</h3>
      <p class="text-gray-300 text-lg md:text-xl font-light leading-relaxed">
        {description}
      </p>
    </div>

    <!-- Contact Form -->
    <form class="space-y-6 max-w-xl" onsubmit="event.preventDefault(); alert('Catalog download started!');">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div class="relative group">
          <input 
            type="text" 
            placeholder={placeholderName}
            required
            class="w-full bg-white/5 border border-white/20 text-white placeholder-gray-400 px-6 py-4 rounded-xl focus:outline-none focus:border-[#008AD8] focus:bg-white/10 transition-all"
          />
        </div>
        <div class="relative group">
          <input 
            type="email" 
            placeholder={placeholderEmail}
            required
            class="w-full bg-white/5 border border-white/20 text-white placeholder-gray-400 px-6 py-4 rounded-xl focus:outline-none focus:border-[#E30066] focus:bg-white/10 transition-all"
          />
        </div>
      </div>
      
      <div class="relative group">
        <input 
          type="text" 
          placeholder={placeholderCompany}
          class="w-full bg-white/5 border border-white/20 text-white placeholder-gray-400 px-6 py-4 rounded-xl focus:outline-none focus:border-[#FFC000] focus:bg-white/10 transition-all"
        />
      </div>

      <div class="flex items-center gap-3">
        <input 
          type="checkbox" 
          id="privacy" 
          required
          class="w-5 h-5 rounded border-white/20 bg-white/5 text-[#E30066] focus:ring-[#E30066] focus:ring-offset-0 transition-colors cursor-pointer"
        />
        <label for="privacy" class="text-sm text-gray-400 cursor-pointer hover:text-white transition-colors">
          {privacyText}
        </label>
      </div>

      <button 
        type="submit"
        class="w-full md:w-auto px-10 py-5 bg-gradient-to-r from-[#FFC000] via-[#E30066] to-[#008AD8] text-white font-bold rounded-xl shadow-[0_0_40px_rgba(227,0,102,0.3)] hover:shadow-[0_0_60px_rgba(227,0,102,0.5)] transform hover:-translate-y-1 transition-all duration-300"
      >
        {buttonText}
      </button>
    </form>
  </div>
</PdfSection>
