---
import { Image } from "astro:assets";
import fondo1Webp from "../assets/fondo1.webp";
import ContactForm from "./ContactForm.astro";
import { getLang } from "../i18n/routes";

interface Props {
  title?: string;
  description?: string;
  buttonText?: string;
  /** Preselected reason in the form (sample, datasheet, formulation, horeca…). */
  reason?: string;
}

const lang = getLang(Astro.url.pathname);
const isEs = lang === "es";
const {
  title = isEs ? "Contacto" : "Contact us",
  description = isEs
    ? "Solicita muestras, fichas técnicas o soporte de formulación para tus aplicaciones."
    : "Request samples, technical data sheets or formulation support for your applications.",
  buttonText,
  reason = "",
} = Astro.props;
---

<section id="contact" class="contact-hero-section relative min-h-[100dvh] flex items-center pt-24 sm:pt-28 pb-16 sm:pb-20 scroll-mt-24 overflow-hidden @container">
  <div class="absolute inset-0 z-0">
    <Image src={fondo1Webp} alt="" class="w-full h-full object-cover" loading="lazy" decoding="async" width={1920} height={1080} />
    <div class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/55 to-black/65 pointer-events-none"></div>
  </div>

  <div class="container relative z-20 w-full max-w-4xl mx-auto px-4 sm:px-6">
    <div class="glass-card-dark rounded-2xl p-6 sm:p-10 md:p-12 border border-white/20 shadow-[0_24px_60px_-15px_rgba(0,0,0,0.7)] backdrop-blur-2xl">
      <div class="w-full text-center mb-8">
        <span class="font-verdana text-xs uppercase tracking-[0.25em] text-[#FFC000] font-bold">
          {isEs ? "Hablemos" : "Get in touch"}
        </span>
        <h2 class="font-heading fluid-h1 text-white font-normal mt-3 mb-3 leading-tight">{title}</h2>
        {description && <p class="font-verdana text-white/90 text-sm sm:text-base md:text-lg font-light max-w-2xl mx-auto leading-relaxed">{description}</p>}
      </div>
      <ContactForm lang={lang} id="leadForm" variant="dark" reason={reason} submitLabel={buttonText} />
    </div>
  </div>
</section>

<style>
  .contact-hero-section { overflow: hidden; }
  @media (max-width: 768px) { .contact-hero-section { padding-top: 7rem; } }
</style>
