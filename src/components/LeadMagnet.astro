---
import PdfSection from "./PdfSection.astro";

interface Props {
  title?: string;
  description?: string;
  buttonText?: string;
  placeholderName?: string;
  placeholderEmail?: string;
  placeholderCompany?: string;
  privacyText?: string;
}

const { 
  title = "Contact Us",
  description = "Get comprehensive information about our natural color applications, specifications, and regulatory compliance for the B2B food industry.",
  buttonText = "Submit",
  placeholderName = "Your Name",
  placeholderEmail = "Corporate Email",
  placeholderCompany = "Company Name",
  privacyText = "I agree to the Privacy Policy"
} = Astro.props;
---

<section id="contact" class="contact-hero-section relative min-h-screen flex items-center pt-32 pb-20 scroll-mt-24">
  <div class="absolute inset-0 z-0">
    <img src="/assets/fondo1.jpg" alt="Background" class="w-full h-full object-cover" />
    <div class="absolute inset-0 bg-black/30"></div>
  </div>
  
  <!-- Decorative Polygons (Left) -->
  <div class="absolute left-0 top-1/2 -translate-y-1/2 flex flex-col gap-6 z-10 w-40 md:w-64">
    <div class="polygon polygon-yellow"></div>
    <div class="polygon polygon-pink"></div>
    <div class="polygon polygon-blue"></div>
  </div>

  <div class="container relative z-20 flex flex-col gap-8 w-full max-w-5xl mx-auto px-6 pl-24 md:pl-48">
    
    <div class="w-full text-center md:text-left">
       <h2 class="font-secondary text-5xl md:text-7xl text-white mb-2 font-bold tracking-wide" style="font-family: 'Great Vibes', cursive;">{title}</h2>
       {description && <p class="text-white/90 text-lg md:text-xl mt-4 font-light max-w-2xl">{description}</p>}
    </div>

    <div class="contact-form-container w-full">
      <form class="contact-form" id="leadMagnetForm" action="#" method="POST" onsubmit="event.preventDefault(); alert('Form submitted!');">
        <!-- Anti-spam Honeypot -->
        <div style="display:none;">
          <label for="bot_field_lead">Leave this empty:</label>
          <input type="text" id="bot_field_lead" name="bot_field" />
        </div>

        <div class="form-grid">
          <div class="form-group">
            <input type="text" id="lm_name" name="name" required placeholder={placeholderName} />
          </div>
          <div class="form-group">
            <input type="email" id="lm_email" name="email" required placeholder={placeholderEmail} />
          </div>
        </div>
        
        <div class="form-group">
          <input type="text" id="lm_company" name="company" placeholder={placeholderCompany} />
        </div>
        
        <div class="form-group">
          <textarea id="lm_message" name="message" rows="5" required placeholder="HOW CAN WE HELP"></textarea>
        </div>

        <div class="form-checkbox">
          <input type="checkbox" id="lm_privacy" name="privacy" required />
          <label for="lm_privacy">{privacyText}</label>
        </div>

        <div class="form-checkbox">
          <input type="checkbox" id="lm_commercial" name="commercial" />
          <label for="lm_commercial">I WOULD LIKE TO RECEIVE COMMERCIAL COMMUNICATIONS</label>
        </div>

        <div class="submit-container flex justify-end mt-6">
          <button type="submit" class="submit-btn" id="lm_submitBtn">{buttonText}</button>
        </div>
      </form>
    </div>
  </div>
</section>

<style>
  .contact-hero-section {
    overflow: hidden;
  }

  /* Polygons styling */
  .polygon {
    height: 90px;
    width: 100%;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.2);
  }
  
  .polygon-yellow { 
    background: linear-gradient(90deg, #ffde00, #ffae00); 
    clip-path: polygon(0 0, 100% 0, 80% 100%, 0% 100%); 
  }
  .polygon-pink { 
    background: linear-gradient(90deg, #ff1b7a, #e6005c); 
    clip-path: polygon(0 0, 100% 0, 80% 100%, 0% 100%); 
  }
  .polygon-blue { 
    background: linear-gradient(90deg, #0084ff, #0056b3); 
    clip-path: polygon(0 0, 100% 0, 80% 100%, 0% 100%); 
  }

  .form-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
    margin-bottom: 1.5rem;
  }

  .form-group {
    margin-bottom: 1.5rem;
  }

  .form-group input,
  .form-group textarea {
    width: 100%;
    padding: 1rem 1.2rem;
    background: rgba(255, 255, 255, 0.15);
    border: 1px solid rgba(255, 255, 255, 0.2);
    color: var(--c-white);
    border-radius: 12px;
    font-family: inherit;
    font-size: 0.95rem;
    letter-spacing: 0.05em;
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    transition: all 0.3s ease;
  }

  .form-group input::placeholder,
  .form-group textarea::placeholder {
    color: rgba(255, 255, 255, 0.8);
  }

  .form-group input:focus,
  .form-group textarea:focus {
    outline: none;
    background: rgba(255, 255, 255, 0.25);
    border-color: rgba(255, 255, 255, 0.5);
  }

  .form-checkbox {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    margin-bottom: 1rem;
  }

  .form-checkbox input[type="checkbox"] {
    appearance: none;
    width: 20px;
    height: 20px;
    border: 1px solid rgba(255, 255, 255, 0.4);
    border-radius: 4px;
    background: rgba(255, 255, 255, 0.1);
    cursor: pointer;
    position: relative;
    display: grid;
    place-content: center;
  }

  .form-checkbox input[type="checkbox"]::before {
    content: "";
    width: 10px;
    height: 10px;
    transform: scale(0);
    transition: 120ms transform ease-in-out;
    box-shadow: inset 1em 1em white;
    background-color: white;
    transform-origin: center;
    clip-path: polygon(14% 44%, 0 65%, 50% 100%, 100% 16%, 80% 0%, 43% 62%);
  }

  .form-checkbox input[type="checkbox"]:checked::before {
    transform: scale(1);
  }

  .form-checkbox label {
    font-size: 0.8rem;
    color: rgba(255, 255, 255, 0.9);
    letter-spacing: 0.05em;
    cursor: pointer;
  }

  .submit-btn {
    background: linear-gradient(135deg, var(--c-magenta, #E30066) 0%, #FF1A75 100%);
    color: var(--c-white);
    border: 1px solid rgba(255, 255, 255, 0.4);
    padding: 0.85rem 2.75rem;
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    cursor: pointer;
    border-radius: 999px;
    box-shadow: 0 4px 15px rgba(227, 0, 102, 0.4);
    backdrop-filter: blur(10px);
    transition: all 0.3s ease;
  }

  .submit-btn:hover {
    background: linear-gradient(135deg, #c20055 0%, #E30066 100%);
    border-color: rgba(255, 255, 255, 0.7);
    box-shadow: 0 6px 22px rgba(227, 0, 102, 0.6);
    transform: translateY(-2px);
  }

  @media (max-width: 768px) {
    .form-grid {
      grid-template-columns: 1fr;
    }
    .contact-hero-section {
      padding-top: 8rem;
    }
  }
</style>
