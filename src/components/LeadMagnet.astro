---
import PdfSection from "./PdfSection.astro";

interface Props {
  title?: string;
  description?: string;
  buttonText?: string;
  placeholderName?: string;
  placeholderEmail?: string;
  placeholderCompany?: string;
  privacyText?: string;
}

const { 
  title = "Contact Us",
  description = "Get comprehensive information about our natural color applications, specifications, and regulatory compliance for the B2B food industry.",
  buttonText = "Submit",
  placeholderName = "Your Name",
  placeholderEmail = "Corporate Email",
  placeholderCompany = "Company Name",
  privacyText = "I agree to the Privacy Policy"
} = Astro.props;
---

<PdfSection title="Contact Us" bgImage="/assets/fondo1.jpg">
  <div class="flex flex-col gap-12 sm:gap-16 max-w-2xl">
    
    <div class="flex flex-col gap-6">
      <h3 class="text-4xl sm:text-5xl md:text-6xl font-light text-white leading-tight tracking-wide">{title}</h3>
      <div class="w-20 h-1.5 bg-gradient-to-r from-[#FFC000] via-[#E30066] to-[#008AD8] rounded-full"></div>
      <p class="text-gray-300 text-xl sm:text-2xl font-light leading-relaxed">
        {description}
      </p>
    </div>

    <!-- Contact Form -->
    <form class="flex flex-col gap-10" onsubmit="event.preventDefault(); alert('Form submitted!');">
      
      <div class="flex flex-col gap-10 sm:flex-row">
        <div class="flex flex-col gap-3 w-full">
          <label class="text-lg font-medium text-white/90 pl-1">Name</label>
          <input 
            type="text" 
            placeholder={placeholderName}
            required
            class="w-full bg-white/10 border-2 border-white/20 text-white placeholder-gray-400 px-8 py-6 rounded-2xl focus:outline-none focus:border-[#E30066] focus:bg-white/20 transition-all text-lg shadow-inner"
          />
        </div>
        
        <div class="flex flex-col gap-3 w-full">
          <label class="text-lg font-medium text-white/90 pl-1">Email</label>
          <input 
            type="email" 
            placeholder={placeholderEmail}
            required
            class="w-full bg-white/10 border-2 border-white/20 text-white placeholder-gray-400 px-8 py-6 rounded-2xl focus:outline-none focus:border-[#E30066] focus:bg-white/20 transition-all text-lg shadow-inner"
          />
        </div>
      </div>
      
      <div class="flex flex-col gap-3">
        <label class="text-lg font-medium text-white/90 pl-1">Company</label>
        <input 
          type="text" 
          placeholder={placeholderCompany}
          class="w-full bg-white/10 border-2 border-white/20 text-white placeholder-gray-400 px-8 py-6 rounded-2xl focus:outline-none focus:border-[#E30066] focus:bg-white/20 transition-all text-lg shadow-inner"
        />
      </div>

      <div class="flex flex-col gap-3">
        <label class="text-lg font-medium text-white/90 pl-1">Message</label>
        <textarea 
          placeholder="How can we help?"
          rows="4"
          class="w-full bg-white/10 border-2 border-white/20 text-white placeholder-gray-400 px-8 py-6 rounded-3xl focus:outline-none focus:border-[#E30066] focus:bg-white/20 transition-all text-lg resize-none shadow-inner"
        ></textarea>
      </div>

      <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-8 mt-4">
        
        <div class="flex items-center gap-5 cursor-pointer group">
          <div class="relative flex items-center justify-center">
            <input 
              type="checkbox" 
              id="privacy" 
              required
              class="w-8 h-8 rounded-lg border-2 border-white/40 bg-white/10 text-[#E30066] focus:ring-[#E30066] focus:ring-offset-0 transition-colors cursor-pointer shrink-0 appearance-none checked:bg-[#E30066] checked:border-transparent peer relative z-10"
            />
            <svg class="absolute w-5 h-5 text-white opacity-0 peer-checked:opacity-100 pointer-events-none z-20" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"/></svg>
          </div>
          <label for="privacy" class="text-lg text-gray-300 cursor-pointer group-hover:text-white transition-colors">
            {privacyText}
          </label>
        </div>

        <button 
          type="submit"
          class="w-full sm:w-auto px-12 py-6 bg-gradient-to-r from-[#FFC000] via-[#E30066] to-[#008AD8] text-white font-bold rounded-2xl shadow-[0_0_40px_rgba(227,0,102,0.4)] hover:shadow-[0_0_60px_rgba(227,0,102,0.6)] transform hover:-translate-y-1 transition-all duration-300 text-xl tracking-wide whitespace-nowrap"
        >
          {buttonText}
        </button>

      </div>
    </form>
  </div>
</PdfSection>
