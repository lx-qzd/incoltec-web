---
import 'vanilla-cookieconsent/dist/cookieconsent.css';
const urlPath = Astro.url.pathname;
const isEs = urlPath.startsWith('/es');
---

<script>
  import * as CookieConsent from 'vanilla-cookieconsent';
  const isEs = window.location.pathname.startsWith('/es');

  CookieConsent.run({
    guiOptions: {
      consentModal: {
        layout: 'box',
        position: 'bottom right',
        equalWeightButtons: true,
        flipButtons: false
      },
      preferencesModal: {
        layout: 'box',
        position: 'right',
        equalWeightButtons: true,
        flipButtons: false
      }
    },
    categories: {
      necessary: {
        readOnly: true
      },
      analytics: {
        autoClear: { cookies: [{ name: /^_pk_/ }] }
      }
    },
    language: {
      default: isEs ? 'es' : 'en',
      translations: {
        en: {
          consentModal: {
            title: "Cookies on this website",
            description: "We use necessary cookies to make this site work and, only if you accept, analytics cookies to understand how it is used.",
            acceptAllBtn: "Accept all",
            acceptNecessaryBtn: "Reject all",
            showPreferencesBtn: "Manage preferences",
            footer: "<a href=\"/privacy-policy\">Privacy Policy</a>\n<a href=\"/cookie-policy\">Cookie Policy</a>"
          },
          preferencesModal: {
            title: "Cookie Preferences",
            acceptAllBtn: "Accept all",
            acceptNecessaryBtn: "Reject all",
            savePreferencesBtn: "Save preferences",
            closeIconLabel: "Close modal",
            sections: [
              {
                title: "Cookie Usage",
                description: "We use cookies for the basic functions of the website and, with your consent, to measure its use. You can change your choice at any time."
              },
              {
                title: "Strictly Necessary Cookies",
                description: "These cookies are essential for the website to work and cannot be disabled.",
                linkedCategory: "necessary"
              },
              {
                title: "Performance and Analytics Cookies",
                description: "Pseudonymous statistics about visits and page use (Matomo, hosted by Incoltec). Only set if you accept.",
                linkedCategory: "analytics"
              },
              {
                title: "More information",
                description: "For any queries in relation to our policy on cookies and your choices, please <a class=\"cc-link\" href=\"/contact\">contact us</a>."
              }
            ]
          }
        },
        es: {
          consentModal: {
            title: "Cookies en este sitio web",
            description: "Usamos cookies necesarias para que el sitio funcione y, solo si las aceptas, cookies analíticas para conocer cómo se utiliza.",
            acceptAllBtn: "Aceptar todas",
            acceptNecessaryBtn: "Rechazar todas",
            showPreferencesBtn: "Gestionar preferencias",
            footer: "<a href=\"/es/privacy-policy\">Política de Privacidad</a>\n<a href=\"/es/cookie-policy\">Política de Cookies</a>"
          },
          preferencesModal: {
            title: "Preferencias de cookies",
            acceptAllBtn: "Aceptar todas",
            acceptNecessaryBtn: "Rechazar todas",
            savePreferencesBtn: "Guardar preferencias",
            closeIconLabel: "Cerrar ventana",
            sections: [
              {
                title: "Uso de cookies",
                description: "Usamos cookies para las funciones básicas del sitio y, con tu consentimiento, para medir su uso. Puedes cambiar tu elección en cualquier momento."
              },
              {
                title: "Cookies estrictamente necesarias",
                description: "Estas cookies son imprescindibles para el funcionamiento del sitio y no se pueden desactivar.",
                linkedCategory: "necessary"
              },
              {
                title: "Cookies de rendimiento y análisis",
                description: "Estadísticas seudonimizadas de visitas y uso de páginas (Matomo, alojado por Incoltec). Solo se instalan si las aceptas.",
                linkedCategory: "analytics"
              },
              {
                title: "Más información",
                description: "Para cualquier consulta en relación con nuestra política de cookies y sus opciones, por favor <a class=\"cc-link\" href=\"/es/contact\">contáctenos</a>."
              }
            ]
          }
        }
      }
    }
  });
</script>

<style is:global>
  :root {
    --cc-primary-color: var(--c-magenta);
    --cc-bg: var(--c-dark);
    --cc-text: var(--c-light);
    --cc-btn-primary-bg: var(--c-magenta);
    --cc-btn-primary-text: var(--c-white);
    --cc-btn-primary-hover-bg: #c20055;
    --cc-btn-secondary-bg: rgba(255, 255, 255, 0.1);
    --cc-btn-secondary-text: var(--c-light);
    --cc-btn-secondary-hover-bg: rgba(255, 255, 255, 0.2);
    --cc-separator-border-color: rgba(255, 255, 255, 0.1);
    --cc-toggle-on-bg: var(--c-cyan);
    --cc-toggle-off-bg: rgba(255, 255, 255, 0.2);
  }
</style>
