---
interface Props {
  title?: string;
  variant?: "light" | "dark";
}
const { title = "Certified Quality and Safety", variant = "light" } = Astro.props;

const isDark = variant === "dark";
const sectionClass = isDark 
  ? "py-8 border-t border-[rgba(255,255,255,0.1)] overflow-hidden reveal w-full"
  : "bg-gray-50 py-10 border-b border-gray-100 overflow-hidden reveal w-full";

const titleClass = isDark
  ? "text-center text-xs font-bold text-[var(--c-light)] opacity-70 uppercase tracking-[0.2em]"
  : "text-center text-xs font-bold text-gray-400 uppercase tracking-[0.2em]";

const textClass = isDark
  ? "font-bold text-white text-xl tracking-wide"
  : "font-bold text-gray-700 text-xl tracking-wide";
---

<section class={sectionClass}>
  <div class="container mx-auto px-4 mb-6">
    <p class={titleClass}>{title}</p>
  </div>
  
  <div class="relative flex overflow-x-hidden group">
    <div class="animate-marquee flex whitespace-nowrap items-center opacity-70 grayscale group-hover:grayscale-0 transition-all duration-500">
      <!-- First Set -->
      <div class="flex items-center gap-3 mx-12">
        <svg class="w-10 h-10 text-[#008AD8]" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z" /></svg>
        <span class={textClass}>FSSC 22000</span>
      </div>
      <div class="flex items-center gap-3 mx-12">
        <svg class="w-10 h-10 text-[#E30066]" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" /></svg>
        <span class={textClass}>ISO 9001</span>
      </div>
      <div class="flex items-center gap-3 mx-12">
        <svg class="w-10 h-10 text-[#22C55E]" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M20.618 5.984A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016zM12 9v2m0 4h.01" /></svg>
        <span class={textClass}>HALAL</span>
      </div>
      <div class="flex items-center gap-3 mx-12">
        <svg class="w-10 h-10 text-[#FFC000]" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
        <span class={textClass}>KOSHER</span>
      </div>
      <!-- Duplicate Set for seamless loop -->
      <div class="flex items-center gap-3 mx-12">
        <svg class="w-10 h-10 text-[#008AD8]" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z" /></svg>
        <span class={textClass}>FSSC 22000</span>
      </div>
      <div class="flex items-center gap-3 mx-12">
        <svg class="w-10 h-10 text-[#E30066]" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" /></svg>
        <span class={textClass}>ISO 9001</span>
      </div>
      <div class="flex items-center gap-3 mx-12">
        <svg class="w-10 h-10 text-[#22C55E]" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M20.618 5.984A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016zM12 9v2m0 4h.01" /></svg>
        <span class={textClass}>HALAL</span>
      </div>
      <div class="flex items-center gap-3 mx-12">
        <svg class="w-10 h-10 text-[#FFC000]" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
        <span class={textClass}>KOSHER</span>
      </div>
      <!-- Third Set for ultra wide screens -->
      <div class="flex items-center gap-3 mx-12">
        <svg class="w-10 h-10 text-[#008AD8]" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z" /></svg>
        <span class={textClass}>FSSC 22000</span>
      </div>
      <div class="flex items-center gap-3 mx-12">
        <svg class="w-10 h-10 text-[#E30066]" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" /></svg>
        <span class={textClass}>ISO 9001</span>
      </div>
      <div class="flex items-center gap-3 mx-12">
        <svg class="w-10 h-10 text-[#22C55E]" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M20.618 5.984A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016zM12 9v2m0 4h.01" /></svg>
        <span class={textClass}>HALAL</span>
      </div>
      <div class="flex items-center gap-3 mx-12">
        <svg class="w-10 h-10 text-[#FFC000]" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
        <span class={textClass}>KOSHER</span>
      </div>
    </div>
  </div>
</section>

<style>
  .animate-marquee {
    animation: marquee 25s linear infinite;
    /* Since we have 3 sets of 4 items, we translate by -33.33% to seamlessly loop the first set */
  }
  .group:hover .animate-marquee {
    animation-play-state: paused;
  }
  @keyframes marquee {
    0% { transform: translateX(0); }
    100% { transform: translateX(-33.333333%); }
  }

  @media (prefers-reduced-motion: reduce) {
    .animate-marquee {
      animation: none;
      flex-wrap: wrap;
      justify-content: center;
      white-space: normal;
    }
  }
</style>
