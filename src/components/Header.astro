---
import { Astronav, MenuItems, MenuIcon, DropdownItems } from "astro-navbar";
import { Image } from "astro:assets";
// Wordmark without the "Shaping the future of food appeal" tagline, which was
// unreadable at header size (~4px tall).
import logoIncoltec from "../assets/LogoIncoltec-wordmark.png";
import { getAlternates, getLang, localizePath, normalizePath } from "../i18n/routes";

// `currentPath` is accepted for backwards compatibility but no longer needed.
interface Props { currentPath?: string }

const pathname = normalizePath(Astro.url.pathname);
const lang = getLang(pathname);
const isEs = lang === "es";
const alt = getAlternates(pathname);
const L = (p: string) => localizePath(p, lang);

interface Sublink { name: string; url: string }
interface NavLink { name: string; url: string; match: string; dropdown?: Sublink[] }

const t = isEs
  ? {
      products: "Productos", all: "Todos los productos", natural: "Colorantes naturales",
      colouring: "Alimentos colorantes (LINICOL)", vitamins: "Vitaminas y premixes",
      sectors: "Soluciones por sector", quality: "Calidad e I+D", qualityCommit: "Calidad y seguridad alimentaria",
      lab: "Laboratorio y producción", company: "Empresa", about: "Quiénes somos", org: "Organización",
      resources: "Recursos", catalogs: "Catálogos", blog: "Blog", contact: "Contacto",
      home: "Incoltec – inicio", toggle: (n: string) => `Mostrar submenú ${n}`,
      langNote: "Este artículo solo está disponible en inglés",
    }
  : {
      products: "Products", all: "All products", natural: "Natural colours",
      colouring: "Colouring foods (LINICOL)", vitamins: "Vitamins and premixes",
      sectors: "Solutions by sector", quality: "Quality & R&D", qualityCommit: "Quality and food safety",
      lab: "Laboratory and production", company: "Company", about: "About us", org: "Organisation",
      resources: "Resources", catalogs: "Catalogues", blog: "Blog", contact: "Contact",
      home: "Incoltec – home", toggle: (n: string) => `Show ${n} submenu`,
      langNote: "",
    };

const links: NavLink[] = [
  {
    name: t.products, url: L("/products"), match: "/products",
    dropdown: [
      { name: t.all, url: L("/products") },
      { name: t.natural, url: `${L("/products")}?category=natural-colours` },
      { name: t.colouring, url: `${L("/products")}?category=colouring-foods` },
      { name: t.vitamins, url: `${L("/products")}?category=vitamins-premixes` },
    ],
  },
  { name: t.sectors, url: L("/color-solutions"), match: "/color-solutions" },
  { name: "HORECA", url: L("/horeca"), match: "/horeca" },
  {
    name: t.quality, url: `${L("/our-company")}#quality`, match: "#quality",
    dropdown: [
      { name: t.qualityCommit, url: `${L("/our-company")}#quality` },
      { name: t.lab, url: `${L("/our-company")}#laboratory` },
    ],
  },
  {
    name: t.company, url: L("/our-company"), match: "/our-company",
    dropdown: [
      { name: t.about, url: `${L("/our-company")}#about` },
      { name: t.org, url: `${L("/our-company")}#organization` },
    ],
  },
  {
    name: t.resources, url: L("/catalogs"), match: "/catalogs|/blog",
    dropdown: [
      { name: t.catalogs, url: L("/catalogs") },
      { name: t.blog, url: L("/blog") },
    ],
  },
];

const base = pathname.replace(/^\/es(?=\/|$)/, "") || "/";
const isCurrent = (link: NavLink) =>
  !link.match.startsWith("#") && link.match.split("|").some((m) => base === m || base.startsWith(`${m}/`));
const contactHref = L("/contact");
// When the Spanish version is only a fallback (EN-only article), say so on the switcher.
const esTitle = alt.translated ? "Español" : "Español – este contenido solo está disponible en inglés";
---

<header class="incoltec-header" id="site-header" data-scrolled="false">
  <div class="incoltec-header__shell">
    <nav class="incoltec-header__nav" aria-label={isEs ? "Principal" : "Primary"}>
      <a href={L("/")} class="incoltec-header__logo" aria-label={t.home}>
        <Image
          src={logoIncoltec}
          alt="Incoltec"
          class="incoltec-header__logo-img"
          width={220}
          height={44}
          loading="eager"
          decoding="async"
        />
      </a>

      <Astronav closeOnClick>
        <div class="incoltec-header__mobile-toggle">
          <MenuIcon class="incoltec-header__hamburger-svg" />
        </div>

        <MenuItems class="hidden lg:flex incoltec-header__links-wrap">
          <ul class="incoltec-header__links">
            {links.map((link) => (
              <li class="incoltec-header__link-item">
                {link.dropdown ? (
                  <div class="astronav-dropdown group relative">
                    <div class="incoltec-header__link-row flex items-center justify-between">
                      <a href={link.url} class="incoltec-header__link" aria-current={isCurrent(link) ? "page" : undefined}>
                        <span>{link.name}</span>
                      </a>
                      <button
                        type="button"
                        aria-label={t.toggle(link.name)}
                        aria-haspopup="true"
                        class="incoltec-header__chevron-btn p-1 text-[#666] hover:text-[#1e1e1e]"
                      >
                        <svg class="incoltec-header__chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
                        </svg>
                      </button>
                    </div>
                    <DropdownItems class="incoltec-header__dropdown">
                      <div class="incoltec-header__dropdown-panel">
                        <ul class="incoltec-header__dropdown-list">
                          {link.dropdown.map((sublink) => (
                            <li><a href={sublink.url} class="incoltec-header__dropdown-link">{sublink.name}</a></li>
                          ))}
                        </ul>
                      </div>
                    </DropdownItems>
                  </div>
                ) : (
                  <a
                    href={link.url}
                    class={`incoltec-header__link ${link.name === "HORECA" ? "incoltec-header__link--horeca" : ""}`}
                    aria-current={isCurrent(link) ? "page" : undefined}
                  >
                    {link.name}
                  </a>
                )}
              </li>
            ))}
          </ul>

          <div class="incoltec-header__mobile-actions">
            <a href={contactHref} class="incoltec-header__cta w-full text-center mb-4">{t.contact}</a>
            <div class="incoltec-header__mobile-lang">
              <a href={alt.en} hreflang="en" lang="en" class={`incoltec-header__lang-link ${!isEs ? "is-active" : ""}`} aria-current={!isEs ? "true" : undefined} title="English">EN</a>
              <span class="incoltec-header__lang-sep" aria-hidden="true">|</span>
              <a href={alt.es} hreflang="es" lang="es" class={`incoltec-header__lang-link ${isEs ? "is-active" : ""}`} aria-current={isEs ? "true" : undefined} title={esTitle}>ES</a>
            </div>
          </div>
        </MenuItems>
      </Astronav>

      <div class="incoltec-header__actions">
        <div class="incoltec-header__lang-switch" role="group" aria-label={isEs ? "Idioma" : "Language"}>
          <a href={alt.en} hreflang="en" lang="en" class={`incoltec-header__lang-link ${!isEs ? "is-active" : ""}`} aria-current={!isEs ? "true" : undefined} title="English">EN</a>
          <span class="incoltec-header__lang-sep" aria-hidden="true">|</span>
          <a href={alt.es} hreflang="es" lang="es" class={`incoltec-header__lang-link ${isEs ? "is-active" : ""}`} aria-current={isEs ? "true" : undefined} title={esTitle}>ES</a>
        </div>
        <a href={contactHref} class="incoltec-header__cta">{t.contact}</a>
      </div>
    </nav>
  </div>
</header>

<style>
  /* ============================================================
     FUNCTION HEALTH–INSPIRED HEADER
     Clean, minimal, premium typography, generous spacing.
     ============================================================ */

  .incoltec-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(255, 255, 255, 0.97);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    transition:
      box-shadow 0.3s ease,
      background 0.3s ease;
  }

  .incoltec-header[data-scrolled="true"] {
    box-shadow: 0 1px 0 rgba(0, 0, 0, 0.06);
  }

  /* Shell: max-width container with generous side padding */
  .incoltec-header__shell {
    width: 100%;
    max-width: 1440px;
    margin: 0 auto;
    padding: 0 clamp(1.25rem, 3vw, 3rem);
  }

  /* Nav: flex layout — Logo | Links | Actions */
  .incoltec-header__nav {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: clamp(5.25rem, 6.5vw, 7rem);
    gap: clamp(0.75rem, 1.5vw, 2rem);
  }

  /* Logo */
  .incoltec-header__logo {
    display: flex;
    align-items: center;
    flex-shrink: 0;
    text-decoration: none;
    padding: 0.75rem 0;
  }

  .incoltec-header__logo-img {
    display: block;
    height: clamp(1.6rem, 2.4vw, 2.3rem);
    width: auto;
  }

  /* Desktop links container */
  .incoltec-header__links-wrap {
    display: none;
  }

  .incoltec-header__links {
    display: flex;
    align-items: center;
    gap: clamp(0.35rem, 1.2vw, 1.5rem);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .incoltec-header__link-item {
    position: relative;
  }

  /* Individual nav link — Function Health style: light weight, underline hover */
  .incoltec-header__link {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    padding: 0.5rem 0;
    font-family: var(--font-primary);
    font-size: clamp(0.8125rem, 0.9vw, 0.9375rem);
    font-weight: 500;
    line-height: 1.5;
    color: var(--c-dark, #1e1e1e);
    text-decoration: none;
    white-space: nowrap;
    cursor: pointer;
    background: none;
    border: none;
    transition: color 0.15s ease;
  }

  .incoltec-header__link:hover {
    opacity: 1;
  }

  /* Chevron for dropdown */
  .incoltec-header__chevron {
    width: 0.75rem;
    height: 0.75rem;
    margin-top: 1px;
    transition: transform 0.2s ease;
    flex-shrink: 0;
  }

  .group.open .incoltec-header__chevron,
  [aria-expanded="true"] .incoltec-header__chevron {
    transform: rotate(180deg);
  }

  /* Dropdown Panel */
  .incoltec-header__dropdown {
    position: absolute;
    top: 100%;
    left: 50%;
    transform: translateX(-50%) translateY(-0.5rem);
    min-width: 14rem;
    padding-top: 0.75rem;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition:
      opacity 0.18s ease,
      transform 0.18s ease,
      visibility 0.18s ease;
    z-index: 50;
  }

  /* Dropdown interactions: hover for desktop, click for mobile */
  @media (min-width: 1024px) {
    .incoltec-header__dropdown {
      display: block !important; /* override astro-navbar's hidden class */
    }
    .astronav-dropdown:hover .incoltec-header__dropdown,
    .astronav-dropdown:focus-within .incoltec-header__dropdown {
      opacity: 1;
      visibility: visible;
      pointer-events: auto;
      transform: translateX(-50%) translateY(0);
    }
    .astronav-dropdown:hover .incoltec-header__chevron {
      transform: rotate(180deg);
    }
  }
  @media (max-width: 1023px) {
    .incoltec-header__dropdown:not([hidden]),
    .incoltec-header__dropdown:not(.hidden) {
      opacity: 1;
      visibility: visible;
      pointer-events: auto;
      /* transform is overridden below for mobile */
    }
  }

  .incoltec-header__dropdown-panel {
    background: #fff;
    border: 1px solid rgba(0, 0, 0, 0.06);
    border-radius: 1rem;
    padding: 0.75rem 0;
    box-shadow:
      0 12px 40px rgba(0, 0, 0, 0.08),
      0 2px 8px rgba(0, 0, 0, 0.04);
  }

  .incoltec-header__dropdown-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .incoltec-header__dropdown-link {
    display: block;
    padding: 0.65rem 1.5rem;
    font-size: 0.9rem;
    font-weight: 400;
    color: #333;
    text-decoration: none;
    transition:
      background 0.12s ease,
      color 0.12s ease;
  }

  .incoltec-header__dropdown-link:hover {
    background: #f8f8f7;
    color: var(--c-dark, #1e1e1e);
    opacity: 1;
  }

  /* Actions area (right side) */
  .incoltec-header__actions {
    display: none;
    align-items: center;
    gap: 1.5rem;
    flex-shrink: 0;
  }

  /* Language switcher */
  .incoltec-header__lang-switch {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .incoltec-header__lang-link {
    font-size: 0.8125rem;
    font-weight: 500;
    color: #666;
    text-decoration: none;
    transition: color 0.15s ease;
    letter-spacing: 0.02em;
  }

  .incoltec-header__lang-link.is-active {
    color: var(--c-dark, #1e1e1e);
    font-weight: 700;
  }

  .incoltec-header__lang-link:hover {
    color: var(--c-dark, #1e1e1e);
    opacity: 1;
  }

  .incoltec-header__lang-sep {
    color: #ccc;
    font-size: 0.75rem;
    user-select: none;
  }

  /* CTA button — pill-shaped, Function Health style */
  .incoltec-header__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.65rem 1.6rem;
    font-family: var(--font-primary);
    font-size: 0.875rem;
    font-weight: 600;
    line-height: 1;
    color: #fff !important;
    background: linear-gradient(135deg, var(--c-magenta, #E30066) 0%, #FF1A75 100%);
    box-shadow: 0 4px 14px rgba(227, 0, 102, 0.35);
    border-radius: 0.85rem;
    text-decoration: none;
    white-space: nowrap;
    transition:
      background 0.2s ease,
      box-shadow 0.2s ease,
      transform 0.15s ease;
  }

  .incoltec-header__cta:hover {
    background: linear-gradient(135deg, #c20055 0%, #E30066 100%);
    box-shadow: 0 6px 20px rgba(227, 0, 102, 0.5);
    transform: translateY(-2px);
    opacity: 1;
  }

  .incoltec-header__link[aria-current="page"] {
    color: var(--c-magenta, #E30066);
  }

  .incoltec-header__link--horeca {
    font-weight: 700;
    letter-spacing: 0.06em;
  }

  .incoltec-header__link--contact {
    color: var(--c-magenta, #E30066) !important;
    font-weight: 600 !important;
  }

  .incoltec-header__chevron-btn {
    background: none;
    border: none;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  /* Mobile hamburger toggle */
  .incoltec-header__mobile-toggle {
    display: flex;
    align-items: center;
  }

  #astronav-menu {
    background: transparent;
    border: none;
    padding: 0.5rem;
    margin: -0.5rem;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--c-dark, #1e1e1e);
    border-radius: 0.5rem;
    transition: background-color 0.2s ease, color 0.2s ease;
    touch-manipulation: manipulation;
    min-width: 44px;
    min-height: 44px;
  }

  #astronav-menu:hover,
  #astronav-menu:focus-visible {
    background-color: rgba(0, 0, 0, 0.05);
    outline: none;
  }

  .incoltec-header__hamburger-svg {
    width: 1.75rem;
    height: 1.75rem;
    color: currentColor;
    display: block;
  }

  .incoltec-header__mobile-actions {
    display: block;
    padding: 1.5rem 0 0.5rem;
    border-top: 1px solid #f0f0f0;
    margin-top: 1rem;
  }

  .incoltec-header__mobile-lang {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  /* ---- RESPONSIVE: DESKTOP (1024+) ---- */
  @media (min-width: 1024px) {
    .incoltec-header__links-wrap,
    .incoltec-header__links-wrap.hidden,
    :global(.incoltec-header__links-wrap),
    :global(.incoltec-header__links-wrap.hidden) {
      display: flex !important;
      align-items: center;
      flex: 1;
      justify-content: center;
      position: static;
      background: transparent;
      box-shadow: none;
      border: none;
      padding: 0;
      margin: 0;
      max-height: none;
      overflow: visible;
    }

    .incoltec-header__actions {
      display: flex;
    }

    .incoltec-header__mobile-toggle {
      display: none !important;
    }

    .incoltec-header__mobile-actions {
      display: none;
    }
  }

  /* ---- RESPONSIVE: MOBILE (< 1024) ---- */
  @media (max-width: 1023px) {
    .incoltec-header__links-wrap {
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      width: 100%;
      background: rgba(255, 255, 255, 0.98);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      border-top: 1px solid rgba(0, 0, 0, 0.08);
      border-bottom: 1px solid rgba(0, 0, 0, 0.08);
      box-shadow: 0 20px 40px -10px rgba(0, 0, 0, 0.15);
      padding: 1.25rem clamp(1.25rem, 4vw, 2.5rem) 2rem;
      margin: 0;
      flex-direction: column;
      align-items: stretch;
      max-height: calc(100dvh - clamp(5.5rem, 7vw, 7rem) - 1rem);
      overflow-y: auto;
      -webkit-overflow-scrolling: touch;
      z-index: 100;
    }

    .incoltec-header__links-wrap.hidden {
      display: none !important;
    }

    .incoltec-header__links-wrap:not(.hidden) {
      display: flex !important;
    }

    .incoltec-header__links {
      flex-direction: column;
      align-items: stretch;
      gap: 0;
    }

    .incoltec-header__link-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      width: 100%;
    }

    .incoltec-header__link {
      padding: 0.875rem 0;
      font-size: 1.0625rem;
      font-weight: 500;
      width: 100%;
    }

    .incoltec-header__chevron-btn {
      min-width: 44px;
      min-height: 44px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      color: #666;
    }

    .incoltec-header__dropdown {
      position: relative;
      top: auto;
      left: auto;
      transform: none;
      padding-top: 0;
      min-width: auto;
      width: 100%;
    }

    .incoltec-header__dropdown.hidden {
      display: none !important;
    }

    .incoltec-header__dropdown:not(.hidden) {
      display: block !important;
      opacity: 1 !important;
      visibility: visible !important;
      pointer-events: auto !important;
      transform: none !important;
    }

    .incoltec-header__dropdown-panel {
      border: none;
      border-radius: 0;
      box-shadow: none;
      padding: 0.25rem 0 0.5rem 1rem;
      background: transparent;
    }

    .incoltec-header__dropdown-link {
      padding: 0.65rem 0.5rem;
      font-size: 0.95rem;
      color: #555;
    }

    .incoltec-header__dropdown-link:hover {
      color: var(--c-dark, #1e1e1e);
      background: rgba(0, 0, 0, 0.03);
    }

    .incoltec-header__actions {
      display: none !important;
    }

    .incoltec-header__mobile-actions {
      display: block;
      padding: 1.5rem 0 0.5rem;
      border-top: 1px solid rgba(0, 0, 0, 0.08);
      margin-top: 1rem;
    }

    .incoltec-header__mobile-lang {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 1rem;
    }
  }

  :global(#astronav-menu .astronav-toggle.hidden) {
    display: none !important;
  }
</style>

<script>
  // Scroll detection for header shadow
  const header = document.getElementById("site-header");
  if (header) {
    const onScroll = () => {
      header.dataset.scrolled = window.scrollY > 10 ? "true" : "false";
    };
    window.addEventListener("scroll", onScroll, { passive: true });
    onScroll();
  }

  // Close mobile nav when clicking outside header
  document.addEventListener("click", (e) => {
    const navMenuItems = document.querySelector(".incoltec-header__links-wrap");
    const menuButton = document.getElementById("astronav-menu");
    if (!navMenuItems || !menuButton) return;

    if (!navMenuItems.classList.contains("hidden")) {
      const headerEl = document.getElementById("site-header");
      if (headerEl && !headerEl.contains(e.target as Node)) {
        navMenuItems.classList.add("hidden");
        const icons = menuButton.querySelectorAll(".astronav-toggle");
        icons.forEach((el) => el.classList.toggle("hidden"));
      }
    }
  });

  // Keep aria-expanded in sync on dropdown toggle buttons (keyboard / screen readers).
  document.querySelectorAll<HTMLButtonElement>(".incoltec-header__chevron-btn").forEach((btn) => {
    btn.setAttribute("aria-expanded", "false");
    btn.addEventListener("click", () => {
      const menu = btn.closest(".astronav-dropdown")?.querySelector(".incoltec-header__dropdown");
      requestAnimationFrame(() => {
        const open = !!menu && !menu.classList.contains("hidden");
        btn.setAttribute("aria-expanded", String(open));
      });
    });
  });

  // Close mobile nav on Escape key
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") {
      const navMenuItems = document.querySelector(".incoltec-header__links-wrap");
      const menuButton = document.getElementById("astronav-menu");
      if (navMenuItems && !navMenuItems.classList.contains("hidden")) {
        navMenuItems.classList.add("hidden");
        const icons = menuButton?.querySelectorAll(".astronav-toggle");
        icons?.forEach((el) => el.classList.toggle("hidden"));
      }
    }
  });
</script>
