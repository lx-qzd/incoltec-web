---
import { Astronav, MenuItems, MenuIcon, DropdownItems } from "astro-navbar";

const { currentPath = "/" } = Astro.props;
const pathname = Astro.url.pathname;
const isEs = pathname.startsWith("/es") || Astro.currentLocale === "es";

let enPath = pathname;
let esPath = pathname;
if (isEs) {
  enPath = pathname.replace(/^\/es(\/|$)/, '$1') || '/';
  esPath = pathname;
} else {
  enPath = pathname;
  esPath = pathname === '/' ? '/es' : `/es${pathname.startsWith('/') ? pathname : `/${pathname}`}`;
}


interface Sublink {
  name: string;
  url: string;
}

interface NavLink {
  name: string;
  url: string;
  dropdown?: Sublink[];
}

const enLinks: NavLink[] = [
  {
    name: "Vibrant Life",
    url: "/#vibrant-life",
    dropdown: [
      { name: "Commitment", url: "/#compromiso" },
      { name: "Quality", url: "/#calidad" },
    ],
  },
  {
    name: "Taste Colors",
    url: "/#taste-colors",
    dropdown: [
      {
        name: "Natural Colors",
        url: "/#colorantes-naturales",
      },
      {
        name: "Coloring Foods",
        url: "/#alimentos-colorantes",
      },
      {
        name: "Vitamins & Pre Mixes",
        url: "/#vitaminas-premixes",
      },
    ],
  },
  {
    name: "Perfecting Food",
    url: "/#perfecting-food",
    dropdown: [
      { name: "Solutions", url: "/#soluciones" },
      { name: "Innovation", url: "/#innovacion" },
    ],
  },
  {
    name: "Our Company",
    url: "/#our-company",
    dropdown: [
      { name: "Organization", url: "/#organizacion" },
      { name: "Laboratory", url: "/#laboratorio" },
    ],
  },
  { name: "Catalogs", url: "/catalogs" },
  { name: "Blog", url: "/blog" },
  { name: "Contact", url: "/#contact" },
];

const esLinks: NavLink[] = [
  {
    name: "Vida Vibrante",
    url: "/es/#vibrant-life",
    dropdown: [
      { name: "Compromiso", url: "/es/#compromiso" },
      { name: "Calidad", url: "/es/#calidad" },
    ],
  },
  {
    name: "Saborea los Colores",
    url: "/es/#taste-colors",
    dropdown: [
      {
        name: "Colorantes Naturales",
        url: "/es/#colorantes-naturales",
      },
      {
        name: "Alimentos Colorantes",
        url: "/es/#alimentos-colorantes",
      },
      {
        name: "Vitaminas & Pre Mixes",
        url: "/es/#vitaminas-premixes",
      },
    ],
  },
  {
    name: "Perfeccionando Alimentos",
    url: "/es/#perfecting-food",
    dropdown: [
      { name: "Soluciones", url: "/es/#soluciones" },
      { name: "Innovación", url: "/es/#innovacion" },
    ],
  },
  {
    name: "Nuestra Empresa",
    url: "/es/#our-company",
    dropdown: [
      { name: "Organización", url: "/es/#organizacion" },
      { name: "Laboratorio", url: "/es/#laboratorio" },
    ],
  },
  { name: "Catálogos", url: "/es/catalogs" },
  { name: "Blog", url: "/es/blog" },
  { name: "Contacto", url: "/es/#contact" },
];

const links = isEs ? esLinks : enLinks;

// HORECA/INDUSTRIAL tab state
const activeTab: string = currentPath.startsWith("/horeca") ? "HORECA" : "INDUSTRIAL";
---

<header class="incoltec-header" id="site-header" data-scrolled="false">
  <div class="incoltec-header__shell">
    <nav class="incoltec-header__nav" aria-label="Primary">
      <!-- Logo -->
      <a href={isEs ? "/es" : "/"} class="incoltec-header__logo" aria-label="Incoltec Home">
        <img
          src="/assets/LogoIncoltec.png"
          alt="Incoltec"
          class="incoltec-header__logo-img"
          width="220"
          height="50"
          loading="eager"
          decoding="async"
        />
      </a>


      <!-- Desktop Navigation Links -->
      <Astronav closeOnClick>
        <div class="incoltec-header__mobile-toggle">
          <MenuIcon class="incoltec-header__hamburger-svg" />
        </div>

        <MenuItems class="incoltec-header__links-wrap">
          <ul class="incoltec-header__links">
            {
              links.map((link) => (
                <li class="incoltec-header__link-item">
                  {link.dropdown ? (
                    <div class="astronav-dropdown group relative">
                      <div class="incoltec-header__link-row flex items-center justify-between">
                        <a
                          href={link.url}
                          class="incoltec-header__link"
                        >
                          <span>{link.name}</span>
                        </a>
                        <button
                          type="button"
                          aria-label={`Toggle ${link.name} submenu`}
                          class="incoltec-header__chevron-btn p-1 text-[#666] hover:text-[#1e1e1e]"
                        >
                          <svg
                            class="incoltec-header__chevron"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                          >
                            <path
                              stroke-linecap="round"
                              stroke-linejoin="round"
                              d="M19.5 8.25l-7.5 7.5-7.5-7.5"
                            />
                          </svg>
                        </button>
                      </div>
                      <DropdownItems class="incoltec-header__dropdown">
                        <div class="incoltec-header__dropdown-panel">
                          <ul class="incoltec-header__dropdown-list">
                            {link.dropdown.map((sublink) => (
                              <li>
                                <a
                                  href={sublink.url}
                                  class="incoltec-header__dropdown-link"
                                >
                                  {sublink.name}
                                </a>
                              </li>
                            ))}
                          </ul>
                        </div>
                      </DropdownItems>
                    </div>
                  ) : (
                    <a
                      href={link.url}
                      class={`incoltec-header__link ${
                        link.url.includes("#contact") ? "incoltec-header__link--contact" : ""
                      }`}
                    >
                      {link.name}
                    </a>
                  )}
                </li>
              ))
            }
          </ul>

          <!-- Mobile-only language switcher & actions -->
          <div class="incoltec-header__mobile-actions">
            <a href={isEs ? "/es/#contact" : "/#contact"} class="incoltec-header__cta w-full text-center mb-4">
              {isEs ? "Contáctanos" : "Get in Touch"}
            </a>
            <div class="incoltec-header__mobile-lang">
              <a
                href={enPath}
                class={`incoltec-header__lang-link ${!isEs ? "is-active" : ""}`}
                >EN</a
              >
              <span class="incoltec-header__lang-sep">|</span>
              <a
                href={esPath}
                class={`incoltec-header__lang-link ${isEs ? "is-active" : ""}`}
                >ES</a
              >
            </div>
          </div>
        </MenuItems>
      </Astronav>

      <!-- Desktop Actions (right side) -->
      <div class="incoltec-header__actions">
        <div class="incoltec-header__lang-switch">
          <a
            href={enPath}
            class={`incoltec-header__lang-link ${!isEs ? "is-active" : ""}`}
            >EN</a
          >
          <span class="incoltec-header__lang-sep">|</span>
          <a
            href={esPath}
            class={`incoltec-header__lang-link ${isEs ? "is-active" : ""}`}
            >ES</a
          >
        </div>
        <a href={isEs ? "/es/#contact" : "/#contact"} class="incoltec-header__cta">
          {isEs ? "Contáctanos" : "Get in Touch"}
        </a>
      </div>
    </nav>
  </div>

  <!-- HORECA / INDUSTRIAL Switch -->
  <div class="incoltec-header__sub-bar">
    <div class="incoltec-header__sub-bar-inner">
      <a
        href="/horeca"
        class={`incoltec-header__tab ${activeTab === "HORECA" ? "is-active" : ""}`}
      >
        HORECA
      </a>
      <a
        href="/"
        class={`incoltec-header__tab ${activeTab === "INDUSTRIAL" ? "is-active" : ""}`}
      >
        INDUSTRIAL
      </a>
    </div>
  </div>
</header>

<style>
  /* ============================================================
     FUNCTION HEALTH–INSPIRED HEADER
     Clean, minimal, premium typography, generous spacing.
     ============================================================ */

  .incoltec-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(255, 255, 255, 0.97);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    transition:
      box-shadow 0.3s ease,
      background 0.3s ease;
  }

  .incoltec-header[data-scrolled="true"] {
    box-shadow: 0 1px 0 rgba(0, 0, 0, 0.06);
  }

  /* Shell: max-width container with generous side padding */
  .incoltec-header__shell {
    width: 100%;
    max-width: 1440px;
    margin: 0 auto;
    padding: 0 clamp(1.25rem, 3vw, 3rem);
  }

  /* Nav: flex layout — Logo | Links | Actions */
  .incoltec-header__nav {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: clamp(5.5rem, 7vw, 7rem);
    gap: 2rem;
  }

  /* Logo */
  .incoltec-header__logo {
    display: flex;
    align-items: center;
    flex-shrink: 0;
    text-decoration: none;
    padding: 0.75rem 0;
  }

  .incoltec-header__logo-img {
    display: block;
    height: clamp(2.1rem, 3.5vw, 3.15rem);
    width: auto;
  }

  /* Desktop links container */
  .incoltec-header__links-wrap {
    display: none;
  }

  .incoltec-header__links {
    display: flex;
    align-items: center;
    gap: clamp(0.25rem, 1.5vw, 1.75rem);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .incoltec-header__link-item {
    position: relative;
  }

  /* Individual nav link — Function Health style: light weight, underline hover */
  .incoltec-header__link {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    padding: 0.5rem 0;
    font-family: var(--font-primary);
    font-size: 0.9375rem;
    font-weight: 400;
    line-height: 1.5;
    color: var(--c-dark, #1e1e1e);
    text-decoration: none;
    white-space: nowrap;
    cursor: pointer;
    background: none;
    border: none;
    transition: color 0.15s ease;
  }

  .incoltec-header__link:hover {
    opacity: 1;
  }

  /* Chevron for dropdown */
  .incoltec-header__chevron {
    width: 0.75rem;
    height: 0.75rem;
    margin-top: 1px;
    transition: transform 0.2s ease;
    flex-shrink: 0;
  }

  .group.open .incoltec-header__chevron,
  [aria-expanded="true"] .incoltec-header__chevron {
    transform: rotate(180deg);
  }

  /* Dropdown Panel */
  .incoltec-header__dropdown {
    position: absolute;
    top: 100%;
    left: 50%;
    transform: translateX(-50%) translateY(-0.5rem);
    min-width: 14rem;
    padding-top: 0.75rem;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition:
      opacity 0.18s ease,
      transform 0.18s ease,
      visibility 0.18s ease;
    z-index: 50;
  }

  /* Dropdown interactions: hover for desktop, click for mobile */
  @media (min-width: 1024px) {
    .incoltec-header__dropdown {
      display: block !important; /* override astro-navbar's hidden class */
    }
    .astronav-dropdown:hover .incoltec-header__dropdown {
      opacity: 1;
      visibility: visible;
      pointer-events: auto;
      transform: translateX(-50%) translateY(0);
    }
    .astronav-dropdown:hover .incoltec-header__chevron {
      transform: rotate(180deg);
    }
  }
  @media (max-width: 1023px) {
    .incoltec-header__dropdown:not([hidden]),
    .incoltec-header__dropdown:not(.hidden) {
      opacity: 1;
      visibility: visible;
      pointer-events: auto;
      /* transform is overridden below for mobile */
    }
  }

  .incoltec-header__dropdown-panel {
    background: #fff;
    border: 1px solid rgba(0, 0, 0, 0.06);
    border-radius: 1rem;
    padding: 0.75rem 0;
    box-shadow:
      0 12px 40px rgba(0, 0, 0, 0.08),
      0 2px 8px rgba(0, 0, 0, 0.04);
  }

  .incoltec-header__dropdown-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .incoltec-header__dropdown-link {
    display: block;
    padding: 0.65rem 1.5rem;
    font-size: 0.9rem;
    font-weight: 400;
    color: #333;
    text-decoration: none;
    transition:
      background 0.12s ease,
      color 0.12s ease;
  }

  .incoltec-header__dropdown-link:hover {
    background: #f8f8f7;
    color: var(--c-dark, #1e1e1e);
    opacity: 1;
  }

  /* Actions area (right side) */
  .incoltec-header__actions {
    display: none;
    align-items: center;
    gap: 1.5rem;
    flex-shrink: 0;
  }

  /* Language switcher */
  .incoltec-header__lang-switch {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .incoltec-header__lang-link {
    font-size: 0.8125rem;
    font-weight: 500;
    color: #666;
    text-decoration: none;
    transition: color 0.15s ease;
    letter-spacing: 0.02em;
  }

  .incoltec-header__lang-link.is-active {
    color: var(--c-dark, #1e1e1e);
    font-weight: 700;
  }

  .incoltec-header__lang-link:hover {
    color: var(--c-dark, #1e1e1e);
    opacity: 1;
  }

  .incoltec-header__lang-sep {
    color: #ccc;
    font-size: 0.75rem;
    user-select: none;
  }

  /* CTA button — pill-shaped, Function Health style */
  .incoltec-header__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.65rem 1.6rem;
    font-family: var(--font-primary);
    font-size: 0.875rem;
    font-weight: 600;
    line-height: 1;
    color: #fff !important;
    background: linear-gradient(135deg, var(--c-magenta, #E30066) 0%, #FF1A75 100%);
    box-shadow: 0 4px 14px rgba(227, 0, 102, 0.35);
    border-radius: 0.85rem;
    text-decoration: none;
    white-space: nowrap;
    transition:
      background 0.2s ease,
      box-shadow 0.2s ease,
      transform 0.15s ease;
  }

  .incoltec-header__cta:hover {
    background: linear-gradient(135deg, #c20055 0%, #E30066 100%);
    box-shadow: 0 6px 20px rgba(227, 0, 102, 0.5);
    transform: translateY(-2px);
    opacity: 1;
  }

  .incoltec-header__link--contact {
    color: var(--c-magenta, #E30066) !important;
    font-weight: 600 !important;
  }

  .incoltec-header__chevron-btn {
    background: none;
    border: none;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  /* Mobile hamburger toggle */
  .incoltec-header__mobile-toggle {
    display: flex;
    align-items: center;
    cursor: pointer;
  }

  .incoltec-header__hamburger-svg {
    width: 1.5rem;
    height: 1.5rem;
    color: var(--c-dark, #1e1e1e);
  }

  .incoltec-header__mobile-actions {
    display: block;
    padding: 1.5rem 0 0.5rem;
    border-top: 1px solid #f0f0f0;
    margin-top: 1rem;
  }

  .incoltec-header__mobile-lang {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  /* ---- SUB-BAR: HORECA / INDUSTRIAL ---- */
  .incoltec-header__sub-bar {
    border-top: 1px solid rgba(0, 0, 0, 0.05);
    background: rgba(255, 255, 255, 0.97);
  }

  .incoltec-header__sub-bar-inner {
    max-width: 1440px;
    margin: 0 auto;
    padding: 0 clamp(1.25rem, 3vw, 3rem);
    display: flex;
    align-items: center;
    gap: 0;
  }

  .incoltec-header__tab {
    position: relative;
    padding: 0.75rem 1.75rem;
    font-family: var(--font-primary);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #666;
    background: none;
    border: none;
    border-bottom: 2px solid transparent;
    cursor: pointer;
    transition:
      color 0.2s ease,
      border-color 0.2s ease,
      background 0.2s ease;
  }

  .incoltec-header__tab:hover {
    color: #333;
    background: rgba(0, 0, 0, 0.015);
  }

  .incoltec-header__tab.is-active {
    color: var(--c-dark, #1e1e1e);
    border-bottom-color: var(--c-dark, #1e1e1e);
  }

  /* ---- RESPONSIVE: DESKTOP (1024+) ---- */
  @media (min-width: 1024px) {
    .incoltec-header__links-wrap {
      display: flex !important;
      align-items: center;
      flex: 1;
      justify-content: center;
    }

    .incoltec-header__actions {
      display: flex;
    }

    .incoltec-header__mobile-toggle {
      display: none !important;
    }

    .incoltec-header__mobile-actions {
      display: none;
    }
  }

  /* ---- RESPONSIVE: MOBILE (< 1024) ---- */
  @media (max-width: 1023px) {
    .incoltec-header__links-wrap {
      /* Controlled by astro-navbar (hidden by default) */
      flex-direction: column;
      align-items: stretch;
      padding: 1rem 0 0;
      border-top: 1px solid #f0f0f0;
      margin-top: 0.5rem;
    }

    .incoltec-header__links {
      flex-direction: column;
      align-items: stretch;
      gap: 0;
    }

    .incoltec-header__link {
      padding: 0.875rem 0;
      font-size: 1.0625rem;
      font-weight: 500;
    }

    .incoltec-header__dropdown {
      position: relative;
      top: auto;
      left: auto;
      transform: none;
      padding-top: 0;
      min-width: auto;
    }

    .incoltec-header__dropdown:not([hidden]),
    .incoltec-header__dropdown:not(.hidden) {
      transform: none;
    }

    .incoltec-header__dropdown-panel {
      border: none;
      border-radius: 0;
      box-shadow: none;
      padding: 0 0 0 1rem;
      background: transparent;
    }

    .incoltec-header__dropdown-link {
      padding: 0.6rem 0.5rem;
      font-size: 0.9375rem;
    }

    .incoltec-header__actions {
      display: none !important;
    }

    .incoltec-header__sub-bar {
      /* Hide sub-bar on mobile for cleaner look */
    }
  }
</style>

<script>
  // Scroll detection for header shadow
  const header = document.getElementById("site-header");
  if (header) {
    const onScroll = () => {
      header.dataset.scrolled = window.scrollY > 10 ? "true" : "false";
    };
    window.addEventListener("scroll", onScroll, { passive: true });
    onScroll();
  }
</script>
