---
import { Image } from "astro:assets";
import bolitas from '../assets/bolitas.webp';
import paellaFull from '../assets/paella full.webp';
import salmon from '../assets/salmon.webp';
import chefImg from '../assets/faus-arroyo.jpg';
import restImg1 from '../assets/restaurante-en-punta-cana-restaurante-en-cap-cana-restaurante-en-la-romana4.webp';
import restImg2 from '../assets/restaurante-en-punta-cana-restaurante-en-cap-cana-restaurante-en-la-romana5.webp';
import restImg3 from '../assets/restaurante-en-punta-cana-restaurante-en-cap-cana-restaurante-en-la-romana6.webp';
---

<div class="horeca-wrapper w-full bg-white">
  <!-- 1. Hero Section: Paella (First this) -->
  <section class="relative w-full h-[540px] sm:h-[640px] md:h-[720px] flex items-center justify-center overflow-hidden">
    <Image src={paellaFull} alt="HORECA Incoltec" class="absolute inset-0 w-full h-full object-cover z-0" />
    <div class="absolute inset-0 bg-black/40 z-0"></div>
    <div class="relative z-10 flex flex-col items-center justify-center p-6 text-center">
      <span class="text-white text-xs sm:text-sm md:text-base tracking-[0.3em] uppercase mb-2 md:mb-3 font-semibold text-white/90">DIVISIÓN ESPECIALIZADA</span>
      <h1 class="text-white text-5xl sm:text-7xl md:text-8xl font-extralight tracking-[0.25em] drop-shadow-xl mb-4 md:mb-6 uppercase">HORECA</h1>
      <img src="/assets/logo-incoltec-w.png" alt="Incoltec" class="w-[280px] sm:w-[440px] md:w-[620px] h-auto drop-shadow-2xl" />
      <span class="text-white text-[10px] sm:text-xs md:text-sm tracking-[0.25em] uppercase mt-3 font-semibold text-white/90">SHAPING THE FUTURE OF FOOD APPEAL</span>
    </div>
  </section>

  <!-- 2. Quote Section: Chevrons + Text (Then this text) -->
  <section class="max-w-[1300px] mx-auto py-16 md:py-24 px-6 md:px-12 bg-white">
    <div class="flex flex-col md:flex-row items-center justify-between gap-10 md:gap-16">
      
      <!-- Left: 3 Brand Chevrons -->
      <div class="flex flex-col gap-3 sm:gap-4 w-48 sm:w-60 md:w-72 shrink-0">
        <div class="horeca-chevron horeca-chevron--yellow"></div>
        <div class="horeca-chevron horeca-chevron--magenta"></div>
        <div class="horeca-chevron horeca-chevron--blue"></div>
      </div>

      <!-- Right: Main Quote & Attribution -->
      <div class="flex-1 flex flex-col justify-center text-left">
        <h2 class="text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-heading mb-6 sm:mb-8 text-[#1E1E1E] leading-[1.15]">
          "De la cocina de élite <br class="hidden sm:inline" />a tus operaciones"
        </h2>

        <div class="mt-2">
          <p class="text-xl sm:text-2xl md:text-3xl font-light text-[#1E1E1E] tracking-tight">
            <span class="font-normal">Faus Arroyo</span>
            <span class="text-base sm:text-lg md:text-xl font-normal text-gray-600 ml-2 block sm:inline mt-1 sm:mt-0">
              Aliado Estratégico de Incoltec para el sector HORECA
            </span>
          </p>
          <p class="text-gray-500 italic font-serif text-base sm:text-lg mt-1">
            Chef ejecutivo, propietario del exitoso Lolita Restaurante, Punta Cana
          </p>
        </div>
      </div>

    </div>
  </section>

  <!-- 3. Fausto Arroyo Section Apart: Dedicated section with portrait, restaurant images & text -->
  <section class="w-full bg-[#FAF8F5] py-20 md:py-28 border-y border-[#EDE8E0]">
    <div class="max-w-[1240px] mx-auto px-6 md:px-12">
      <div class="grid grid-cols-1 md:grid-cols-12 gap-12 md:gap-16 items-center">
        
        <!-- Left: Chef Image Card -->
        <div class="md:col-span-5 relative">
          <div class="relative rounded-3xl overflow-hidden shadow-2xl border-4 border-white">
            <Image src={chefImg} alt="Chef Fausto Arroyo" class="w-full h-auto object-cover object-center" />
            <div class="absolute inset-0 bg-gradient-to-t from-black/75 via-black/20 to-transparent"></div>
            <div class="absolute bottom-6 left-6 right-6 text-white">
              <span class="text-xs uppercase tracking-[0.2em] font-semibold text-[#FFC000] mb-1 block">Chef Ejecutivo & Aliado Estratégico</span>
              <h3 class="font-heading text-3xl sm:text-4xl">Fausto Arroyo</h3>
              <p class="text-sm font-light text-white/85 mt-1">Lolita Restaurante • Punta Cana, República Dominicana</p>
            </div>
          </div>
        </div>

        <!-- Right: Story, Restaurant Photos & Operational Synergy -->
        <div class="md:col-span-7 flex flex-col justify-center">
          <div class="flex items-center gap-3 mb-3">
            <div class="w-8 h-1 bg-[#E30066] rounded-full"></div>
            <span class="text-xs uppercase tracking-[0.25em] text-[#E30066] font-bold">Alianza Estratégica HORECA</span>
          </div>
          <h3 class="text-3xl md:text-4xl lg:text-5xl font-heading text-[#1E1E1E] mb-6 leading-tight">
            Alta gastronomía aplicada a la rentabilidad de su negocio
          </h3>

          <!-- 3 Restaurant Images -->
          <div class="grid grid-cols-3 gap-3 sm:gap-4 mb-8">
            <div class="overflow-hidden rounded-2xl shadow-md group border border-gray-100 bg-white">
              <Image src={restImg1} alt="Lolita Restaurante Interior" class="w-full h-32 sm:h-44 object-cover group-hover:scale-105 transition-transform duration-500" />
            </div>
            <div class="overflow-hidden rounded-2xl shadow-md group border border-gray-100 bg-white">
              <Image src={restImg2} alt="Lolita Sign Punta Cana" class="w-full h-32 sm:h-44 object-cover group-hover:scale-105 transition-transform duration-500" />
            </div>
            <div class="overflow-hidden rounded-2xl shadow-md group border border-gray-100 bg-white">
              <Image src={restImg3} alt="Elaboración Culinaria de Élite" class="w-full h-32 sm:h-44 object-cover group-hover:scale-105 transition-transform duration-500" />
            </div>
          </div>

          <p class="text-lg md:text-xl text-gray-700 leading-relaxed mb-5 font-light">
            Combinamos la <strong>"genialidad" creativa</strong> de Faus (fórmulas maestras, procesos reproducibles y sistemas de cocina de alto nivel) con el <strong>soporte técnico y logístico</strong> de Incoltec (eficiencia operativa, formulación clean label y control de costos de materia prima).
          </p>
          <p class="text-lg md:text-xl text-gray-700 leading-relaxed font-light">
            Incoltec, junto a Faus Arroyo, unen fuerzas para crear el <strong>"Sistema Operativo de Éxito"</strong> para hoteles, resorts y cadenas de restaurantes.
          </p>
        </div>

      </div>
    </div>
  </section>

  <!-- 4. Image: Science Section Banner -->
  <section class="relative w-full h-[500px] flex items-center justify-center overflow-hidden">
    <Image src={salmon} alt="La ciencia detrás del sabor" class="absolute inset-0 w-full h-full object-cover z-0" />
    <div class="absolute inset-0 bg-black/35 z-0"></div>
    <div class="relative z-10 text-center px-6">
      <h2 class="text-white text-5xl md:text-7xl lg:text-8xl font-heading drop-shadow-2xl">
        La ciencia detrás del sabor
      </h2>
      <p class="text-white/90 text-lg md:text-xl font-light mt-4 tracking-wide max-w-2xl mx-auto drop-shadow-md">
        Tecnología de formulación de élite diseñada para mantener vivacidad, estabilidad térmica y atractivo visual.
      </p>
    </div>
  </section>

  <!-- 5. Section: Kitchen Transformation Value Proposition -->
  <section class="max-w-[1240px] mx-auto py-20 md:py-28 px-6 md:px-12 bg-[#FAF8F5] my-12 rounded-3xl border border-[#EDE8E0]">
    <div class="text-center max-w-3xl mx-auto mb-16">
      <span class="text-xs uppercase tracking-[0.25em] text-[#008AD8] font-bold mb-3 block">Eficiencia & Estandarización</span>
      <h3 class="text-3xl md:text-5xl lg:text-6xl font-heading text-[#1E1E1E] mb-6">
        El Sistema Operativo de Éxito para su Cocina
      </h3>
      <p class="text-gray-600 text-lg font-light leading-relaxed">
        Soluciones integrales concebidas por chefs y científicos de alimentos para responder a los desafíos de los grandes volúmenes y la alta exigencia culinaria.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      <div class="bg-white p-8 rounded-2xl shadow-sm border border-gray-100 flex flex-col items-center text-center">
        <div class="w-14 h-14 rounded-2xl bg-[#FFC000]/15 flex items-center justify-center text-[#FFC000] mb-6">
          <svg class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
        </div>
        <h4 class="text-2xl sm:text-3xl font-heading text-[#1E1E1E] mb-3">Reducción de Mermas</h4>
        <p class="text-gray-600 text-sm sm:text-base font-light leading-relaxed">
          Estandarización de porcionamiento y optimización de rendimientos en línea caliente y preparación previa.
        </p>
      </div>

      <div class="bg-white p-8 rounded-2xl shadow-sm border border-gray-100 flex flex-col items-center text-center">
        <div class="w-14 h-14 rounded-2xl bg-[#E30066]/15 flex items-center justify-center text-[#E30066] mb-6">
          <svg class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
        </div>
        <h4 class="text-2xl sm:text-3xl font-heading text-[#1E1E1E] mb-3">Consistencia de Plato</h4>
        <p class="text-gray-600 text-sm sm:text-base font-light leading-relaxed">
          Garantía de sabor, textura y color invariable en cada servicio, sin depender del turno de cocina.
        </p>
      </div>

      <div class="bg-white p-8 rounded-2xl shadow-sm border border-gray-100 flex flex-col items-center text-center">
        <div class="w-14 h-14 rounded-2xl bg-[#008AD8]/15 flex items-center justify-center text-[#008AD8] mb-6">
          <svg class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
        </div>
        <h4 class="text-2xl sm:text-3xl font-heading text-[#1E1E1E] mb-3">Control de Rentabilidad</h4>
        <p class="text-gray-600 text-sm sm:text-base font-light leading-relaxed">
          Convierte cada receta en un activo medible, reduciendo costes ocultos y multiplicando el margen bruto.
        </p>
      </div>
    </div>
  </section>

  <!-- 6. Image: Transformation Section Banner -->
  <section class="relative w-full h-[600px] flex items-center justify-center overflow-hidden">
    <Image src={bolitas} alt="Transform your kitchen" class="absolute inset-0 w-full h-full object-cover z-0" />
    <div class="absolute inset-0 bg-black/35 z-0"></div>
    <h2 class="relative z-10 text-white text-4xl md:text-6xl lg:text-7xl font-heading leading-[1.3] drop-shadow-2xl text-center px-6 max-w-4xl">
      Transformar su cocina <br/>
      de un "centro de costos" <br/>
      a un "activo de rentabilidad".
    </h2>
  </section>
</div>

<style>
  @import url('https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;1,400;1,600&display=swap');
  
  .font-serif {
    font-family: 'Playfair Display', serif;
  }

  /* Chevrons styling matching user reference image */
  .horeca-chevron {
    height: 52px;
    width: 100%;
    clip-path: polygon(0 0, 78% 0, 100% 50%, 78% 100%, 0 100%);
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.08);
    transition: transform 0.3s ease;
  }

  .horeca-chevron:hover {
    transform: translateX(6px);
  }

  .horeca-chevron--yellow {
    background: linear-gradient(90deg, #FFB800 0%, #FFDD00 100%);
  }

  .horeca-chevron--magenta {
    background: linear-gradient(90deg, #E30066 0%, #FF2E7E 100%);
  }

  .horeca-chevron--blue {
    background: linear-gradient(90deg, #005BAB 0%, #008AD8 100%);
  }
</style>
