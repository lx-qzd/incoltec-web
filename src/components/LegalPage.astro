---
import Layout from '../layouts/Layout.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';

interface Props { title: string; description: string; heading: string; updated: string }
const { title, description, heading, updated } = Astro.props;
---

<Layout title={title} description={description}>
  <Header />
  <main id="main" class="legal bg-white">
    <div class="legal__inner">
      <h1>{heading}</h1>
      <p class="legal__updated">{updated}</p>
      <slot />
    </div>
  </main>
  <Footer />
</Layout>

<style>
  .legal { padding: clamp(3rem, 7vw, 6rem) 1rem; color: #1e293b; }
  .legal__inner { max-width: 820px; margin: 0 auto; font-family: var(--font-primary, system-ui); line-height: 1.7; }
  .legal h1 { font-family: var(--font-heading, serif); font-size: clamp(2rem, 1.6rem + 2vw, 3rem); line-height: 1.15; margin-bottom: 0.5rem; color: #0f172a; }
  .legal__updated { color: #64748b; font-size: 0.9rem; margin-bottom: 2.5rem; }
  .legal :global(h2) { font-size: clamp(1.2rem, 1.05rem + 0.6vw, 1.5rem); font-weight: 700; margin: 2.25rem 0 0.75rem; color: #0f172a; }
  .legal :global(p) { margin-bottom: 1rem; }
  .legal :global(ul) { list-style: disc; padding-left: 1.5rem; margin-bottom: 1.25rem; }
  .legal :global(li) { margin-bottom: 0.35rem; }
  .legal :global(a) { color: #b0004f; text-decoration: underline; }
  .legal :global(table) { width: 100%; border-collapse: collapse; margin: 1rem 0 1.5rem; font-size: 0.9rem; display: block; overflow-x: auto; }
  .legal :global(th), .legal :global(td) { border: 1px solid #e2e8f0; padding: 0.6rem 0.75rem; text-align: left; vertical-align: top; }
  .legal :global(th) { background: #f1f5f9; }
  .legal :global(.cc-btn) { display: inline-flex; min-height: 44px; align-items: center; padding: 0.6rem 1.25rem; border-radius: 0.6rem; background: #1e1e1e; color: #fff; font-weight: 600; text-decoration: none; cursor: pointer; }
</style>
