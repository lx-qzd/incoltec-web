 ---
import { getImage } from "astro:assets";
import BrandEIcon from "./BrandEIcon.astro";

interface Point {
  title: string;
  text: string;
}

interface Props {
  id?: string;
  title?: string;
  naturalTitle?: string;
  artificialTitle?: string;
  naturalPoints?: Point[];
  artificialPoints?: Point[];
  bgImage?: string;
}

const { 
  id = "color-comparison",
  title = "Taste Colors",
  naturalTitle = "Natural Colors",
  artificialTitle = "Artificial Colors",
  naturalPoints = [
    { title: "CLEAN LABEL", text: "Clean label appeal for health-conscious consumers" },
    { title: "100% NATURAL", text: "Derived from natural sources (plants, minerals)" },
    { title: "NUTRITIOUS", text: "No negative impact on nutritional value" },
    { title: "COMPLIANT", text: "Increasingly demanded by global food regulators" }
  ],
  artificialPoints = [
    { title: "HEALTH RISKS", text: "Often linked to health concerns and allergies" },
    { title: "SYNTHETIC", text: "Synthetic chemicals and petroleum-based" },
    { title: "WARNING LABELS", text: "Requires strict warning labels in many regions" },
    { title: "DISTRUST", text: "Decreasing consumer trust and market share" }
  ],
  bgImage = "/assets/food-colors-application.webp"
} = Astro.props;

const bgUrl = typeof bgImage === 'string' ? bgImage : (await getImage({ src: bgImage, format: 'webp', width: 1200 })).src;
---

<section id={id} class="w-full flex flex-col md:flex-row bg-[#FFFDF9] min-h-[100dvh] scroll-mt-24 overflow-hidden">
  <!-- Left Side: Content & Comparison with Container Query Context -->
  <div class="w-full md:w-1/2 flex items-center justify-center p-6 sm:p-10 md:p-12 lg:p-16 order-2 md:order-1 @container">
    <div class="max-w-2xl text-center flex flex-col items-center w-full">
      <div class="reveal-up delay-75 w-full flex flex-col items-center">
        <div class="inline-flex items-center gap-2.5 mb-4">
          <BrandEIcon class="w-4 h-5 shrink-0" />
          <span class="font-verdana text-xs uppercase tracking-[0.25em] text-[#008AD8] font-bold">
            Comparison Analysis
          </span>
        </div>
        <h2 class="font-heading text-[#89385C] fluid-h1 font-normal mb-6 leading-tight">
          {title}
        </h2>

        <div class="w-24 h-[2px] bg-[#C6ACB8] mx-auto mb-8 sm:mb-12"></div>
      </div>
      
      <!-- Content comparison cards with container-isolated micro-interactions -->
      <div class="w-full text-left space-y-6 sm:space-y-8 mt-2 relative">
        
        <!-- Natural Colors Card (Glassmorphism Frosted Clean) -->
        <div class="glass-card-light bg-white/95 backdrop-blur-xl p-6 sm:p-8 md:p-10 border border-emerald-600/20 rounded-2xl shadow-[0_16px_36px_-10px_rgba(16,185,129,0.08)] relative z-10 reveal-left delay-100 hover:border-emerald-600/35 transition-colors @container/card">
          <div class="flex items-center justify-between mb-6 pb-4 border-b border-emerald-600/10">
            <h3 class="fluid-h3 font-heading text-[#89385C] font-normal m-0">{naturalTitle}</h3>
            <span class="px-3.5 py-1 rounded-xl text-xs font-semibold uppercase tracking-wider bg-emerald-50 text-emerald-700 border border-emerald-200 font-verdana">
              Clean Label
            </span>
          </div>
          
          <div class="grid grid-cols-1 @[420px]/card:grid-cols-2 gap-x-6 gap-y-6">
            {naturalPoints.map(point => (
              <div class="flex flex-col gap-2">
                <div class="flex items-center gap-2.5">
                  <div class="w-5 h-5 sm:w-6 sm:h-6 shrink-0 text-emerald-600">
                    <svg class="w-full h-full" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                    </svg>
                  </div>
                  <h4 class="font-verdana font-bold text-[#89385C] uppercase tracking-wider text-xs sm:text-sm leading-none m-0">{point.title}</h4>
                </div>
                <p class="font-verdana text-gray-600 text-xs sm:text-sm font-light leading-relaxed pl-8">
                  {point.text}
                </p>
              </div>
            ))}
          </div>
        </div>

        <!-- VS Divider (Classic Pill Badge) -->
        <div class="flex justify-center -my-4 sm:-my-6 relative z-20">
          <div class="bg-[#89385C] border-4 border-[#FFFDF9] px-6 py-2.5 rounded-full text-sm font-bold text-white shadow-xl tracking-widest font-verdana select-none">
            VS
          </div>
        </div>

        <!-- Artificial Colors Card -->
        <div class="glass-card-light bg-[#FAF8F6]/90 backdrop-blur-xl p-6 sm:p-8 md:p-10 border border-red-500/15 rounded-2xl relative z-10 reveal-right delay-300 @container/card">
          <div class="flex items-center justify-between mb-6 pb-4 border-b border-red-500/10">
            <h3 class="fluid-h3 font-heading text-gray-700 font-normal m-0">{artificialTitle}</h3>
            <span class="px-3.5 py-1 rounded-xl text-xs font-semibold uppercase tracking-wider bg-red-50 text-red-700 border border-red-200 font-verdana">
              Synthetic
            </span>
          </div>
          
          <div class="grid grid-cols-1 @[420px]/card:grid-cols-2 gap-x-6 gap-y-6">
            {artificialPoints.map(point => (
              <div class="flex flex-col gap-2">
                <div class="flex items-center gap-2.5">
                  <div class="w-5 h-5 sm:w-6 sm:h-6 shrink-0 text-red-500/80">
                    <svg class="w-full h-full" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                    </svg>
                  </div>
                  <h4 class="font-verdana font-bold text-gray-700 uppercase tracking-wider text-xs sm:text-sm leading-none m-0">{point.title}</h4>
                </div>
                <p class="font-verdana text-gray-500 text-xs sm:text-sm font-light leading-relaxed pl-8">
                  {point.text}
                </p>
              </div>
            ))}
          </div>
        </div>
        
      </div>
    </div>
  </div>

  <!-- Right Side: Optimized Visual Image with Viewport Height Safety -->
  <div class="w-full md:w-1/2 min-h-[380px] md:min-h-[100dvh] order-1 md:order-2 relative overflow-hidden reveal delay-200">
    <img 
      src={bgUrl} 
      alt={title} 
      sizes="(min-width: 768px) 50vw, 100vw"
      class="absolute inset-0 w-full h-full object-cover object-center transform hover:scale-105 transition-transform duration-[10s] ease-out" 
      loading="lazy"
      decoding="async"
      width="1200"
      height="1200"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-black/40 via-transparent to-black/20 pointer-events-none md:bg-gradient-to-r md:from-black/20 md:via-transparent md:to-black/30"></div>
  </div>
</section>

