---

<div class="organigram-wrapper w-full @container">
  <!-- Section Subtitle & Brand Tag -->
  <div class="mb-8 sm:mb-10 reveal delay-100">
    <div>
      <span class="font-verdana text-xs uppercase tracking-[0.25em] text-[#008AD8] font-bold block mb-1">
        {isEs ? "Estructura Corporativa Oficial" : "Official Corporate Structure"}
      </span>
      <h3 class="fluid-h2 font-heading text-[#1E1E1E] font-normal m-0">
        {isEs ? "Organigrama de Incoltec" : "Incoltec Organization Chart"}
      </h3>
    </div>
  </div>

  <p class="font-verdana text-gray-600 text-sm sm:text-base font-light leading-relaxed mb-12 max-w-3xl">
    {isEs
      ? "Nuestro equipo multidisciplinar conecta la dirección estratégica, la investigación avanzada en laboratorio y la presencia comercial en los cinco continentes con cercanía humana y excelencia técnica."
      : "Our multidisciplinary team connects executive leadership, advanced laboratory formulation, and worldwide sales representation with personal proximity and technical excellence."}
  </p>

  <!-- 1. Executive Management (CEO) Node -->
  <div class="mb-14 reveal-up delay-100 flex flex-col items-center">
    <div class="inline-flex items-center gap-2 mb-3 px-3 py-1 bg-[#89385C]/10 text-[#89385C] rounded-lg text-xs font-semibold uppercase tracking-wider font-verdana">
      <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
      </svg>
      {isEs ? "Dirección General" : "Executive Management"}
    </div>
    
    <div class="w-full max-w-md bg-white rounded-2xl p-6 sm:p-8 border-2 border-[#89385C]/20 shadow-lg hover:shadow-xl hover:-translate-y-1 transition-all duration-300 text-center relative overflow-hidden group">
      <div class="absolute top-0 left-0 right-0 h-1.5 bg-[#89385C]"></div>
      
      <div class="relative w-20 h-20 sm:w-24 sm:h-24 mx-auto mb-4">
        {management[0].photo ? (
          <img 
            src={management[0].photo} 
            alt={management[0].name} 
            class="w-full h-full rounded-2xl object-cover border-2 border-[#89385C]/30 shadow-md group-hover:scale-105 transition-transform"
            loading="lazy"
          />
        ) : (
          <div class="w-full h-full rounded-2xl bg-gradient-to-tr from-[#89385C] to-[#E30066] text-white flex items-center justify-center shadow-md font-heading text-2xl font-bold">
            VA
          </div>
        )}
      </div>

      <h4 class="font-heading text-2xl sm:text-3xl text-[#1E1E1E] font-normal mb-1">
        {management[0].name}
      </h4>
      <p class="font-verdana text-xs sm:text-sm font-semibold text-[#89385C] uppercase tracking-wider mb-5">
        {isEs ? management[0].roleEs : management[0].roleEn}
      </p>

      <div class="flex flex-col sm:flex-row items-center justify-center gap-3 pt-4 border-t border-gray-100 font-verdana text-xs">
        <a href={`tel:${management[0].cleanPhone}`} class="inline-flex items-center gap-1.5 text-gray-600 hover:text-[#89385C] transition-colors py-1 px-2.5 rounded-lg hover:bg-gray-50">
          <svg class="w-3.5 h-3.5 text-[#008AD8]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
          </svg>
          {management[0].phone}
        </a>
        <a href={`mailto:${management[0].email}`} class="inline-flex items-center gap-1.5 text-gray-600 hover:text-[#89385C] transition-colors py-1 px-2.5 rounded-lg hover:bg-gray-50">
          <svg class="w-3.5 h-3.5 text-[#E30066]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
          </svg>
          {management[0].email}
        </a>
      </div>
    </div>

    <!-- Vertical Connector Line -->
    <div class="w-0.5 h-10 bg-gradient-to-b from-[#89385C] to-gray-300"></div>
  </div>

  <!-- 2. Dual Departments Grid: R&D / Laboratory AND Operations & Marketing -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-14 reveal-up delay-150">
    
    <!-- Laboratory, R&D & QC -->
    <div class="bg-[#FAF8F5] rounded-2xl p-6 sm:p-8 border border-[#EDE8E0] shadow-sm flex flex-col justify-between">
      <div>
        <div class="flex items-center gap-2.5 mb-5 pb-3 border-b border-gray-200">
          <div class="w-8 h-8 rounded-lg bg-[#008AD8]/15 text-[#008AD8] flex items-center justify-center">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z" />
            </svg>
          </div>
          <h4 class="font-heading text-2xl text-[#1E1E1E] font-normal m-0">
            {isEs ? "Laboratorio, I+D y Control de Calidad" : "Laboratory, R&D and QC"}
          </h4>
        </div>

        <div class="space-y-4">
          {labAndQuality.map(m => (
            <div class="bg-white p-4 rounded-xl border border-gray-100 shadow-xs hover:border-[#008AD8]/40 transition-colors flex items-center gap-4">
              {m.photo ? (
                <img src={m.photo} alt={m.name} class="w-14 h-14 rounded-xl object-cover shrink-0 border border-gray-100 shadow-xs" loading="lazy" />
              ) : (
                <div class="w-14 h-14 rounded-xl bg-[#008AD8]/15 text-[#008AD8] flex items-center justify-center font-bold text-sm shrink-0">
                  {m.initials || m.name.slice(0, 2)}
                </div>
              )}
              <div class="flex-1 min-w-0">
                <h5 class="font-bold text-base text-[#1E1E1E] font-verdana m-0 truncate">{m.name}</h5>
                <p class="font-verdana text-xs font-semibold text-[#008AD8] uppercase tracking-wider mt-0.5 mb-2 truncate">
                  {isEs ? m.roleEs : m.roleEn}
                </p>
                <div class="flex flex-wrap items-center gap-3 font-verdana text-xs text-gray-500">
                  <a href={`tel:${m.cleanPhone}`} class="inline-flex items-center gap-1 hover:text-[#008AD8] transition-colors">
                    <svg class="w-3.5 h-3.5 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                    </svg>
                    <span>{m.phone}</span>
                  </a>
                  <a href={`mailto:${m.email}`} class="inline-flex items-center gap-1 hover:text-[#008AD8] transition-colors truncate">
                    <svg class="w-3.5 h-3.5 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                    </svg>
                    <span class="truncate">{m.email}</span>
                  </a>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>

    <!-- Operations & Marketing -->
    <div class="bg-[#FAF8F5] rounded-2xl p-6 sm:p-8 border border-[#EDE8E0] shadow-sm flex flex-col justify-between">
      <div>
        <div class="flex items-center gap-2.5 mb-5 pb-3 border-b border-gray-200">
          <div class="w-8 h-8 rounded-lg bg-[#E30066]/15 text-[#E30066] flex items-center justify-center">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5.882V19.24a1.76 1.76 0 01-3.417.592l-2.147-6.15M18 13a3 3 0 100-6M5.436 13.683A4.001 4.001 0 017 6h1.832c4.1 0 7.625-1.234 9.168-3v14c-1.543-1.766-5.067-3-9.168-3H7a3.988 3.988 0 01-1.564-.317z" />
            </svg>
          </div>
          <h4 class="font-heading text-2xl text-[#1E1E1E] font-normal m-0">
            {isEs ? "Operaciones y Marketing" : "Operations & Marketing"}
          </h4>
        </div>

        <div class="space-y-4">
          {operationsAndMarketing.map(m => (
            <div class="bg-white p-4 rounded-xl border border-gray-100 shadow-xs hover:border-[#E30066]/40 transition-colors flex items-center gap-4">
              {m.photo ? (
                <img src={m.photo} alt={m.name} class="w-14 h-14 rounded-xl object-cover shrink-0 border border-gray-100 shadow-xs" loading="lazy" />
              ) : (
                <div class="w-14 h-14 rounded-xl bg-[#E30066]/15 text-[#E30066] flex items-center justify-center font-bold text-sm shrink-0">
                  {m.initials || m.name.slice(0, 2)}
                </div>
              )}
              <div class="flex-1 min-w-0">
                <h5 class="font-bold text-base text-[#1E1E1E] font-verdana m-0 truncate">{m.name}</h5>
                <p class="font-verdana text-xs font-semibold text-[#E30066] uppercase tracking-wider mt-0.5 mb-2 truncate">
                  {isEs ? m.roleEs : m.roleEn}
                </p>
                <div class="flex flex-wrap items-center gap-3 font-verdana text-xs text-gray-500">
                  <a href={`tel:${m.cleanPhone}`} class="inline-flex items-center gap-1 hover:text-[#E30066] transition-colors">
                    <svg class="w-3.5 h-3.5 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                    </svg>
                    <span>{m.phone}</span>
                  </a>
                  <a href={`mailto:${m.email}`} class="inline-flex items-center gap-1 hover:text-[#E30066] transition-colors truncate">
                    <svg class="w-3.5 h-3.5 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                    </svg>
                    <span class="truncate">{m.email}</span>
                  </a>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>

  </div>

  <!-- 3. Sales Network (Worldwide Presence) -->
  <div class="mb-14 reveal-up delay-200 bg-white rounded-2xl p-6 sm:p-10 border border-gray-100 shadow-sm">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between pb-6 mb-8 border-b border-gray-100 gap-4">
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-xl bg-[#FFC000]/20 text-[#b58900] flex items-center justify-center font-bold">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.055 11H5a2 2 0 012-2h3.28a1 1 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
        </div>
        <div>
          <h4 class="font-heading text-2xl sm:text-3xl text-[#1E1E1E] font-normal m-0">
            {isEs ? "Dirección y Red Comercial Internacional" : "International Sales Team"}
          </h4>
          <span class="font-verdana text-xs text-gray-500 font-light">
            {isEs ? "Cobertura directa en España, Europa, LATAM y Caribe" : "Direct coverage in Spain, Europe, LATAM, and the Caribbean"}
          </span>
        </div>
      </div>

      <span class="inline-flex items-center gap-1.5 px-3.5 py-1.5 bg-[#FFC000]/15 text-[#b58900] rounded-xl text-xs font-semibold font-verdana self-start sm:self-auto">
        7 {isEs ? "Delegaciones Comerciales" : "Commercial Hubs"}
      </span>
    </div>

    <!-- Grid of 7 Sales Managers -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4 sm:gap-6">
      {sales.map(m => (
        <div class="bg-[#FAF8F5] p-5 rounded-xl border border-gray-100 hover:border-[#b58900]/40 hover:bg-white hover:shadow-md transition-all duration-200 flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between gap-2 mb-3">
              <span class="text-[11px] font-bold uppercase tracking-wider text-gray-400 font-verdana flex items-center gap-1">
                <svg class="w-3 h-3 text-[#b58900]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                </svg>
                {m.location}
              </span>
            </div>
            
            <div class="flex items-center gap-3.5 mb-4">
              {m.photo ? (
                <img src={m.photo} alt={m.name} class="w-13 h-13 rounded-xl object-cover shrink-0 border border-gray-100 shadow-xs" loading="lazy" />
              ) : (
                <div class="w-13 h-13 rounded-xl bg-[#FFC000]/20 text-[#b58900] flex items-center justify-center font-bold text-xs shrink-0">
                  {m.initials || m.name.slice(0, 2)}
                </div>
              )}
              <div class="min-w-0">
                <h5 class="font-bold text-base text-[#1E1E1E] font-verdana m-0 truncate">{m.name}</h5>
                <p class="font-verdana text-xs text-gray-600 font-normal leading-tight mt-0.5 m-0 line-clamp-2">
                  {isEs ? m.roleEs : m.roleEn}
                </p>
              </div>
            </div>
          </div>

          <div class="pt-3 border-t border-gray-200/60 font-verdana text-xs space-y-1.5">
            <a href={`tel:${m.cleanPhone}`} class="flex items-center gap-2 text-gray-600 hover:text-[#89385C] transition-colors truncate">
              <svg class="w-3.5 h-3.5 text-[#008AD8] shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
              </svg>
              <span class="truncate">{m.phone}</span>
            </a>
            <a href={`mailto:${m.email}`} class="flex items-center gap-2 text-gray-600 hover:text-[#89385C] transition-colors truncate">
              <svg class="w-3.5 h-3.5 text-[#E30066] shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
              <span class="truncate">{m.email}</span>
            </a>
          </div>
        </div>
      ))}
    </div>
  </div>

  <!-- 4. Administration, Finance & CSAT Grid -->
  <div class="reveal-up delay-250 bg-[#FAF8F5] rounded-2xl p-6 sm:p-8 border border-[#EDE8E0]">
    <div class="flex items-center gap-2.5 mb-6 pb-3 border-b border-gray-200">
      <div class="w-8 h-8 rounded-lg bg-[#89385C]/15 text-[#89385C] flex items-center justify-center font-bold">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
        </svg>
      </div>
      <div>
        <h4 class="font-heading text-2xl text-[#1E1E1E] font-normal m-0">
          {isEs ? "Administración, Finanzas y Atención al Cliente" : "Finance, Documentation & Customer Care"}
        </h4>
        <span class="font-verdana text-xs text-gray-500 font-light">
          {isEs ? "Soporte documental, normativo y satisfacción del cliente (CSAT)" : "Regulatory documentation, IT infrastructure, and CSAT"}
        </span>
      </div>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
      {financeAndSupport.map(m => (
        <div class="bg-white p-4 rounded-xl border border-gray-100 shadow-xs flex items-center gap-4 hover:border-[#89385C]/30 transition-colors">
          {m.photo ? (
            <img src={m.photo} alt={m.name} class="w-13 h-13 rounded-xl object-cover shrink-0 border border-gray-100 shadow-xs" loading="lazy" />
          ) : (
            <div class="w-13 h-13 rounded-xl bg-[#89385C]/15 text-[#89385C] flex items-center justify-center font-bold text-xs shrink-0">
              {m.initials || m.name.slice(0, 2)}
            </div>
          )}
          <div class="flex-1 min-w-0">
            <h5 class="font-bold text-sm text-[#1E1E1E] font-verdana m-0 truncate">{m.name}</h5>
            <p class="font-verdana text-xs font-semibold text-[#89385C] uppercase tracking-wider mt-0.5 mb-1.5 truncate">
              {isEs ? m.roleEs : m.roleEn}
            </p>
            <div class="font-verdana text-xs flex flex-col gap-1 text-gray-500">
              <a href={`tel:${m.cleanPhone}`} class="inline-flex items-center gap-1.5 hover:text-[#89385C] truncate">
                <svg class="w-3 h-3 text-gray-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                </svg>
                <span class="truncate">{m.phone}</span>
              </a>
              <a href={`mailto:${m.email}`} class="inline-flex items-center gap-1.5 hover:text-[#89385C] truncate">
                <svg class="w-3 h-3 text-gray-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                </svg>
                <span class="truncate">{m.email}</span>
              </a>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</div>

