---
import { Image } from "astro:assets";
import Certifications from "./Certifications.astro";

const currentYear = new Date().getFullYear();
const urlPath = Astro.url.pathname;
const isEs = urlPath.startsWith('/es');

const enLinks = {
  company: {
    title: "Company",
    links: [
      { name: "Our Company", url: "/#our-company" },
      { name: "Vibrant Life", url: "/#vibrant-life" },
      { name: "Taste Colors", url: "/#taste-colors" },
      { name: "Perfecting Food", url: "/#perfecting-food" }
    ]
  },
  resources: {
    title: "Resources",
    links: [
      { name: "Products", url: "/products" },
      { name: "Catalogs", url: "/catalogs" },
      { name: "Get in Touch", url: "/#contact" }
    ]
  },
  legal: {
    title: "Legal",
    links: [
      { name: "Legal Notice", url: "/legal-notice" },
      { name: "Privacy Policy", url: "/privacy-policy" },
      { name: "Cookie Policy", url: "/cookie-policy" }
    ]
  },
  slogan: "Shaping the future of food appeal"
};

const esLinks = {
  company: {
    title: "Empresa",
    links: [
      { name: "Nuestra Empresa", url: "/es/#our-company" },
      { name: "Vida Vibrante", url: "/es/#vibrant-life" },
      { name: "Saborea los Colores", url: "/es/#taste-colors" },
      { name: "Perfeccionando Alimentos", url: "/es/#perfecting-food" }
    ]
  },
  resources: {
    title: "Recursos",
    links: [
      { name: "Productos", url: "/es/products" },
      { name: "Catálogos", url: "/es/catalogs" },
      { name: "Contacto", url: "/es/#contact" }
    ]
  },
  legal: {
    title: "Legal",
    links: [
      { name: "Aviso Legal", url: "/es/legal-notice" },
      { name: "Política de Privacidad", url: "/es/privacy-policy" },
      { name: "Política de Cookies", url: "/es/cookie-policy" }
    ]
  },
  slogan: "Dando forma al futuro del atractivo alimentario"
};

const content = isEs ? esLinks : enLinks;
---

<footer class="footer">
  <div class="container footer-content">
    <div class="footer-logo">
      <Image src="/assets/logo-incoltec-footer.png" alt="Incoltec Logo" width={600} height={200} class="h-[75px] w-auto object-contain" />
    </div>
    
    <div class="footer-links">
      <div class="link-group">
        <h3>{content.company.title}</h3>
        {content.company.links.map(link => (
          <a href={link.url}>{link.name}</a>
        ))}
      </div>
      <div class="link-group">
        <h3>{content.resources.title}</h3>
        {content.resources.links.map(link => (
          <a href={link.url}>{link.name}</a>
        ))}
      </div>
      <div class="link-group">
        <h3>{content.legal.title}</h3>
        {content.legal.links.map(link => (
          <a href={link.url}>{link.name}</a>
        ))}
      </div>
      <div class="link-group newsletter-group">
        <h3>{isEs ? 'Boletín' : 'Newsletter'}</h3>
        <p class="newsletter-desc">{isEs ? 'Suscríbete para recibir nuestras últimas noticias.' : 'Subscribe to receive our latest news.'}</p>
        <form class="newsletter-form" action="#" method="POST" onsubmit="event.preventDefault();">
          <input type="email" placeholder={isEs ? 'Tu correo' : 'Your email'} required />
          <button type="submit">{isEs ? 'Suscribirse' : 'Subscribe'}</button>
        </form>
      </div>
    </div>
  </div>
  
  <Certifications variant="dark" title={isEs ? "Calidad y Seguridad Certificada" : "Certified Quality & Safety"} />
  
  <div class="footer-bottom container">
    <div class="footer-bottom-inner">
      <p class="footer-copyright">&copy; {currentYear} Incoltec. All rights reserved.</p>
      <div class="footer-footnote-links">
        {content.legal.links.map((link, idx) => (
          <span class="footnote-item">
            <a href={link.url} class="footnote-link">{link.name}</a>
            {idx < content.legal.links.length - 1 && <span class="footnote-sep">|</span>}
          </span>
        ))}
      </div>
    </div>
  </div>
</footer>

<style>
  .footer {
    background-color: var(--c-dark);
    padding: clamp(2.5rem, 5vw, 4rem) 0 clamp(1rem, 2vw, 1.5rem);
    border-top: 1px solid rgba(255, 255, 255, 0.1);
  }

  .footer-content {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: clamp(1.5rem, 3vw, 2.5rem);
    margin-bottom: 2.5rem;
    container-type: inline-size;
  }

  .footer-logo img {
    height: clamp(48px, 6vw, 75px);
    width: auto;
    margin-bottom: 0.75rem;
  }

  /* Intrinsic Breakpoint-Free Footer Link Columns */
  .footer-links {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 180px), 1fr));
    gap: clamp(1.5rem, 2.5vw, 2.5rem);
    width: 100%;
  }

  .newsletter-desc {
    font-size: 0.85rem;
    color: var(--c-light);
    opacity: 0.8;
    margin-bottom: 1rem;
    line-height: 1.4;
  }

  .newsletter-form {
    display: flex;
    width: 100%;
  }

  .newsletter-form input {
    width: 100%;
    padding: 0.6rem 0.8rem;
    font-size: 0.85rem;
    border: none;
    border-radius: 4px 0 0 4px;
    outline: none;
    color: #333;
  }

  .newsletter-form button {
    background: var(--c-magenta);
    color: white;
    border: none;
    padding: 0 1rem;
    font-size: 0.85rem;
    font-weight: 600;
    border-radius: 0 4px 4px 0;
    cursor: pointer;
    transition: background 0.3s;
  }

  .newsletter-form button:hover {
    background: #c20055;
  }

  .link-group h3 {
    font-family: var(--font-sans);
    font-size: 0.85rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin-bottom: 1.25rem;
    color: var(--c-white);
  }

  .link-group a {
    display: block;
    color: var(--c-light);
    opacity: 0.7;
    margin-bottom: 0.7rem;
    font-size: 0.85rem;
  }

  .link-group a:hover {
    opacity: 1;
    color: var(--c-yellow);
  }

  .footer-bottom {
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    padding-top: 1.5rem;
    font-size: 0.8rem;
  }

  .footer-bottom-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .footer-copyright {
    opacity: 0.6;
    margin-bottom: 0;
  }

  .footer-footnote-links {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  .footnote-item {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
  }

  .footnote-link {
    color: var(--c-light);
    opacity: 0.65;
    font-size: 0.8rem;
    text-decoration: none;
    transition: opacity 0.2s ease, color 0.2s ease;
  }

  .footnote-link:hover {
    opacity: 1;
    color: var(--c-yellow);
    text-decoration: underline;
  }

  .footnote-sep {
    color: rgba(255, 255, 255, 0.25);
    font-size: 0.75rem;
  }
</style>
