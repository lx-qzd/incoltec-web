---
import ColorComparison from './ColorComparison.astro';

interface Props {
  isEs?: boolean;
}

const { isEs = false } = Astro.props;
---

<section id="taste-colors" class="w-full bg-[#FFFDF9] pt-16 sm:pt-24 md:pt-32 pb-12 sm:pb-16 md:pb-24 scroll-mt-20 overflow-hidden @container">
  <div class="w-full max-w-[1240px] mx-auto px-4 sm:px-8 md:px-12 flex flex-col items-stretch">
    
    <!-- Header with Scroll Reveal -->
    <div class="text-center max-w-3xl mx-auto mb-16 md:mb-24 reveal delay-75 flex flex-col items-center">
      <div class="mb-4">
        <span class="font-verdana text-xs uppercase tracking-[0.25em] text-[#008AD8] font-bold">
          {isEs ? "Gama de Colores e Ingredientes" : "Colors and Ingredient Portfolio"}
        </span>
      </div>

      <h2 class="font-heading fluid-h1 text-[#89385C] font-normal mb-6 leading-tight flowy-text">
        {isEs ? "Saborea los Colores" : "Taste Colors"}
      </h2>

      <div class="w-24 h-[2px] bg-[#C6ACB8] mx-auto mb-8"></div>
      <p class="font-verdana fluid-body text-gray-700 font-light leading-relaxed max-w-2xl mx-auto">
        {isEs
          ? "Naturaleza como inspiración. Las soluciones de INCOLTEC combinan elementos orgánicos con tecnología avanzada para crear una experiencia visual incomparable que despierta emociones y realza el atractivo de los alimentos."
          : "Nature as inspiration. INCOLTEC solutions combine organic botanicals with advanced processing technology to create an unparalleled visual experience that evokes emotion and elevates food appeal."}
      </p>
    </div>

    <!-- 3 Category Cards: Intrinsic Breakpoint-Free Auto-Fit Grid with Staggered Scroll Reveal -->
    <div class="grid gap-6 sm:gap-8 mb-16 md:mb-28 @container" style="grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr));">
      
      <!-- Sub-anchor: Colorantes Naturales -->
      <div id="colorantes-naturales" class="scroll-mt-28 bg-white p-6 sm:p-8 rounded-2xl shadow-sm border border-gray-100/90 flex flex-col justify-between hover:shadow-xl hover:-translate-y-2 transition-all duration-300 reveal delay-100 group">
        <div>
          <!-- Visual Image Preview -->
          <div class="grid grid-cols-3 gap-2 mb-6 rounded-xl overflow-hidden bg-gray-50 p-1 border border-gray-100">
            <img src="/assets/products/natural-colourants/colorante_natural_e100_1-1.webp" alt="Curcumina E-100" class="w-full aspect-square object-cover rounded-lg group-hover:scale-105 transition-transform duration-300" loading="lazy" />
            <img src="/assets/products/natural-colourants/glass-jar-of-strawberry-milkshake-and-ingredients-2023-11-27-05-14-29-utc-300x300.webp" alt="Carmín E-120" class="w-full aspect-square object-cover rounded-lg group-hover:scale-105 transition-transform duration-300 delay-75" loading="lazy" />
            <img src="/assets/products/natural-colourants/concept-of-delicious-food-ice-cream-isolated-on-2023-11-27-05-28-44-utc-300x300.webp" alt="Clorofilina E-141" class="w-full aspect-square object-cover rounded-lg group-hover:scale-105 transition-transform duration-300 delay-150" loading="lazy" />
          </div>

          <div class="flex items-center gap-3 mb-4">
            <div class="w-10 h-10 rounded-xl bg-[#FFC000]/15 text-[#b58900] flex items-center justify-center font-bold shrink-0">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01"/></svg>
            </div>
            <h3 class="fluid-h3 font-heading text-[#1E1E1E] font-normal m-0">
              {isEs ? "Colorantes Naturales" : "Natural Colors"}
            </h3>
          </div>

          <p class="font-verdana text-gray-600 text-xs sm:text-sm font-light leading-relaxed mb-6">
            {isEs
              ? "Extractos concentrados y estandarizados derivados directamente de fuentes botánicas y minerales: E-100 Curcumina, E-120 Carmín, E-141 Cu-Clorofilina, E-160b Bixina/Norina y Antocianinas."
              : "Concentrated, standardized extracts derived directly from botanical and mineral sources: E-100 Curcumin, E-120 Carmine, E-141 Cu-Chlorophyllin, E-160b Annatto, and Anthocyanins."}
          </p>
        </div>
        <div class="pt-5 border-t border-gray-100 flex items-center justify-between text-xs font-semibold text-[#b58900] uppercase tracking-wider font-verdana">
          <span>{isEs ? "Alta Concentración" : "High Concentration"}</span>
          <a href={isEs ? "/es/products?category=Colorantes+Naturales" : "/products?category=Colorantes+Naturales"} class="hover:underline flex items-center gap-1 text-[#89385C]">
            <span>{isEs ? "Ver gama" : "Explore"}</span>
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
          </a>
        </div>
      </div>

      <!-- Sub-anchor: Alimentos Colorantes -->
      <div id="alimentos-colorantes" class="scroll-mt-28 bg-white p-6 sm:p-8 rounded-2xl shadow-sm border border-gray-100/90 flex flex-col justify-between hover:shadow-xl hover:-translate-y-2 transition-all duration-300 reveal delay-200 group">
        <div>
          <!-- Visual Image Preview -->
          <div class="grid grid-cols-3 gap-2 mb-6 rounded-xl overflow-hidden bg-gray-50 p-1 border border-gray-100">
            <img src="/assets/products/colouring-foods/cupcake-2023-11-27-04-55-03-utc-300x300.webp" alt="Espirulina Azul" class="w-full aspect-square object-cover rounded-lg group-hover:scale-105 transition-transform duration-300" loading="lazy" />
            <img src="/assets/products/colouring-foods/Alimento_colorante_AZAFRAN-1.webp" alt="Azafrán" class="w-full aspect-square object-cover rounded-lg group-hover:scale-105 transition-transform duration-300 delay-75" loading="lazy" />
            <img src="/assets/products/colouring-foods/Alimento_colorante_Zanahoria-negra-1-600x600.webp" alt="Zanahoria Negra" class="w-full aspect-square object-cover rounded-lg group-hover:scale-105 transition-transform duration-300 delay-150" loading="lazy" />
          </div>

          <div class="flex items-center gap-3 mb-4">
            <div class="w-10 h-10 rounded-xl bg-[#E30066]/10 text-[#E30066] flex items-center justify-center font-bold shrink-0">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.828 14.828a4 4 0 01-5.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            </div>
            <h3 class="fluid-h3 font-heading text-[#1E1E1E] font-normal m-0">
              {isEs ? "Alimentos Colorantes" : "Coloring Foods"}
            </h3>
          </div>

          <p class="font-verdana text-gray-600 text-xs sm:text-sm font-light leading-relaxed mb-6">
            {isEs
              ? "100% Clean Label. Elaborados exclusivamente con materias primas alimentarias comestibles mediante procesos físicos: Azafrán, Concentrados de Espirulina (Blue Genipa), Zanahoria Negra y Remolacha."
              : "100% Clean Label. Crafted strictly from edible agricultural foods through gentle physical processes: Saffron, Spirulina and Genipa Blue, Black Carrot, and Beetroot concentrates."}
          </p>
        </div>
        <div class="pt-5 border-t border-gray-100 flex items-center justify-between text-xs font-semibold text-[#E30066] uppercase tracking-wider font-verdana">
          <span>{isEs ? "Clean Label" : "Clean Label"}</span>
          <a href={isEs ? "/es/products?category=Alimentos+Colorantes" : "/products?category=Alimentos+Colorantes"} class="hover:underline flex items-center gap-1 text-[#89385C]">
            <span>{isEs ? "Ver gama" : "Explore"}</span>
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
          </a>
        </div>
      </div>

      <!-- Sub-anchor: Vitaminas & Pre Mixes -->
      <div id="vitaminas-premixes" class="scroll-mt-28 bg-white p-6 sm:p-8 rounded-2xl shadow-sm border border-gray-100/90 flex flex-col justify-between hover:shadow-xl hover:-translate-y-2 transition-all duration-300 reveal delay-300 group">
        <div>
          <!-- Visual Image Preview -->
          <div class="grid grid-cols-3 gap-2 mb-6 rounded-xl overflow-hidden bg-gray-50 p-1 border border-gray-100">
            <img src="/assets/products/vitamins-premixes/vitaminas-premixes.webp" alt="Premixes" class="w-full aspect-square object-cover rounded-lg group-hover:scale-105 transition-transform duration-300" loading="lazy" />
            <img src="/assets/products/vitamins-premixes/suplementos-vitaminicos-300x300.webp" alt="Vitamina E" class="w-full aspect-square object-cover rounded-lg group-hover:scale-105 transition-transform duration-300 delay-75" loading="lazy" />
            <img src="/assets/products/vitamins-premixes/vitaminas-2.webp" alt="Vitamina A" class="w-full aspect-square object-cover rounded-lg group-hover:scale-105 transition-transform duration-300 delay-150" loading="lazy" />
          </div>

          <div class="flex items-center gap-3 mb-4">
            <div class="w-10 h-10 rounded-xl bg-[#008AD8]/10 text-[#008AD8] flex items-center justify-center font-bold shrink-0">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z"/></svg>
            </div>
            <h3 class="fluid-h3 font-heading text-[#1E1E1E] font-normal m-0">
              {isEs ? "Vitaminas y Premixes" : "Vitamins and Pre Mixes"}
            </h3>
          </div>

          <p class="font-verdana text-gray-600 text-xs sm:text-sm font-light leading-relaxed mb-6">
            {isEs
              ? "Premezclas a medida para la fortificación y enriquecimiento nutricional de alimentos y bebidas. Vitaminas A, D, C, complejo B y micronutrientes combinados con soporte cromático homogéneo."
              : "Custom premixes for nutritional fortification and enrichment of foods and beverages. Vitamins A, D, C, B-complex, and micronutrients combined with homogeneous chromatic carriers."}
          </p>
        </div>
        <div class="pt-5 border-t border-gray-100 flex items-center justify-between text-xs font-semibold text-[#008AD8] uppercase tracking-wider font-verdana">
          <span>{isEs ? "Fortificación Nutracéutica" : "Nutraceutical Fortification"}</span>
          <a href={isEs ? "/es/products?category=Vitaminas+y+Premixes" : "/products?category=Vitaminas+y+Premixes"} class="hover:underline flex items-center gap-1 text-[#89385C]">
            <span>{isEs ? "Ver gama" : "Explore"}</span>
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
          </a>
        </div>
      </div>

    </div>

    <!-- Explore Products CTA Bar -->
    <div class="flex flex-col sm:flex-row items-center justify-between gap-6 p-6 sm:p-8 bg-gradient-to-r from-[#FAF8F5] via-white to-[#FAF8F5] rounded-2xl border border-gray-200/80 mb-16 md:mb-24 shadow-xs reveal delay-150">
      <div>
        <h4 class="font-heading text-2xl sm:text-3xl text-[#1E1E1E] font-normal mb-1">
          {isEs ? "Catálogo Completo de Productos" : "Comprehensive Product Catalog"}
        </h4>
        <p class="font-verdana text-xs sm:text-sm text-gray-600 font-light m-0">
          {isEs 
            ? "Accede a fichas técnicas, dosificación y aplicaciones industriales de nuestra gama de colorantes y premezclas."
            : "Access technical data sheets, dosing parameters, and industrial specifications across our full product portfolio."}
        </p>
      </div>
      <a 
        href={isEs ? "/es/products" : "/products"}
        class="shrink-0 inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-[#89385C] hover:bg-[#702847] text-white text-xs sm:text-sm font-semibold font-verdana transition-all duration-200 hover:-translate-y-0.5 shadow-md"
      >
        <span>{isEs ? "Ver Todos los Productos" : "Explore All Products"}</span>
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
      </a>
    </div>

  </div>


  <!-- Color Comparison (VS Section with 3x bigger badge) -->
  <ColorComparison 
    title={isEs ? "¿Por qué elegir Colorantes Naturales?" : "Natural vs Artificial Colors"}
    naturalTitle={isEs ? "Colorantes Naturales" : "Natural Colors"}
    artificialTitle={isEs ? "Colorantes Artificiales" : "Artificial Colors"}
    naturalPoints={isEs ? [
      { title: "ETIQUETA LIMPIA", text: "Clean label demandada por consumidores conscientes y mercados prémium." },
      { title: "100% NATURAL", text: "Derivados directos de plantas, frutos y minerales sostenibles." },
      { title: "VALOR NUTRICIONAL", text: "Sin impacto negativo en la biodisponibilidad ni en la salud." },
      { title: "CUMPLIMIENTO GLOBAL", text: "Aprobados y promovidos por los reguladores alimentarios internacionales." }
    ] : [
      { title: "CLEAN LABEL", text: "Clean label appeal for health-conscious consumers and premium tiers." },
      { title: "100% NATURAL", text: "Derived from plant, fruit, and mineral renewable sources." },
      { title: "NUTRITIOUS", text: "No negative impact on nutritional value or digestive microbiome." },
      { title: "COMPLIANT", text: "Increasingly demanded and favored by global food authorities." }
    ]}
    artificialPoints={isEs ? [
      { title: "RIESGOS DE SALUD", text: "Vinculados reiteradamente a hipersensibilidad, alergias e hiperactividad." },
      { title: "SINTÉTICOS", text: "Químicos sintéticos basados en subproductos del petróleo." },
      { title: "ETIQUETAS DE ALERTA", text: "Exigen leyendas de advertencia obligatorias en múltiples países." },
      { title: "PÉRDIDA DE CONFIANZA", text: "Rechazo acelerado por parte de las nuevas generaciones de compradores." }
    ] : [
      { title: "HEALTH RISKS", text: "Often linked to health concerns, hyperreactivity, and allergies." },
      { title: "SYNTHETIC", text: "Synthetic petrochemical derivatives with artificial molecular structures." },
      { title: "WARNING LABELS", text: "Requires strict warning labels and mandatory disclaimers." },
      { title: "DISTRUST", text: "Steeply decreasing consumer trust and diminishing market viability." }
    ]}
    bgImage="/assets/food-colors-application.webp"
  />
</section>
