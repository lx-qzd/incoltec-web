---
import { getImage } from "astro:assets";

interface Props {
  id?: string;
  title?: string;
  subtitle?: string;
  description?: string;
  bgImage?: string;
}

const { 
  id = "our-company",
  title = "Our Company",
  subtitle = "Who We Are",
  description = "We are a dynamic team of innovators and visionaries dedicated to transforming food color solutions into extraordinary experiences globally.",
  bgImage = "/assets/fondo3.jpg"
} = Astro.props;

const bgUrl = typeof bgImage === 'string' ? bgImage : (await getImage({ src: bgImage, format: 'webp', width: 960 })).src;
---

<section id={id} class="w-full flex flex-col md:flex-row bg-[#FFFDF9] min-h-screen scroll-mt-24">
  <!-- Left Side: Image -->
  <div class="w-full md:w-1/2 min-h-[400px] md:min-h-screen relative order-1 md:order-1">
    <img src={bgUrl} alt={title} class="absolute inset-0 w-full h-full object-cover" />
  </div>

  <!-- Right Side: Content -->
  <div class="w-full md:w-1/2 flex items-center justify-center p-10 sm:p-16 md:p-20 lg:p-32 order-2 md:order-2">
    <div class="max-w-2xl text-center flex flex-col items-center w-full">
      <h2 class="script-text text-[#89385C] text-5xl sm:text-6xl md:text-[5.5rem] lg:text-[6.5rem] mb-6 sm:mb-8 leading-tight">{title}</h2>
      
      <div class="w-32 h-[1.5px] bg-[#C6ACB8] mb-8 sm:mb-12"></div>
      
      <p class="text-[#89385C] text-lg sm:text-xl md:text-2xl font-light leading-relaxed mb-12 sm:mb-16">
        {description}
      </p>

      <!-- Stats Grid -->
      <div class="grid grid-cols-2 gap-x-12 gap-y-16 w-full mt-8">
        
        <!-- Stat 1 -->
        <div class="flex flex-col items-center">
          <div class="text-4xl sm:text-5xl font-light text-[#89385C] mb-2 flex items-baseline">
            <span>20</span>
            <span class="font-bold ml-1">+</span>
          </div>
          <p class="text-sm sm:text-base text-[#89385C]/80 uppercase tracking-widest text-center mt-3">Years of Experience</p>
        </div>

        <!-- Stat 2 -->
        <div class="flex flex-col items-center">
          <div class="text-4xl sm:text-5xl font-light text-[#89385C] mb-2 flex items-baseline">
            <span>100</span>
            <span class="font-bold ml-1">%</span>
          </div>
          <p class="text-sm sm:text-base text-[#89385C]/80 uppercase tracking-widest text-center mt-3">Natural Options</p>
        </div>

        <!-- Stat 3 -->
        <div class="flex flex-col items-center">
          <div class="text-4xl sm:text-5xl font-light text-[#89385C] mb-2 flex items-baseline">
            <span>50</span>
            <span class="font-bold ml-1">+</span>
          </div>
          <p class="text-sm sm:text-base text-[#89385C]/80 uppercase tracking-widest text-center mt-3">Global Markets</p>
        </div>

        <!-- Stat 4 -->
        <div class="flex flex-col items-center">
          <div class="text-4xl sm:text-5xl font-light text-[#89385C] mb-2 flex items-baseline">
            <span>10</span>
            <span class="font-bold ml-1">K+</span>
          </div>
          <p class="text-sm sm:text-base text-[#89385C]/80 uppercase tracking-widest text-center mt-3">Happy Clients</p>
        </div>

      </div>
    </div>
  </div>
</section>
