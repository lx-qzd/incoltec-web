---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map(post => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<Layout title={`${post.data.title} | INCOLTEC Blog`}>
  <Header currentPath={`/blog/${post.id}`} />
  
  <article class="article-page bg-[#F8FAFC]">
    <div class="container content bg-white p-8 md:p-16 border border-gray-100 shadow-sm">
      
      <div class="article-header text-center">
        <div class="article-meta">
          <time datetime={post.data.date.toISOString()}>
            {post.data.date.toLocaleDateString('en-US', {
              year: 'numeric',
              month: 'long',
              day: 'numeric'
            })}
          </time>
          <span class="meta-dot"></span>
          <span>{post.data.author}</span>
        </div>
        
        <h1>{post.data.title}</h1>
        
        <p class="article-summary">{post.data.summary}</p>
      </div>

      <!-- Divider -->
      <div class="divider"></div>

      <!-- Post Content -->
      <div class="prose-content">
        <Content />
      </div>
      
      <!-- Back to blog -->
      <div class="back-link">
        <a href="/blog" class="text-magenta">
          <svg fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/></svg>
          Back to all articles
        </a>
      </div>

    </div>
  </article>

  <Footer />
</Layout>

<style>
  .article-page {
    padding: 6rem 2rem;
  }
  
  .content {
    max-width: 800px;
    margin: 0 auto;
  }

  .article-header {
    margin-bottom: 4rem;
  }

  .article-meta {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    color: var(--c-cyan);
    font-size: 0.9rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 2rem;
  }

  .meta-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: var(--c-cyan);
  }

  .article-header h1 {
    font-size: clamp(2.5rem, 5vw, 4rem);
    font-weight: 700;
    line-height: 1.1;
    margin-bottom: 2rem;
    color: var(--c-dark);
  }

  .article-summary {
    font-size: 1.35rem;
    color: var(--c-dark);
    font-weight: 300;
    line-height: 1.7;
    opacity: 0.8;
  }

  .divider {
    width: 80px;
    height: 2px;
    background-color: rgba(0, 0, 0, 0.1);
    margin: 0 auto 4rem;
  }

  /* Main Content */
  .prose-content {
    color: var(--c-dark);
    font-size: 1.15rem;
    line-height: 1.8;
    opacity: 0.9;
  }
  
  /* Target elements generated by markdown */
  .prose-content :global(h2) {
    font-size: 2.2rem;
    color: var(--c-dark);
    margin-top: 3.5rem;
    margin-bottom: 1.5rem;
    font-weight: 600;
  }
  .prose-content :global(h3) {
    font-size: 1.6rem;
    color: var(--c-dark);
    margin-top: 2.5rem;
    margin-bottom: 1rem;
  }
  .prose-content :global(p) {
    margin-bottom: 1.75rem;
  }
  .prose-content :global(ul) {
    margin-bottom: 2rem;
    padding-left: 2rem;
  }
  .prose-content :global(li) {
    margin-bottom: 0.75rem;
  }
  .prose-content :global(strong) {
    color: var(--c-dark);
    font-weight: 600;
  }
  .prose-content :global(a) {
    color: var(--c-cyan);
    text-decoration: none;
    transition: opacity 0.2s ease;
  }
  .prose-content :global(a:hover) {
    opacity: 0.8;
    text-decoration: underline;
  }

  .back-link {
    margin-top: 5rem;
    padding-top: 2rem;
    border-top: 1px solid rgba(0, 0, 0, 0.1);
    text-align: center;
  }

  .back-link a {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    font-weight: 600;
    font-size: 1.1rem;
  }

  .back-link svg {
    width: 24px;
    height: 24px;
    transition: transform 0.3s ease;
  }

  .back-link a:hover svg {
    transform: translateX(-5px);
  }
</style>
