---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Hero from '../../components/Hero.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog');
// Sort by date descending
allPosts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<Layout 
  title="Technical Blog & Industry Insights | INCOLTEC"
  description="Stay informed with expert insights on natural food coloring innovations, clean label trends, and EFSA/FDA regulatory developments."
>

  <Header currentPath="/blog" />
  
  <Hero 
    title="Technical Insights & News" 
    subtitle="Stay up to date with the latest innovations, regulatory changes, and application techniques in the B2B food coloring industry."
    backgroundImage="/assets/fondo2.jpg" 
  />
  
  <main class="bg-[#F8FAFC]">
    <div class="content-section container">
      <div class="content">

      <div class="features-grid">
        {allPosts.map(post => (
          <article class="feature-card article-card">
            <div class="article-meta">
              <time datetime={post.data.date.toISOString()}>
                {post.data.date.toLocaleDateString('en-US', {
                  year: 'numeric',
                  month: 'long',
                  day: 'numeric'
                })}
              </time>
              <span class="meta-dot"></span>
              <span>{post.data.author}</span>
            </div>
            
            <a href={`/blog/${post.id}`}>
              <h3>{post.data.title}</h3>
            </a>
            
            <p class="article-summary">{post.data.summary}</p>
            
            <div class="card-footer">
              <a href={`/blog/${post.id}`} class="read-btn text-cyan">
                Read Article
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
              </a>
            </div>
          </article>
        ))}
      </div>

      </div>
    </div>
  </main>

  <Footer />
</Layout>

<style>
  .content-section {
    padding: clamp(3rem, 6vw, 6rem) clamp(1rem, 3vw, 2rem);
  }
  .content {
    max-width: 1200px;
    margin: 0 auto;
  }

  .features-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr));
    gap: clamp(1.25rem, 2.5vw, 2.5rem);
  }

  .feature-card.article-card {
    background: #ffffff;
    border: 1px solid rgba(0, 0, 0, 0.06);
    padding: clamp(1.5rem, 3vw, 2.5rem);
    border-radius: 1.25rem;
    display: flex;
    flex-direction: column;
    container-type: inline-size;
    transition: transform 0.3s ease, background 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease;
  }

  .feature-card.article-card:hover {
    transform: translateY(-5px);
    background: #ffffff;
    border-color: rgba(0, 138, 216, 0.3);
    box-shadow: 0 12px 36px rgba(0,0,0,0.06);
  }

  .article-meta {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 0.85rem;
    color: var(--c-dark);
    opacity: 0.6;
    margin-bottom: 1.25rem;
    font-weight: 500;
  }

  .meta-dot {
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background-color: var(--c-dark);
  }

  .feature-card h3 {
    font-size: clamp(1.35rem, 1.15rem + 0.8vw, 1.8rem);
    line-height: 1.3;
    margin-bottom: 1.25rem;
    color: var(--c-dark);
    overflow-wrap: break-word;
    transition: color 0.3s ease;
  }
  
  .feature-card:hover h3 {
    color: var(--c-cyan);
  }

  .article-summary {
    color: var(--c-dark);
    opacity: 0.8;
    font-size: 1.05rem;
    line-height: 1.7;
    margin-bottom: 2rem;
    display: -webkit-box;
    -webkit-line-clamp: 4;
    -webkit-box-orient: vertical;
    overflow: hidden;
    flex: 1;
    text-align: left;
  }

  .card-footer {
    margin-top: auto;
    padding-top: 1.5rem;
    border-top: 1px solid rgba(0,0,0,0.05);
  }

  .read-btn {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 600;
  }

  .read-btn svg {
    width: 16px;
    height: 16px;
    transition: transform 0.3s ease;
  }

  .feature-card:hover .read-btn svg {
    transform: translateX(5px);
  }
</style>
