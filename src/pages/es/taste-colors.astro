---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Hero from '../../components/Hero.astro';
---

<Layout 
  title="Saborea los Colores - Soluciones de Colorantes Naturales"
  description="Descubre la gama de colorantes naturales, alimentos colorantes y extractos botánicos de INCOLTEC diseñados para maximizar el atractivo visual de tus productos alimentarios."
>
  <Header currentPath="/es/taste-colors" />
  
  <main>
    <Hero 
      title="Saborea los Colores" 
      subtitle="Pigmentos botánicos puros y alimentos colorantes que inspiran emoción culinaria"
      backgroundImage="/assets/fondo1.jpg" 
    />


    <section class="content-section container">
      <div class="content">
        <h2>La Naturaleza como Inspiración</h2>
        <p>
          Las soluciones de INCOLTEC combinan elementos orgánicos con tecnología avanzada para 
          crear una experiencia visual sin igual. Nuestros colores despiertan emociones y aumentan 
          el atractivo de los alimentos.
        </p>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  .content-section {
    padding: clamp(3rem, 6vw, 6rem) clamp(1rem, 4vw, 2rem);
  }

  .content {
    max-width: 900px;
    margin: 0 auto;
    text-align: center;
  }

  .content h2 {
    font-size: clamp(1.8rem, 1.3rem + 2.5vw, 2.75rem);
    margin-bottom: 1.5rem;
    line-height: 1.25;
  }

  .content p {
    font-size: clamp(1rem, 0.95rem + 0.3vw, 1.15rem);
    color: #555;
    line-height: 1.7;
  }
</style>
