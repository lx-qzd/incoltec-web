---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Hero from '../../components/Hero.astro';
import OurCompanySection from '../../components/OurCompanySection.astro';
---

<Layout 
  title="Nuestra Empresa y Valores"
  description="Conoce INCOLTEC: misión, solidez corporativa, liderazgo industrial, capacidades de laboratorio e innovación continua en soluciones cromáticas de origen natural."
>
  <Header currentPath="/es/our-company" />
  
  <main>
    <Hero 
      title="Nuestra Empresa" 
      subtitle="Conocimiento profundo de los mercados, la ciencia de los alimentos y las culturas culinarias"
      backgroundImage="/assets/fondo1.jpg" 
    />

    <OurCompanySection isEs={true} />
  </main>

  <Footer />
</Layout>
