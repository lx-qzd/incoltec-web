---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Hero from '../../components/Hero.astro';
import OurCompanySection from '../../components/OurCompanySection.astro';
---

<Layout 
  title="Sobre Incoltec: empresa, laboratorio y calidad"
  description="Incoltec desarrolla y fabrica colorantes alimentarios naturales en Barcelona: empresa, laboratorio de aplicaciones, producción, compromiso de calidad y equipo."
>
  <Header />
  
  <main id="main">
    <Hero 
      title="Nuestra Empresa" 
      subtitle="Conocimiento profundo de los mercados, la ciencia de los alimentos y las culturas culinarias"
      backgroundImage="/assets/fondo1.jpg" 
    />

    <OurCompanySection isEs={true} />
  </main>

  <Footer />
</Layout>
