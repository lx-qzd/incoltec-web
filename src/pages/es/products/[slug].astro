---
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const products = await getCollection('products');
  return products.map(product => ({
    params: { slug: product.id },
    props: { product },
  }));
}

const { product } = Astro.props;
const { Content } = await render(product);
---

<Layout 
  title={`${product.data.title} | Especificaciones Técnicas`}
  description={product.data.description || `${product.data.title} - solución de colorante natural por INCOLTEC con perfil técnico y aplicaciones alimentarias.`}
>

  <div class="product-detail-page bg-[#F8FAFC]">
  <Header currentPath={`/es/products/${product.id}`} />
  
  <div class="product-header-section bg-white">
    <div class="container content">
      <div class="breadcrumbs">
        <a href="/es/products">Productos</a>
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
        <span>{product.data.category}</span>
      </div>
      
      <div class="header-layout">
        <div class="header-text">
          <h1>{product.data.title}</h1>
          <p class="subtitle">{product.data.description}</p>
        </div>
        
        <div class="specs-card">
          <h3>Perfil Técnico</h3>
          <ul>
            {product.data.color && (
              <li>
                <span class="spec-label">Tono / Color</span>
                <span class="spec-value color-indicator">
                   <span class="color-dot" style={`background-color: ${
                     product.data.color.toLowerCase().includes('amarillo') ? '#FBBF24' : 
                     product.data.color.toLowerCase().includes('rojo') || product.data.color.toLowerCase().includes('magenta') ? '#EF4444' :
                     product.data.color.toLowerCase().includes('verde') ? '#10B981' :
                     product.data.color.toLowerCase().includes('azul') ? '#3B82F6' :
                     product.data.color.toLowerCase().includes('blanco') ? '#FFFFFF' : '#cccccc'
                   }`}></span>
                   {product.data.color}
                </span>
              </li>
            )}
            {product.data.solubility && (
              <li>
                <span class="spec-label">Solubilidad</span>
                <span class="spec-value">{product.data.solubility}</span>
              </li>
            )}
            {product.data.phRange && (
              <li>
                <span class="spec-label">Rango de pH</span>
                <span class="spec-value">{product.data.phRange}</span>
              </li>
            )}
          </ul>
          
          <div class="actions">
            <a href="/es/#contact" class="btn btn-primary">
              Solicitar Muestra
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
  
  <div class="container content main-content-wrapper">
    <div class="details-grid">
      <div class="markdown-body">
        <Content />
      </div>
      
      <div class="sidebar">
        {product.data.applications && (
          <div class="sidebar-card">
            <h4>Aplicaciones Recomendadas</h4>
            <div class="app-tags">
              {product.data.applications.map(app => (
                <span class="app-tag">{app}</span>
              ))}
            </div>
          </div>
        )}
        
        <div class="sidebar-card help-card">
          <h4>¿Necesitas una Formulación a Medida?</h4>
          <p>Nuestros expertos en I+D pueden optimizar este colorante para la matriz y condiciones de procesado de tu producto.</p>
          <a href="/es/#contact" class="link-contact">Consultar con Soporte Técnico &rarr;</a>
        </div>
      </div>
    </div>
  </div>
  
  </div>
  
  <Footer />
</Layout>

<style>
  .product-header-section {
    padding: 3rem 0;
    border-bottom: 1px solid #E2E8F0;
  }
  .content {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }
  .breadcrumbs {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.875rem;
    color: #64748B;
    margin-bottom: 2rem;
  }
  .breadcrumbs a {
    color: #008AD8;
    text-decoration: none;
  }
  .breadcrumbs a:hover {
    text-decoration: underline;
  }
  .breadcrumbs svg {
    width: 1rem;
    height: 1rem;
  }
  .header-layout {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }
  @media (min-width: 768px) {
    .header-layout {
      flex-direction: row;
      justify-content: space-between;
      align-items: flex-start;
    }
  }
  .header-text {
    flex: 1;
  }
  .header-text h1 {
    font-size: 2.25rem;
    font-weight: 700;
    color: #0F172A;
    margin-bottom: 1rem;
    line-height: 1.2;
  }
  .header-text .subtitle {
    font-size: 1.125rem;
    color: #475569;
    line-height: 1.6;
    max-w: 600px;
  }
  .specs-card {
    background: #F8FAFC;
    border: 1px solid #E2E8F0;
    border-radius: 1rem;
    padding: 1.5rem;
    min-width: 280px;
  }
  .specs-card h3 {
    font-size: 1rem;
    font-weight: 600;
    color: #1E293B;
    margin-bottom: 1rem;
    border-bottom: 1px solid #CBD5E1;
    padding-bottom: 0.5rem;
  }
  .specs-card ul {
    list-style: none;
    padding: 0;
    margin: 0 0 1.5rem 0;
  }
  .specs-card li {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.5rem 0;
    font-size: 0.875rem;
    border-bottom: 1px dashed #E2E8F0;
  }
  .specs-card li:last-child {
    border-bottom: none;
  }
  .spec-label {
    color: #64748B;
  }
  .spec-value {
    font-weight: 500;
    color: #0F172A;
  }
  .color-indicator {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .color-dot {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    border: 1px solid rgba(0,0,0,0.1);
  }
  .actions {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.75rem 1rem;
    border-radius: 0.5rem;
    font-size: 0.875rem;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.2s;
  }
  .btn svg {
    width: 1rem;
    height: 1rem;
  }
  .btn-primary {
    background: #E30066;
    color: #fff;
  }
  .btn-primary:hover {
    background: #c50058;
  }
  .main-content-wrapper {
    padding: 4rem 1.5rem;
  }
  .details-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
  }
  @media (min-width: 768px) {
    .details-grid {
      grid-template-columns: 2fr 1fr;
    }
  }
  .markdown-body {
    background: #fff;
    padding: 2.5rem;
    border-radius: 1rem;
    border: 1px solid #E2E8F0;
    box-shadow: 0 1px 3px 0 rgba(0, 0, 0, 0.05);
    line-height: 1.7;
    color: #334155;
  }
  .sidebar {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }
  .sidebar-card {
    background: #fff;
    padding: 1.5rem;
    border-radius: 1rem;
    border: 1px solid #E2E8F0;
    box-shadow: 0 1px 3px 0 rgba(0, 0, 0, 0.05);
  }
  .sidebar-card h4 {
    font-size: 1rem;
    font-weight: 600;
    color: #0F172A;
    margin-bottom: 1rem;
  }
  .app-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .app-tag {
    background: #F1F5F9;
    color: #475569;
    padding: 0.35rem 0.65rem;
    border-radius: 0.375rem;
    font-size: 0.8rem;
    font-weight: 500;
  }
  .help-card {
    background: #008AD8;
    color: #fff;
    border: none;
  }
  .help-card h4 {
    color: #fff;
  }
  .help-card p {
    font-size: 0.875rem;
    opacity: 0.9;
    margin-bottom: 1rem;
    line-height: 1.5;
  }
  .link-contact {
    color: #fff;
    font-weight: 600;
    font-size: 0.875rem;
    text-decoration: underline;
  }
</style>
