---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Hero from '../../components/Hero.astro';
---

<Layout 
  title="Perfeccionando Alimentos - Ciencia Aplicada y Soluciones de Color"
  description="Descubre cómo INCOLTEC resuelve desafíos complejos de formulación con ciencia de alimentos avanzada, ensayos de estabilidad y mezclas de pigmentos a medida."
>
  <Header currentPath="/es/perfecting-food" />
  
  <main>
    <Hero 
      title="Perfeccionando Alimentos" 
      subtitle="Ciencia aplicada a los alimentos, formulación de precisión y estabilidad en proceso"
      backgroundImage="/assets/fondo3.jpg" 
    />


    <section class="content-section container">
      <div class="content">
        <h2>Ciencia Aplicada y Control de Procesos</h2>
        <p>
          Nuestro enfoque en ciencia, calidad, control de procesos y confianza, nos permite ofrecer 
          atributos esenciales en una empresa vinculada a la industria alimentaria.
        </p>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  .content-section {
    padding: clamp(3rem, 6vw, 6rem) clamp(1rem, 4vw, 2rem);
  }

  .content {
    max-width: 900px;
    margin: 0 auto;
    text-align: center;
  }

  .content h2 {
    font-size: clamp(1.8rem, 1.3rem + 2.5vw, 2.75rem);
    margin-bottom: 1.5rem;
    line-height: 1.25;
  }

  .content p {
    font-size: clamp(1rem, 0.95rem + 0.3vw, 1.15rem);
    color: #555;
    line-height: 1.7;
  }
</style>
