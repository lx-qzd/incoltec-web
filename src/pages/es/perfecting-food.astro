---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Hero from '../../components/Hero.astro';
---

<Layout title="Perfeccionando Alimentos">
  <Header currentPath="/perfecting-food" />
  
  <main>
    <Hero 
      title="Perfeccionando Alimentos" 
      subtitle="Innovación a través de la ciencia"
      backgroundImage="/assets/fondo3.jpg" 
    />

    <section class="content-section container">
      <div class="content">
        <h2>Ciencia Aplicada y Control de Procesos</h2>
        <p>
          Nuestro enfoque en ciencia, calidad, control de procesos y confianza, nos permite ofrecer 
          atributos esenciales en una empresa vinculada a la industria alimentaria.
        </p>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  .content-section {
    padding: 6rem 2rem;
  }

  .content {
    max-width: 900px;
    margin: 0 auto;
    text-align: center;
  }

  .content h2 {
    font-size: 2.5rem;
    margin-bottom: 2rem;
  }

  .content p {
    font-size: 1.15rem;
    color: var(--c-light);
  }
</style>
