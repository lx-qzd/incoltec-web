---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import ColorSolutionsSection from "../../components/ColorSolutionsSection.astro";
import LeadMagnet from "../../components/LeadMagnet.astro";
---

<Layout 
  title="Aplicaciones de colorantes por sector alimentario"
  description="Soluciones de color para bebidas, lácteos, panadería, cárnicos y otras formulaciones con soporte técnico especializado."
  image="/assets/soluciones.jpg"
>
  <Header />

  <ColorSolutionsSection isEs={true} showHero={true} />

  <LeadMagnet
    title="Solicita una solución de color a medida"
    description="Nuestro laboratorio de aplicaciones desarrolla sistemas de color natural ajustados a tu proceso, pH y vida útil."
    reason="formulation"
  />

  <Footer />
</Layout>
