---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Hero from '../../components/Hero.astro';
import CompanyTeaser from '../../components/CompanyTeaser.astro';
import ImageBanner from '../../components/ImageBanner.astro';
import VibrantLifeSection from '../../components/VibrantLifeSection.astro';
import TasteColorsSection from '../../components/TasteColorsSection.astro';
import PerfectingFoodSection from '../../components/PerfectingFoodSection.astro';
import LeadMagnet from '../../components/LeadMagnet.astro';
---

<Layout
  title="Colorantes alimentarios naturales para industria | Incoltec"
  description="Fabricación y soluciones de color para alimentos y bebidas. Colorantes naturales, alimentos colorantes LINICOL y soporte técnico B2B."
>
  <Header />

  
  <main id="main">
    <Hero heading="Colorantes alimentarios naturales y alimentos colorantes para la industria" />

    <!-- 1. Product families (anchors: #taste-colors, #colorantes-naturales, #alimentos-colorantes, #vitaminas-premixes) -->
    <TasteColorsSection isEs={true} />

    <ImageBanner 
      image="/assets/fondo1.jpg" 
      tag="Tecnología Cromática" 
      title="Formulación Vibrante y Colores Puros" 
      subtitle="Conectamos la cultura culinaria con la consistencia cromática de nivel mundial." 
    />

    <!-- 2. Applications & technical support (anchors: #perfecting-food, #soluciones, #innovacion) -->
    <PerfectingFoodSection isEs={true} />

    <ImageBanner 
      image="/assets/fondo2.jpg" 
      tag="Calidad Certificada" 
      title="Dando Forma al Futuro del Atractivo Alimentario" 
      subtitle="Garantía de etiqueta limpia y brillo sensorial inigualable en cada aplicación." 
    />

    <!-- 3. Quality guarantee (anchors: #vibrant-life, #compromiso, #calidad) -->
    <VibrantLifeSection isEs={true} />

    <!-- 4. Company summary; full content lives on /our-company -->
    <CompanyTeaser />

    <!-- 5. Contact (anchor: #contact) -->
    <LeadMagnet
      title="Contacto"
      description="Solicita muestras, fichas técnicas o soporte de formulación para tus aplicaciones B2B."
    />
  </main>

  <Footer />
</Layout>
