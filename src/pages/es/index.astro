---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Hero from '../../components/Hero.astro';
import OurCompanySection from '../../components/OurCompanySection.astro';
import ImageBanner from '../../components/ImageBanner.astro';
import VibrantLifeSection from '../../components/VibrantLifeSection.astro';
import TasteColorsSection from '../../components/TasteColorsSection.astro';
import PerfectingFoodSection from '../../components/PerfectingFoodSection.astro';
import LeadMagnet from '../../components/LeadMagnet.astro';
---

<Layout 
  title="Incoltec - Fabricante de Colorantes Alimentarios y Soluciones al por Mayor"
  description="INCOLTEC desarrolla colorantes naturales, alimentos colorantes, vitaminas y formulaciones a medida para la industria alimentaria B2B a nivel global."
>
  <Header currentPath="/es" />

  
  <main>
    <!-- Hero Slider (Imagen 1) -->
    <Hero />

    <!-- Sección 1: Vida Vibrante (Anclajes: #vibrant-life, #compromiso, #calidad) -->
    <VibrantLifeSection isEs={true} />

    <!-- Separador Visual 1: Entre Vida Vibrante y Saborea los Colores -->
    <ImageBanner 
      image="/assets/fondo1.jpg" 
      tag="Tecnología Cromática" 
      title="Formulación Vibrante y Colores Puros" 
      subtitle="Conectamos la cultura culinaria con la consistencia cromática de nivel mundial." 
    />

    <!-- Sección 2: Saborea los Colores & Sección VS (Anclajes: #taste-colors, #colorantes-naturales, #alimentos-colorantes, #vitaminas-premixes) -->
    <TasteColorsSection isEs={true} />

    <!-- Separador Visual 2: Entre Saborea los Colores y Perfeccionando Alimentos -->
    <ImageBanner 
      image="/assets/fondo2.jpg" 
      tag="Calidad Certificada" 
      title="Dando Forma al Futuro del Atractivo Alimentario" 
      subtitle="Garantía de etiqueta limpia y brillo sensorial inigualable en cada aplicación." 
    />

    <!-- Sección 3: Perfeccionando Alimentos (Anclajes: #perfecting-food, #soluciones, #innovacion) -->
    <PerfectingFoodSection isEs={true} />

    <!-- Separador Visual 3: Entre Perfeccionando Alimentos y Nuestra Empresa -->
    <ImageBanner 
      image="/assets/fondo3.jpg" 
      tag="Excelencia Global" 
      title="Ciencia, Trayectoria y Escala Industrial" 
      subtitle="Décadas de experiencia formulando colorantes de alto rendimiento para la industria alimentaria internacional." 
    />

    <!-- Sección 4: Nuestra Empresa (Anclajes: #our-company, #organizacion, #laboratorio) -->
    <OurCompanySection isEs={true} />

    <!-- Sección 5: Contacto & Descarga de Catálogo Técnico (Anclaje: #contact) -->
    <LeadMagnet 
      title="Descarga Nuestro Catálogo Técnico 2024"
      description="Obtén información completa sobre nuestras aplicaciones de colores naturales, especificaciones y cumplimiento normativo para la industria alimentaria B2B."
      buttonText="Descargar Catálogo"
      placeholderName="Tu Nombre"
      placeholderEmail="Email Corporativo"
      placeholderCompany="Nombre de Empresa"
      privacyText="Acepto la Política de Privacidad"
    />
  </main>

  <Footer />
</Layout>
