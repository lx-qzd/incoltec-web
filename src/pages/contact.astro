---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Hero from '../components/Hero.astro';
import { Image } from 'astro:assets';
import fondo1Webp from '../assets/fondo1.webp';
---

<Layout 
  title="Contact Us & Request Samples"
  description="Get in touch with INCOLTEC's technical formulation lab. Request product samples, custom shade blending, and regulatory guidance for your food and beverage applications."
>
  <Header currentPath="/contact" />
  
  <main>
    <section class="contact-hero-section relative min-h-[100dvh] flex items-center py-[clamp(5rem,10dvh,8rem)] overflow-hidden">
      <div class="absolute inset-0 z-0">
        <Image 
          src={fondo1Webp} 
          alt="Incoltec formulation contact background" 
          class="w-full h-full object-cover" 
          loading="eager"
          decoding="async"
          width={1920}
          height={1080}
        />
        <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/45 to-black/60 pointer-events-none"></div>
      </div>

      <div class="container relative z-20 w-full max-w-4xl mx-auto px-4 sm:px-6">
        
        <!-- Frosted Glass Card Wrapper -->
        <div class="glass-card-dark rounded-3xl p-6 sm:p-10 md:p-12 border border-white/20 shadow-[0_24px_60px_-15px_rgba(0,0,0,0.7)] backdrop-blur-2xl reveal-scale delay-100">
          <div class="w-full text-center mb-8">
            <span class="inline-block font-verdana text-xs uppercase tracking-[0.25em] text-[#FFC000] font-bold mb-3">
              Direct Inquiries
            </span>
            <h1 class="font-heading text-[clamp(2.5rem,1.8rem+3.5vw,4.5rem)] text-white font-normal mb-3 leading-tight">Contact Us</h1>

            <p class="font-verdana text-white/85 text-[clamp(0.95rem,0.9rem+0.3vw,1.125rem)] font-light max-w-xl mx-auto leading-relaxed">
              Connect with our technical food science team for custom formulations, technical dossiers, or pilot sample requests.
            </p>
          </div>

          <div class="contact-form-container w-full">

          <form class="contact-form" id="contactForm" action="/api/contact" method="POST">
            <!-- Anti-spam Honeypot -->
            <div style="display:none;">
              <label for="bot_field_contact">Leave this empty:</label>
              <input type="text" id="bot_field_contact" name="bot_field" />
            </div>

            <div class="form-grid">
              <div class="form-group">
                <input type="text" id="name" name="name" required placeholder="NAME" />
              </div>
              <div class="form-group">
                <input type="email" id="email" name="email" required placeholder="E MAIL" />
              </div>
            </div>
            
            <div class="form-group">
              <input type="text" id="company" name="company" placeholder="COMPANY NAME" />
            </div>
            
            <div class="form-group">
              <textarea id="message" name="message" rows="5" required placeholder="HOW CAN WE HELP"></textarea>
            </div>

            <div class="form-checkbox">
              <input type="checkbox" id="privacy" name="privacy" required />
              <label for="privacy">I AGREE TO THE <a href="/privacy-policy" class="hover:underline">PRIVACY POLICY</a></label>
            </div>

            <div class="form-checkbox">
              <input type="checkbox" id="commercial" name="commercial" />
              <label for="commercial">I WOULD LIKE TO RECEIVE COMMERCIAL COMMUNICATIONS</label>
            </div>

            <div id="form-feedback" class="hidden my-4 p-3 rounded text-sm font-medium"></div>

            <div class="submit-container flex justify-end mt-6">
              <button type="submit" class="submit-btn" id="submitBtn">SUBMIT</button>
            </div>
          </form>
        </div>
      </div>
    </div>
    </section>

  </main>

  <Footer />
</Layout>

<script>
  const form = document.getElementById('contactForm') as HTMLFormElement;
  const feedback = document.getElementById('form-feedback');
  const submitBtn = document.getElementById('submitBtn') as HTMLButtonElement;

  if (form) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      
      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.textContent = 'Sending...';
      }
      
      if (feedback) {
        feedback.classList.add('hidden');
        feedback.classList.remove('bg-green-500/20', 'text-green-400', 'bg-red-500/20', 'text-red-400');
      }

      try {
        const formData = new FormData(form);
        const response = await fetch('/api/contact', {
          method: 'POST',
          body: formData
        });
        
        const result = await response.json();
        
        if (feedback) {
          feedback.classList.remove('hidden');
          if (response.ok) {
            feedback.classList.add('bg-green-500/20', 'text-green-400');
            feedback.textContent = result.message || 'Message sent successfully!';
            form.reset();
          } else {
            feedback.classList.add('bg-red-500/20', 'text-red-400');
            feedback.textContent = result.error || 'There was a problem sending your message.';
          }
        }
      } catch (err) {
        if (feedback) {
          feedback.classList.remove('hidden');
          feedback.classList.add('bg-red-500/20', 'text-red-400');
          feedback.textContent = 'A network error occurred. Please try again.';
        }
      } finally {
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.textContent = 'Send Message';
        }
      }
    });
  }
</script>

<style>
  .contact-hero-section {
    overflow: hidden;
  }

  .contact-form-container {
    container-type: inline-size;
  }

  .form-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr));
    gap: 1.5rem;
    margin-bottom: 1.5rem;
  }

  .form-group {
    margin-bottom: 1.5rem;
  }

  .form-group input,
  .form-group textarea {
    width: 100%;
    min-height: 48px;
    padding: 1rem 1.2rem;
    background: rgba(255, 255, 255, 0.15);
    border: 1px solid rgba(255, 255, 255, 0.2);
    color: var(--c-white);
    border-radius: 12px;
    font-family: inherit;
    font-size: 0.95rem;
    letter-spacing: 0.05em;
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    transition: all 0.3s ease;
  }

  .form-group textarea {
    min-height: 120px;
  }

  .form-group input::placeholder,
  .form-group textarea::placeholder {
    color: rgba(255, 255, 255, 0.8);
  }

  .form-group input:focus,
  .form-group textarea:focus {
    outline: none;
    background: rgba(255, 255, 255, 0.25);
    border-color: rgba(255, 255, 255, 0.5);
  }

  .form-checkbox {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    margin-bottom: 1rem;
  }

  .form-checkbox input[type="checkbox"] {
    appearance: none;
    width: 20px;
    height: 20px;
    border: 1px solid rgba(255, 255, 255, 0.4);
    border-radius: 4px;
    background: rgba(255, 255, 255, 0.1);
    cursor: pointer;
    position: relative;
    display: grid;
    place-content: center;
  }

  .form-checkbox input[type="checkbox"]::before {
    content: "";
    width: 10px;
    height: 10px;
    transform: scale(0);
    transition: 120ms transform ease-in-out;
    box-shadow: inset 1em 1em white;
    background-color: white;
    transform-origin: center;
    clip-path: polygon(14% 44%, 0 65%, 50% 100%, 100% 16%, 80% 0%, 43% 62%);
  }

  .form-checkbox input[type="checkbox"]:checked::before {
    transform: scale(1);
  }

  .form-checkbox label {
    font-size: 0.8rem;
    color: rgba(255, 255, 255, 0.9);
    letter-spacing: 0.05em;
    cursor: pointer;
  }

  .submit-btn {
    background: rgba(255, 255, 255, 0.2);
    color: var(--c-white);
    border: 1px solid rgba(255, 255, 255, 0.3);
    min-height: 48px;
    padding: 0.75rem 2.5rem;
    font-size: 1rem;
    font-weight: 500;
    letter-spacing: 0.05em;
    cursor: pointer;
    border-radius: 999px;
    backdrop-filter: blur(10px);
    transition: all 0.3s ease;
    touch-manipulation: manipulation;
  }

  .submit-btn:hover {
    background: rgba(255, 255, 255, 0.3);
    border-color: rgba(255, 255, 255, 0.5);
  }
</style>
