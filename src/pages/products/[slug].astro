---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import ProductDetail from '../../components/ProductDetail.astro';
import { getCollection } from 'astro:content';
import { getLocalizedProducts, localizeProduct } from '../../data/products';
import { localizePath, SITE_URL } from '../../i18n/routes';

const lang = 'en';

export async function getStaticPaths() {
  const products = await getCollection('products');
  return products.map((product) => ({ params: { slug: product.id }, props: { product } }));
}

const product = await localizeProduct(Astro.props.product, lang);
const all = await getLocalizedProducts(lang);
const related = all.filter((p) => p.family === product.family && p.id !== product.id).slice(0, 4);

const abs = (p: string) => `${SITE_URL}${p}`;
const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: lang === 'es' ? 'Inicio' : 'Home', item: abs(localizePath('/', lang)) },
    { '@type': 'ListItem', position: 2, name: lang === 'es' ? 'Productos' : 'Products', item: abs(localizePath('/products', lang)) },
    { '@type': 'ListItem', position: 3, name: product.title, item: abs(localizePath(`/products/${product.id}`, lang)) },
  ],
};
---

<Layout
  title={product.title}
  description={product.description}
  image={product.image}
  schema={[breadcrumb]}
>
  <Header />
  <ProductDetail lang={lang} product={product} related={related} />
  <Footer />
</Layout>
