---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Hero from '../components/Hero.astro';
---

<Layout title="Perfecting Food">
  <Header currentPath="/perfecting-food" />
  
  <main>
    <Hero 
      title="Perfecting Food" 
      subtitle="Innovation through science"
      backgroundImage="/assets/fondo3.jpg" 
    />

    <section class="content-section container">
      <div class="content">
        <h2>Applied Science and Process Control</h2>
        <p>
          Our focus on science, quality, process control, and trust allows us to offer 
          essential attributes in a company linked to the food industry.
        </p>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  .content-section {
    padding: 6rem 2rem;
  }

  .content {
    max-width: 900px;
    margin: 0 auto;
    text-align: center;
  }

  .content h2 {
    font-size: 2.5rem;
    margin-bottom: 2rem;
  }

  .content p {
    font-size: 1.15rem;
    color: #555;
  }
</style>
