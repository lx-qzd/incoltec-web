---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Hero from '../components/Hero.astro';
---

<Layout title="Taste Colors">
  <Header currentPath="/taste-colors" />
  
  <main>
    <Hero 
      title="Taste Colors" 
      subtitle="Products that inspire"
      backgroundImage="/assets/fondo1.jpg" 
    />

    <section class="content-section container">
      <div class="content">
        <h2>Nature as Inspiration</h2>
        <p>
          INCOLTEC solutions combine organic elements with advanced technology to 
          create an unparalleled visual experience. Our colors awaken emotions and enhance 
          the appeal of food.
        </p>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  .content-section {
    padding: 6rem 2rem;
  }

  .content {
    max-width: 900px;
    margin: 0 auto;
    text-align: center;
  }

  .content h2 {
    font-size: 2.5rem;
    margin-bottom: 2rem;
  }

  .content p {
    font-size: 1.15rem;
    color: #555;
  }
</style>
