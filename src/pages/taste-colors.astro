---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Hero from '../components/Hero.astro';
import TasteColorsSection from '../components/TasteColorsSection.astro';
---

<Layout 
  title="Taste Colors - Natural Food Color Solutions | INCOLTEC"
  description="Explore INCOLTEC's natural colors, coloring foods, and botanical pigment extracts designed to deliver exceptional sensory brilliance and clean label appeal."
>
  <Header currentPath="/taste-colors" />
  
  <main>
    <Hero 
      title="Taste Colors" 
      subtitle="Pure botanical pigments and coloring foods that inspire culinary emotion"
      backgroundImage="/assets/fondo1.jpg" 
    />

    <TasteColorsSection isEs={false} />
  </main>

  <Footer />
</Layout>

<style>
  .content-section {
    padding: clamp(3rem, 6vw, 6rem) clamp(1rem, 4vw, 2rem);
  }

  .content {
    max-width: 900px;
    margin: 0 auto;
    text-align: center;
  }

  .content h2 {
    font-size: clamp(1.8rem, 1.3rem + 2.5vw, 2.75rem);
    margin-bottom: 1.5rem;
    line-height: 1.25;
  }

  .content p {
    font-size: clamp(1rem, 0.95rem + 0.3vw, 1.15rem);
    color: #555;
    line-height: 1.7;
  }
</style>
