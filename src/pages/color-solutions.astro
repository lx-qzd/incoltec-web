---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import ColorSolutionsSection from "../components/ColorSolutionsSection.astro";
import SectorLinks from "../components/SectorLinks.astro";
import LeadMagnet from "../components/LeadMagnet.astro";
---

<Layout 
  title="Food colour applications by sector"
  description="Colour solutions for beverages, dairy, bakery, meat and other food applications, with specialist technical support from Incoltec."
  image="/assets/soluciones.jpg"
>
  <Header />

  <ColorSolutionsSection isEs={false} showHero={true} />

  <SectorLinks />

  <LeadMagnet
    title="Request a custom colour solution"
    description="Our application lab develops natural colour systems for your processing conditions, pH and shelf life."
    reason="formulation"
  />

  <Footer />
</Layout>
