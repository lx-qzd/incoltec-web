---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Hero from "../components/Hero.astro";
import CompanyTeaser from "../components/CompanyTeaser.astro";
import ImageBanner from "../components/ImageBanner.astro";
import VibrantLifeSection from "../components/VibrantLifeSection.astro";
import TasteColorsSection from "../components/TasteColorsSection.astro";
import PerfectingFoodSection from "../components/PerfectingFoodSection.astro";
import LeadMagnet from "../components/LeadMagnet.astro";
---

<Layout
  title="Natural food colours for industry | Incoltec"
  description="Manufacturer of natural food colours, LINICOL colouring foods, vitamins and premixes, with B2B technical support for food and beverage producers."
>
  <Header />


  <main id="main">
    <Hero heading="Natural food colours and colouring foods for the food industry" />

    <!-- 1. Product families (anchors: #taste-colors, #colorantes-naturales, #alimentos-colorantes, #vitaminas-premixes) -->
    <TasteColorsSection isEs={false} />

    <ImageBanner 
      image="/assets/fondo1.jpg" 
      tag="Chromatic Technology" 
      title="Vibrant Formulation and Pure Colors" 
      subtitle="Connecting culinary culture with world-class chromatic consistency." 
    />

    <!-- 2. Applications & technical support (anchors: #perfecting-food, #soluciones, #innovacion) -->
    <PerfectingFoodSection isEs={false} />

    <ImageBanner 
      image="/assets/fondo2.jpg" 
      tag="Certified Quality" 
      title="Shaping the Future of Food Appeal" 
      subtitle="Ensuring clean-label confidence and unmatched sensory brilliance." 
    />

    <!-- 3. Quality guarantee (anchors: #vibrant-life, #compromiso, #calidad) -->
    <VibrantLifeSection isEs={false} />

    <!-- 4. Company summary; full content lives on /our-company -->
    <CompanyTeaser />

    <!-- 5. Contact (anchor: #contact) -->
    <LeadMagnet
      title="Contact us"
      description="Request samples, technical data sheets or formulation support for your B2B applications."
    />
  </main>

  <Footer />
</Layout>
