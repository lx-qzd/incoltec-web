---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Hero from "../components/Hero.astro";
import OurCompanySection from "../components/OurCompanySection.astro";
import ImageBanner from "../components/ImageBanner.astro";
import VibrantLifeSection from "../components/VibrantLifeSection.astro";
import TasteColorsSection from "../components/TasteColorsSection.astro";
import PerfectingFoodSection from "../components/PerfectingFoodSection.astro";
import LeadMagnet from "../components/LeadMagnet.astro";
---

<Layout 
  title="Incoltec - Wholesale Food Color Manufacturer & Solutions"
  description="INCOLTEC manufactures premium natural food colorings, coloring foods, vitamins and custom functional solutions for industrial food and beverage processors worldwide."
>
  <Header currentPath="/" />


  <main>
    <!-- Hero Slider (Image 1) -->
    <Hero />

    <!-- Section 1: Vibrant Life (Anchors: #vibrant-life, #compromiso, #calidad) -->
    <VibrantLifeSection isEs={false} />

    <!-- Image Break 1: Separates Vibrant Life and Taste Colors -->
    <ImageBanner 
      image="/assets/fondo1.jpg" 
      tag="Chromatic Technology" 
      title="Vibrant Formulation & Pure Colors" 
      subtitle="Connecting culinary culture with world-class chromatic consistency." 
    />

    <!-- Section 2: Taste Colors & VS Section (Anchors: #taste-colors, #colorantes-naturales, #alimentos-colorantes, #vitaminas-premixes) -->
    <TasteColorsSection isEs={false} />

    <!-- Image Break 2: Separates Taste Colors and Perfecting Food -->
    <ImageBanner 
      image="/assets/fondo2.jpg" 
      tag="Certified Quality" 
      title="Shaping the Future of Food Appeal" 
      subtitle="Ensuring clean-label confidence and unmatched sensory brilliance." 
    />

    <!-- Section 3: Perfecting Food (Anchors: #perfecting-food, #soluciones, #innovacion) -->
    <PerfectingFoodSection isEs={false} />

    <!-- Image Break 3: Separates Perfecting Food and Our Company -->
    <ImageBanner 
      image="/assets/fondo3.jpg" 
      tag="Global Excellence" 
      title="Science, Heritage & Industrial Scale" 
      subtitle="Decades of expertise formulating high-performance colors for the global food industry." 
    />

    <!-- Section 4: Our Company (Anchors: #our-company, #organizacion, #laboratorio) -->
    <OurCompanySection isEs={false} />

    <!-- Section 5: Contact Us & Catalog Download (Anchor: #contact) -->
    <LeadMagnet 
      title="Contact Us"
      description="Request technical specifications, product catalogs, or tailored formulation samples for your B2B applications."
      buttonText="Send Request"
    />
  </main>

  <Footer />
</Layout>
