---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Hero from '../components/Hero.astro';
import Certifications from '../components/Certifications.astro';
import AboutUs from '../components/AboutUs.astro';
import ColorComparison from '../components/ColorComparison.astro';
import LeadMagnet from '../components/LeadMagnet.astro';
---

<Layout title="Wholesale Food Color Manufacturer">
  <Header currentPath="/" />
  
  <main>
    <Hero />

    <Certifications />

    <AboutUs />
    
    <ColorComparison bgImage="/assets/food-colors-application.png" />

    <LeadMagnet />
  </main>

  <Footer />
</Layout>
