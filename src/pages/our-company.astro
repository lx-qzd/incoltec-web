---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Hero from '../components/Hero.astro';
import OurCompanySection from '../components/OurCompanySection.astro';
---

<Layout 
  title="About Incoltec: company, laboratory and quality"
  description="Incoltec develops and manufactures natural food colours in Barcelona: our company, application laboratory, production, quality commitment and team."
>
  <Header />
  
  <main id="main">
    <Hero 
      title="Our Company" 
      subtitle="Deep understanding of markets, food science, and culinary cultures"
      backgroundImage="/assets/fondo1.jpg" 
    />

    <OurCompanySection isEs={false} />
  </main>

  <Footer />
</Layout>
