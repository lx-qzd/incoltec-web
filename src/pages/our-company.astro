---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Hero from '../components/Hero.astro';
import OurCompanySection from '../components/OurCompanySection.astro';
---

<Layout 
  title="Our Company and Values"
  description="Discover INCOLTEC: our mission, corporate solidity, industrial leadership, advanced laboratory capabilities, and continuous innovation in natural food color technology."
>
  <Header currentPath="/our-company" />
  
  <main>
    <Hero 
      title="Our Company" 
      subtitle="Deep understanding of markets, food science, and culinary cultures"
      backgroundImage="/assets/fondo1.jpg" 
    />

    <OurCompanySection isEs={false} />
  </main>

  <Footer />
</Layout>
