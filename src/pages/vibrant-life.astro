---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Hero from '../components/Hero.astro';
---

<Layout 
  title="Vibrant Life - Quality, Safety & Clean Label Trust"
  description="Discover INCOLTEC's unwavering commitment to food safety, rigorous batch-to-batch analytical control, and sustainable raw material sourcing."
>
  <Header currentPath="/vibrant-life" />
  
  <main>
    <Hero 
      title="Vibrant Life" 
      subtitle="Certified food safety, process control, and unwavering consumer trust"
      backgroundImage="/assets/fondo2.jpg" 
    />


    <section class="content-section container">
      <div class="content">
        <h2>Reliability, Technical Support, and Results</h2>
        <p>
          Communicates the foundation that supports the brand's entire value proposition: quality, 
          consistency, and trust. Organic textures and deep tones project security, technical control, 
          and process excellence.
        </p>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  .content-section {
    padding: 6rem 2rem;
  }

  .content {
    max-width: 900px;
    margin: 0 auto;
    text-align: center;
  }

  .content h2 {
    font-size: 2.5rem;
    margin-bottom: 2rem;
  }

  .content p {
    font-size: 1.15rem;
    color: #555;
  }
</style>
