---
import '../styles/global.css';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import CookieConsent from '../components/CookieConsent.astro';
import { getAlternates, getLang, normalizePath, SITE_URL } from '../i18n/routes';
import { company } from '../data/company';

interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: string;
  noindex?: boolean;
  /** Extra JSON-LD objects (BreadcrumbList, Article…) for this page. */
  schema?: Record<string, unknown>[];
}

const {
  title,
  description,
  image,
  type = "website",
  noindex = false,
  schema = [],
} = Astro.props;

const siteUrl = (Astro.site ? Astro.site.toString() : SITE_URL).replace(/\/$/, '');
const pathname = normalizePath(Astro.url.pathname);
const lang = getLang(pathname);
const isEs = lang === 'es';
const alternates = getAlternates(pathname);

/*
 * Indexing is OFF unless the build explicitly opts in with SITE_INDEXABLE=true.
 * Set it only in the production deployment served from incoltec.com so the
 * Vercel preview/staging domains are never indexed.
 */
const indexable =
  (process.env.SITE_INDEXABLE ?? import.meta.env.SITE_INDEXABLE) === 'true' && !noindex;

const canonicalUrl = `${siteUrl}${pathname === '/' ? '/' : pathname}`;
const abs = (p: string) => `${siteUrl}${p === '/' ? '/' : p}`;

const defaultDesc = isEs
  ? "Fabricación y soluciones de color para alimentos y bebidas: colorantes naturales, alimentos colorantes LINICOL, vitaminas y soporte técnico B2B."
  : "Natural food colours, colouring foods, vitamins and premixes with B2B technical support for food and beverage manufacturers.";

const metaDescription = description || defaultDesc;
// Short, unique titles: "<page> | Incoltec". No long shared English suffix.
const pageTitle = /incoltec/i.test(title) ? title : `${title} | Incoltec`;
const ogImage = image
  ? (image.startsWith('http') ? image : `${siteUrl}${image}`)
  : `${siteUrl}/assets/food-colors-application.png`;

const matomoSiteId = import.meta.env.PUBLIC_MATOMO_SITE_ID;
const matomoUrl = import.meta.env.PUBLIC_MATOMO_URL || 'https://stats.incoltec.com/';

const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "@id": `${siteUrl}/#organization`,
  "name": company.brand,
  "legalName": company.legalName,
  "taxID": company.taxId,
  "url": siteUrl,
  "logo": `${siteUrl}/assets/LogoIncoltec.png`,
  "email": company.email,
  "telephone": company.phone,
  "address": {
    "@type": "PostalAddress",
    "streetAddress": company.headquarters.street,
    "postalCode": company.headquarters.postalCode,
    "addressLocality": company.headquarters.city,
    "addressRegion": company.headquarters.region,
    "addressCountry": company.headquarters.countryCode
  },
  "contactPoint": [
    {
      "@type": "ContactPoint",
      "contactType": "sales",
      "email": company.email,
      "telephone": company.phone,
      "availableLanguage": ["English", "Spanish"]
    }
  ],
  "sameAs": [company.social.linkedin, company.social.youtube]
};
---

<!doctype html>
<html lang={lang} class="scroll-smooth">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
		<link rel="icon" href="/favicon.ico" sizes="any" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="apple-touch-icon" href="/assets/LogoIncoltec.png" />
		<meta name="generator" content={Astro.generator} />

		<!-- Primary SEO Meta Tags -->
		<title>{pageTitle}</title>
		<meta name="description" content={metaDescription} />
		<meta name="robots" content={indexable ? "index, follow" : "noindex, nofollow"} />
		<link rel="canonical" href={canonicalUrl} />

		<!-- hreflang: only reciprocal pairs for pages that really exist in both languages -->
		{alternates.translated && (
			<>
				<link rel="alternate" hreflang="en" href={abs(alternates.en)} />
				<link rel="alternate" hreflang="es" href={abs(alternates.es)} />
				<link rel="alternate" hreflang="x-default" href={abs(alternates.en)} />
			</>
		)}

		<!-- Open Graph -->
		<meta property="og:type" content={type} />
		<meta property="og:site_name" content="Incoltec" />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={metaDescription} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:alt" content={pageTitle} />
		<meta property="og:locale" content={isEs ? "es_ES" : "en_GB"} />
		{alternates.translated && <meta property="og:locale:alternate" content={isEs ? "en_GB" : "es_ES"} />}

		<!-- Twitter Cards -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={pageTitle} />
		<meta name="twitter:description" content={metaDescription} />
		<meta name="twitter:image" content={ogImage} />

		<!-- Structured data -->
		<script type="application/ld+json" is:inline set:html={JSON.stringify(organizationSchema)} />
		{schema.map((s) => <script type="application/ld+json" is:inline set:html={JSON.stringify(s)} />)}

		<!-- Typography: Golden Hills (Signature Headings), Playfair Display (Serif), Inter (Body Sans) -->
		<link rel="preload" href="/fonts/GoldenHillsDEMO.woff2" as="font" type="font/woff2" crossorigin />
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;1,400;1,600&family=Great+Vibes&display=swap" rel="stylesheet">


		<!-- Matomo: only rendered when PUBLIC_MATOMO_SITE_ID is set; runs only after analytics consent -->
		{matomoSiteId && (
			<script type="text/plain" data-category="analytics" is:inline define:vars={{ matomoSiteId, matomoUrl }}>
				var _paq = window._paq = window._paq || [];
				_paq.push(['trackPageView']);
				_paq.push(['enableLinkTracking']);
				(function() {
					var u = matomoUrl;
					_paq.push(['setTrackerUrl', u + 'matomo.php']);
					_paq.push(['setSiteId', matomoSiteId]);
					var d = document, g = d.createElement('script'), s = d.getElementsByTagName('script')[0];
					g.async = true; g.src = u + 'matomo.js'; s.parentNode.insertBefore(g, s);
				})();
			</script>
		)}
	</head>
	<body class="bg-white text-[#1E1E1E] antialiased selection:bg-[#E30066]/20 selection:text-[#89385C]">
		<a href="#main" class="skip-link">{isEs ? "Saltar al contenido" : "Skip to content"}</a>
		<slot />
		<WhatsAppButton />
		<CookieConsent />

		<script is:inline>
			// Skip link: focus the page's <main> (some pages render it inside components).
			document.querySelector('.skip-link')?.addEventListener('click', function (e) {
				var m = document.getElementById('main') || document.querySelector('main');
				if (!m) return;
				e.preventDefault();
				m.setAttribute('tabindex', '-1');
				m.focus();
			});
		</script>

		<!-- Scroll-Triggered Micro-Interactions Observer -->
		<script is:inline>
			document.addEventListener('DOMContentLoaded', () => {
				const reveals = document.querySelectorAll('.reveal, .reveal-up, .reveal-left, .reveal-right, .reveal-scale');
				if (!reveals.length) return;

				const revealObserver = new IntersectionObserver((entries, observer) => {
					entries.forEach(entry => {
						if (entry.isIntersecting) {
							entry.target.classList.add('active');
							observer.unobserve(entry.target);
						}
					});
				}, {
					root: null,
					rootMargin: '0px 0px -40px 0px',
					threshold: 0.1
				});

				reveals.forEach(reveal => {
					revealObserver.observe(reveal);
				});
			});
		</script>
	</body>
</html>

